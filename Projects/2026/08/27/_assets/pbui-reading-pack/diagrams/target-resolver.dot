digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.38, fontname="DejaVu Sans"];
  node [shape=box, style="filled", color="#23262b", penwidth=1.5, fontname="DejaVu Sans", fontsize=10, margin="0.15,0.08"];
  edge [color="#596068", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  query [label="RoutingQuery(subject=<order #1042>, role=order.detail, disposition=route)", fillcolor="#fdeec6"];
  collect [label="Collect reachable candidates\nexisting ports + named contexts + spawnable apps + tile slots", fillcolor="#e4f0f7"];
  contract [label="Check port contract\ntype, semantic role, cardinality, mode, authority", fillcolor="#e7f4ec"];
  context [label="Evaluate workspace snapshot\nscope, mode, availability, current occupancy", fillcolor="#edf3e8"];
  rank [label="Precedence\nexact role/type -> nearest scope -> explicit priority", fillcolor="#e9e5f5"];
  result [label="0: no target | 1: commit | >1/tie: explicit chooser", fillcolor="#fbe9e4"];
  query -> collect -> contract -> context -> rank -> result;
  note [shape=note, label="Never use DOM order, tile creation time,\nregistration order, or last event as a hidden tie-breaker.", fillcolor="#f1f1ee"];
  note -> rank [style=dotted, arrowhead=none];
}
