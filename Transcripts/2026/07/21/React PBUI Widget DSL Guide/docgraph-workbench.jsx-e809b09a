  sage: "#a9bda2", blue: "#9cb4c2", rose: "#cfa08f",
  mustard: "#d3b56a", lavender: "#b3abc4", mint: "#b7c9b3",
  red: "#b0563f", sel: "#f4e6b8",
};
const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

