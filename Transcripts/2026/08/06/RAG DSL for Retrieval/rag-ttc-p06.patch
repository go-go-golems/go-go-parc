+func fixtureRequests(count int) []Request {
+	requests := make([]Request, count)
+	for index := range requests {
+		payload, _ := json.Marshal(map[string]int{"value": index})
+		requests[index] = Request{SemanticKey: "item-" + string(rune('0'+index)), Payload: payload}
+	}
+	return requests
+}
