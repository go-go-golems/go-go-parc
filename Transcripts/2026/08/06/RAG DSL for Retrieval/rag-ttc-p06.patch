+func TestCaptureReplaysAttemptSequenceWithoutLiveWork(t *testing.T) {
+	requests := fixtureRequests(1)
+	state := &State{}
+	policy := fixturePolicy()
+	policy.Effect = Captured
+	policy.Capture = CaptureRecord
+	policy.Attempts = 2
+	var calls atomic.Int32
+	first, err := Run(context.Background(), requests, policy, state, func(_ context.Context, invocation Invocation, request Request) Outcome {
+		calls.Add(1)
+		if invocation.AttemptNumber == 1 {
+			return Outcome{ErrorClass: Transient, ErrorMessage: "timeout"}
+		}
+		return Outcome{Value: "ok:" + request.SemanticKey}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != 2 || first.WorkCalls != 2 {
+		t.Fatalf("calls=%d result=%+v", calls.Load(), first)
+	}
+	policy.Capture = CaptureReplay
+	second, err := Run(context.Background(), requests, policy, state, func(context.Context, Invocation, Request) Outcome {
+		t.Fatal("replay called live work")
+		return Outcome{}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(first.Outputs, second.Outputs) || second.WorkCalls != 0 || second.Replayed != 2 {
+		t.Fatalf("first=%+v second=%+v", first, second)
+	}
+}
