index 0000000000000000000000000000000000000000..92c5a272f3350df20e33029c70b35a19360c7122
--- /dev/null
+++ b/pkg/flow/semantics.go
@@ -0,0 +1,274 @@
+package flow
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+)
+
+// Trace identity aliases keep the flow API readable while sharing the
+// portable operation-trace/v1 vocabulary with effectlog.
+type RunID = effectlog.RunID
+type StepID = effectlog.StepID
+type StageID = effectlog.StageID
+type OperationID = effectlog.OperationID
+type AttemptID = effectlog.AttemptID
+type BatchID = effectlog.BatchID
+
+// TraceOptions makes trace identity and timestamps injectable. Production
+// callers normally leave it zero; deterministic tests and replay tools set a
+// fixed RunID and Clock.
+type TraceOptions struct {
+	RunID RunID
+	Clock func() time.Time
+}
+
+type stageScope struct {
+	run      RunID
+	step     StepID
+	stage    StageID
+	ordinal  uint64
+	name     string
+	contract Contract
+}
+
+// EffectKind states the side-effect precondition under which execution policy
+// transformations are intended to be transparent.
+type EffectKind string
+
+const (
+	// EffectUnknown preserves the legacy contract: the runtime records no
+	// claim about retry or replay safety.
+	EffectUnknown EffectKind = "unknown"
+	// EffectPure has no externally observable effect and is deterministic for
+	// the semantic request.
+	EffectPure EffectKind = "pure"
+	// EffectReadOnly may observe an external system but does not mutate it.
+	EffectReadOnly EffectKind = "read-only"
+	// EffectIdempotent may mutate external state, but repeating the same
+	// operation/idempotency key has no additional effect.
+	EffectIdempotent EffectKind = "idempotent"
+	// EffectCaptured is effectful but is mediated by an effectlog recorder.
+	// Capture makes the observation replayable; it does not make an ambiguous
+	// external mutation exactly-once.
+	EffectCaptured EffectKind = "captured"
+	// EffectNonIdempotent may have a different external effect when repeated.
+	EffectNonIdempotent EffectKind = "non-idempotent"
+)
+
+// Locality states how much input a step must observe.
+type Locality string
+
+const (
+	// ItemLocal means each output depends only on its corresponding input and
+	// declared external observations.
+	ItemLocal Locality = "item-local"
+	// SnapshotGlobal means the operation must observe the complete input
+	// collection. A temporal Barrier is insufficient; use Snapshot.
+	SnapshotGlobal Locality = "snapshot-global"
+)
+
+// Contract is the executable semantic precondition of a step. Zero values are
+// accepted for existing callers and make no transparency claim.
+type Contract struct {
+	Effect   EffectKind `json:"effect"`
+	Locality Locality   `json:"locality"`
+	// Description names the domain-specific promise checked by the adapter or
+	// conformance suite. It is documentation, not identity.
+	Description string `json:"description,omitempty"`
+}
+
+func (contract Contract) withDefaults() Contract {
+	if contract.Effect == "" {
+		contract.Effect = EffectUnknown
+	}
+	if contract.Locality == "" {
+		contract.Locality = ItemLocal
+	}
+	return contract
+}
+
+func (contract Contract) validate(policy Policy, captured, snapshot bool) error {
+	contract = contract.withDefaults()
+	switch contract.Effect {
+	case EffectUnknown, EffectPure, EffectReadOnly, EffectIdempotent, EffectCaptured, EffectNonIdempotent:
+	default:
+		return fmt.Errorf("unknown effect contract %q", contract.Effect)
+	}
+	switch contract.Locality {
+	case ItemLocal:
+	case SnapshotGlobal:
+		if !snapshot {
+			return fmt.Errorf("snapshot-global contract requires flow.Snapshot; Barrier only delays execution and does not expose the collection")
+		}
+	default:
+		return fmt.Errorf("unknown locality contract %q", contract.Locality)
+	}
+	attempts := policy.Retry.Attempts
+	if attempts < 1 {
+		attempts = 1
+	}
+	if contract.Effect == EffectCaptured && !captured {
+		return fmt.Errorf("captured effect contract requires both Step.Capture and Options.Effects")
+	}
+	if contract.Effect == EffectNonIdempotent && attempts > 1 {
+		return fmt.Errorf("non-idempotent effect cannot be retried: capture records attempts but cannot undo or deduplicate an ambiguous external mutation; use one attempt or an idempotency contract")
+	}
+	return nil
+}
+
+// CaptureSpec defines the semantic request boundary for an effect-shaped step.
+// Trace IDs and execution policy are deliberately excluded from SemanticKey.
+type CaptureSpec[I, O any] struct {
+	SemanticKey    func(I) (string, error)
+	EncodeRequest  func(I) (json.RawMessage, error)
+	EncodeResponse func(O) (json.RawMessage, error)
+	DecodeResponse func(json.RawMessage) (O, error)
+}
+
+// JSONCapture builds a capture contract using JSON request/response codecs.
+func JSONCapture[I, O any](semanticKey func(I) (string, error)) *CaptureSpec[I, O] {
+	return &CaptureSpec[I, O]{SemanticKey: semanticKey}
+}
+
+func (spec *CaptureSpec[I, O]) key(item I, fallback string) (string, error) {
+	if spec != nil && spec.SemanticKey != nil {
+		key, err := spec.SemanticKey(item)
+		if err != nil {
+			return "", err
+		}
+		if strings.TrimSpace(key) == "" {
+			return "", fmt.Errorf("capture semantic key is empty")
+		}
+		return key, nil
+	}
+	if fallback == "" {
+		return "", fmt.Errorf("capture semantic key function is required for uncached work")
+	}
+	return fallback, nil
+}
+
+func (spec *CaptureSpec[I, O]) encodeRequest(item I) (json.RawMessage, error) {
+	if spec != nil && spec.EncodeRequest != nil {
+		return spec.EncodeRequest(item)
+	}
+	data, err := json.Marshal(item)
+	if err != nil {
+		return nil, fmt.Errorf("encode captured request: %w", err)
+	}
+	return data, nil
+}
+
+func (spec *CaptureSpec[I, O]) encodeResponse(value O) (json.RawMessage, error) {
+	if spec != nil && spec.EncodeResponse != nil {
+		return spec.EncodeResponse(value)
+	}
+	data, err := json.Marshal(value)
+	if err != nil {
+		return nil, fmt.Errorf("encode captured response: %w", err)
+	}
+	return data, nil
+}
+
+func (spec *CaptureSpec[I, O]) decodeResponse(data json.RawMessage) (O, error) {
+	if spec != nil && spec.DecodeResponse != nil {
+		return spec.DecodeResponse(data)
+	}
+	var value O
+	if err := json.Unmarshal(data, &value); err != nil {
+		return value, fmt.Errorf("decode captured response: %w", err)
+	}
+	return value, nil
+}
+
+// Invocation is the trace identity visible to one concrete Do call. External
+// adapters may use Operation as an idempotency key and attach all fields to
+// provider/client telemetry.
+type Invocation struct {
+	Run           RunID       `json:"run_id"`
+	Step          StepID      `json:"step_id"`
+	Stage         StageID     `json:"stage_id"`
+	Operation     OperationID `json:"operation_id"`
+	Attempt       AttemptID   `json:"attempt_id"`
+	Batch         BatchID     `json:"batch_id,omitempty"`
+	AttemptNumber int         `json:"attempt_number"`
+	InputIndex    int         `json:"input_index"`
+	SemanticKey   string      `json:"semantic_key,omitempty"`
+}
+
+type invocationContextKey struct{}
+
+// InvocationFromContext returns the current operation/attempt identity.
+func InvocationFromContext(ctx context.Context) (Invocation, bool) {
+	value, ok := ctx.Value(invocationContextKey{}).(Invocation)
+	return value, ok
+}
+
+func withInvocation(ctx context.Context, invocation Invocation) context.Context {
+	return context.WithValue(ctx, invocationContextKey{}, invocation)
+}
+
+func stepDefinitionID[I, O any](step Step[I, O]) StepID {
+	if step.ID != "" {
+		return step.ID
+	}
+	if step.Identity.Kind != "" && step.Identity.Version != "" {
+		return effectlog.DefinitionID(step.Identity.Kind, step.Identity.Version)
+	}
+	// Legacy fallback only. New production steps should set ID explicitly.
+	return effectlog.DefinitionID("flow.legacy."+normalizeIDPart(step.Name), "v1")
+}
+
+func normalizeIDPart(value string) string {
+	value = strings.TrimSpace(strings.ToLower(value))
+	if value == "" {
+		return "unnamed"
+	}
+	var builder strings.Builder
+	for _, r := range value {
+		switch {
+		case r >= 'a' && r <= 'z', r >= '0' && r <= '9':
+			builder.WriteRune(r)
+		default:
+			builder.WriteByte('-')
+		}
+	}
+	return strings.Trim(builder.String(), "-")
+}
+
+func operationLocalKey(index int, semanticKey string) string {
+	if semanticKey != "" {
+		return "semantic:" + semanticKey
+	}
+	return "index:" + strconv.Itoa(index)
+}
+
+func hashStrings(domain string, values ...string) string {
+	hash := sha256.New()
+	_, _ = hash.Write([]byte(domain))
+	for _, value := range values {
+		_, _ = hash.Write([]byte{0})
+		_, _ = hash.Write([]byte(value))
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func parseErrorClass(value string) (ErrorClass, error) {
+	switch value {
+	case Transient.String():
+		return Transient, nil
+	case DataError.String():
+		return DataError, nil
+	case Fatal.String():
+		return Fatal, nil
+	default:
+		return Fatal, fmt.Errorf("unknown captured error class %q", value)
+	}
+}
