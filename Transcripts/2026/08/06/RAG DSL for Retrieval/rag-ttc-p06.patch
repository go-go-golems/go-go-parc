+package adapter
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/execution"
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+	"github.com/the-tree-center/rag-ttc/pkg/flowtest"
+)
+
+func TestExhaustiveSixItemCompletionSchedules(t *testing.T) {
+	items := []int{0, 1, 2, 3, 4, 5}
+	expected := []int{0, 10, 20, 30, 40, 50}
+	checked := 0
+	forEachPermutation(len(items), func(schedule []int) {
+		gates := make([]chan struct{}, len(items))
+		for index := range gates {
+			gates[index] = make(chan struct{})
+		}
+		started := make(chan int, len(items))
+		completed := make(chan int, len(items))
+		step := flow.Step[int, int]{
+			Name: "scheduled", ID: effectlog.DefinitionID("p06.fixture.scheduled", "v1"),
+			Contract: flow.Contract{Effect: flow.EffectPure},
+			Policy:   flow.Policy{Workers: len(items)},
+			Do: func(_ context.Context, value int) (int, error) {
+				started <- value
+				<-gates[value]
+				completed <- value
+				return value * 10, nil
+			},
+		}
+		type response struct {
+			results []flow.Result[int]
+			report  flow.Report
+			err     error
+		}
+		done := make(chan response, 1)
+		go func() {
+			results, report, err := flow.Run(context.Background(), step, items, flow.Options{})
+			done <- response{results: results, report: report, err: err}
+		}()
+		for range items {
+			<-started
+		}
+		for _, index := range schedule {
+			close(gates[index])
+			if actual := <-completed; actual != index {
+				t.Fatalf("release order=%v completed=%d, want %d", schedule, actual, index)
+			}
+		}
+		answer := <-done
+		if answer.err != nil {
+			t.Fatalf("schedule=%v: %v", schedule, answer.err)
+		}
+		if actual := SemanticInts(answer.results); !reflect.DeepEqual(actual, expected) {
+			t.Fatalf("schedule=%v outputs=%v", schedule, actual)
+		}
+		if err := answer.report.Validate(); err != nil {
+			t.Fatalf("schedule=%v report=%v", schedule, err)
+		}
+		checked++
+	})
+	if checked != 720 {
+		t.Fatalf("checked=%d", checked)
+	}
+}
+
+func TestPolicyMetamorphismViaFlowtest(t *testing.T) {
+	executor := func(workers int) flowtest.Executor[int, int] {
+		return func(ctx context.Context, items []int) ([]flow.Result[int], flow.Report, error) {
+			return flow.Run(ctx, PureIntStep("double", "v1", workers, func(value int) int { return value * 2 }), items, flow.Options{})
+		}
+	}
+	assessment, err := flowtest.Compare(context.Background(), flowtest.Case[int, int]{
+		Name: "sequential-versus-parallel", Inputs: []int{1, 2, 3, 4}, Baseline: executor(1),
+		Variants: []flowtest.Variant[int, int]{{Name: "four-workers", Run: executor(4)}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !assessment.Transparent {
+		t.Fatalf("assessment=%+v", assessment)
+	}
+}
+
+func TestBulkBatchSizesAndOrderCounterexample(t *testing.T) {
+	items := []int{1, 2, 3, 4, 5, 6, 7, 8}
+	base := PureIntStep("square", "v1", 4, func(value int) int { return value * value })
+	reference, _, err := flow.Run(context.Background(), base, items, flow.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for batchSize := 1; batchSize <= len(items); batchSize++ {
+		bulk := flow.Bulk(base, func(_ context.Context, batch []int) ([]int, error) {
+			outputs := make([]int, len(batch))
+			for index, value := range batch {
+				outputs[index] = value * value
+			}
+			return outputs, nil
+		}, batchSize)
+		actual, _, err := flow.Run(context.Background(), bulk, items, flow.Options{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(SemanticInts(reference), SemanticInts(actual)) {
+			t.Fatalf("batch size %d changed output", batchSize)
+		}
+	}
+	reversed := flow.Bulk(base, func(_ context.Context, batch []int) ([]int, error) {
+		outputs := make([]int, len(batch))
+		for index, value := range batch {
+			outputs[len(batch)-1-index] = value * value
+		}
+		return outputs, nil
+	}, len(items))
+	actual, _, err := flow.Run(context.Background(), reversed, items, flow.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reflect.DeepEqual(SemanticInts(reference), SemanticInts(actual)) {
+		t.Fatal("undocumented bulk order precondition was not falsified")
+	}
+}
+
+func TestCacheHitMissAndCorruptionContracts(t *testing.T) {
+	var calls atomic.Int32
+	step := flow.Step[int, int]{
+		Name: "cached", ID: effectlog.DefinitionID("p06.fixture.cached", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectPure},
+		Identity: flow.Identity[int]{Kind: "p06.cached", Version: "v1", Key: func(value int) ([]byte, error) {
+			return []byte(fmt.Sprint(value)), nil
+		}},
+		Do: func(_ context.Context, value int) (int, error) { calls.Add(1); return value * 3, nil },
+	}
+	store := flow.NewMemoryStore()
+	first, firstReport, err := flow.Run(context.Background(), step, []int{1, 2, 2}, flow.Options{Store: store})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, secondReport, err := flow.Run(context.Background(), step, []int{1, 2, 2}, flow.Options{Store: store})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(SemanticInts(first), SemanticInts(second)) || calls.Load() != 2 {
+		t.Fatalf("calls=%d first=%v second=%v", calls.Load(), SemanticInts(first), SemanticInts(second))
+	}
+	if firstReport.Step("cached").WorkCalls != 2 || secondReport.Step("cached").Hits != 3 {
+		t.Fatalf("first=%+v second=%+v", firstReport.Step("cached"), secondReport.Step("cached"))
+	}
+	_, report, err := flow.Run(context.Background(), step, []int{1}, flow.Options{Store: corruptStore{}})
+	if err == nil || report.StopReason != flow.StopFailed {
+		t.Fatalf("corrupt cache err=%v report=%+v", err, report)
+	}
+}
+
+func TestOperationIDIsStableAcrossIdempotentRetryAttempts(t *testing.T) {
+	var first flow.Invocation
+	var second flow.Invocation
+	step := flow.Step[string, string]{
+		Name: "idempotent", ID: effectlog.DefinitionID("p06.fixture.idempotent", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectIdempotent},
+		Policy: flow.Policy{Retry: flow.RetrySpec{
+			Attempts: 2, Backoff: flow.Backoff{Base: time.Nanosecond, Cap: time.Nanosecond},
+		}},
+		Do: func(ctx context.Context, value string) (string, error) {
+			invocation, ok := flow.InvocationFromContext(ctx)
+			if !ok {
+				return "", errors.New("missing invocation")
+			}
+			if invocation.AttemptNumber == 1 {
+				first = invocation
+				return "", &flow.StatusError{Status: 503, Err: errors.New("retry")}
+			}
+			second = invocation
+			return value, nil
+		},
+	}
+	_, report, err := flow.Run(context.Background(), step, []string{"x"}, flow.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Operation != second.Operation || first.Attempt == second.Attempt {
+		t.Fatalf("first=%+v second=%+v", first, second)
+	}
+	if len(report.Operations) != 1 || len(report.Operations[0].Attempts) != 2 {
+		t.Fatalf("report=%+v", report)
+	}
+}
+
+func TestSnapshotGlobalView(t *testing.T) {
+	results, report, err := flow.Run(context.Background(), TopOneSnapshot("top-one"), []int{3, 10, 7}, flow.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual := []bool{results[0].Value, results[1].Value, results[2].Value}
+	if !reflect.DeepEqual(actual, []bool{false, true, false}) {
+		t.Fatalf("actual=%v", actual)
+	}
+	if report.Stages[0].Contract.Locality != flow.SnapshotGlobal {
+		t.Fatalf("report=%+v", report)
+	}
+}
+
+type corruptStore struct{}
+
+func (corruptStore) Load(context.Context, execution.Key, any) (bool, error) {
+	return false, errors.New("corrupt cache entry")
+}
+func (corruptStore) Store(context.Context, execution.Key, any) error { return nil }
+
+func forEachPermutation(length int, visit func([]int)) {
+	values := make([]int, length)
+	for index := range values {
+		values[index] = index
+	}
+	var generate func(int)
+	generate = func(position int) {
+		if position == length {
+			visit(append([]int(nil), values...))
+			return
+		}
+		for index := position; index < length; index++ {
+			values[position], values[index] = values[index], values[position]
+			generate(position + 1)
+			values[position], values[index] = values[index], values[position]
+		}
+	}
+	generate(0)
+}
