+func TestReversedBatchIsAConcreteCounterexample(t *testing.T) {
+	requests := fixtureRequests(4)
+	actual, err := RunBatches(requests, []int{4}, func(batch []Request) ([]Outcome, error) {
+		outputs := make([]Outcome, len(batch))
+		for index, request := range batch {
+			outputs[len(batch)-1-index] = Outcome{Value: "ok:" + request.SemanticKey}
