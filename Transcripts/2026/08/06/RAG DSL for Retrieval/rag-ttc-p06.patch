@@ -0,0 +1,124 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+	"github.com/the-tree-center/rag-ttc/research/p06-flow-executor-semantics-effects/adapter"
+)
+
+type memoryLedger struct {
+	mu     sync.Mutex
+	events []flow.Event
+}
+
+func (ledger *memoryLedger) Event(_ context.Context, event flow.Event) error {
+	ledger.mu.Lock()
+	defer ledger.mu.Unlock()
+	ledger.events = append(ledger.events, event)
+	return nil
+}
+
+func (ledger *memoryLedger) Events() []flow.Event {
+	ledger.mu.Lock()
+	defer ledger.mu.Unlock()
+	events := append([]flow.Event(nil), ledger.events...)
+	sort.Slice(events, func(i, j int) bool { return events[i].Sequence < events[j].Sequence })
+	return events
+}
+
+type deterministicClock struct {
+	mu   sync.Mutex
+	next time.Time
+}
+
+func newClock() *deterministicClock {
+	return &deterministicClock{next: time.Date(2026, 8, 5, 12, 0, 0, 0, time.UTC)}
+}
+
+func (clock *deterministicClock) Now() time.Time {
+	clock.mu.Lock()
+	defer clock.mu.Unlock()
+	value := clock.next
+	clock.next = clock.next.Add(time.Millisecond)
+	return value
+}
+
+func main() {
+	reportPath := flag.String("report", "", "flow-report/v2 output path")
+	tracePath := flag.String("trace", "", "operation-trace/v1 JSONL output path")
+	flag.Parse()
+	if *reportPath == "" || *tracePath == "" {
+		fmt.Fprintln(os.Stderr, "both -report and -trace are required")
+		os.Exit(2)
+	}
+
+	clock := newClock()
+	ledger := &memoryLedger{}
+	first := adapter.PureIntStep("transform", "increment-v1", 3, func(value int) int { return value + 1 })
+	second := adapter.PureIntStep("transform", "double-v1", 2, func(value int) int { return value * 2 })
+	results, report, err := flow.Run(context.Background(), flow.Pipe2(first, second), []int{1, 2, 3}, flow.Options{
+		Ledger: ledger,
+		Trace:  flow.TraceOptions{RunID: "sample-p06-run", Clock: clock.Now},
+	})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	if err := report.Validate(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	for index, result := range results {
+		expected := (index + 2) * 2
+		if result.Value != expected {
+			fmt.Fprintf(os.Stderr, "result %d = %d, expected %d\n", index, result.Value, expected)
+			os.Exit(1)
+		}
+	}
+	if err := writeJSON(*reportPath, report); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	if err := writeJSONL(*tracePath, ledger.Events()); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func writeJSON(path string, value any) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, append(data, '\n'), 0o644)
+}
+
+func writeJSONL(path string, values []flow.Event) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	file, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	encoder := json.NewEncoder(file)
+	for _, value := range values {
+		if err := encoder.Encode(value); err != nil {
+			return err
+		}
+	}
+	return file.Close()
+}
diff --git a/research/p06-flow-executor-semantics-effects/cmd/p06-demo/main.go b/research/p06-flow-executor-semantics-effects/cmd/p06-demo/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2e219aaef4c2d44c254500d47da2b9a2f24361c
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/cmd/p06-demo/main.go
@@ -0,0 +1,302 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"os"
+	"reflect"
+	"runtime"
+	"sync/atomic"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+	"github.com/the-tree-center/rag-ttc/research/p06-flow-executor-semantics-effects/adapter"
+	"github.com/the-tree-center/rag-ttc/research/p06-flow-executor-semantics-effects/standalone"
+)
+
+type check struct {
+	Name    string `json:"name"`
+	Status  string `json:"status"`
+	Cases   int    `json:"cases,omitempty"`
+	Details string `json:"details,omitempty"`
+}
+
+type summary struct {
+	SchemaVersion string         `json:"schema_version"`
+	Project       string         `json:"project"`
+	GeneratedAt   time.Time      `json:"generated_at"`
+	GoVersion     string         `json:"go_version"`
+	Checks        []check        `json:"checks"`
+	Metrics       map[string]int `json:"metrics"`
+}
+
+func main() {
+	outPath := flag.String("out", "", "optional JSON output path")
+	capturePath := flag.String("capture", "", "optional captured-effect snapshot path")
+	flag.Parse()
+
+	result := summary{
+		SchemaVersion: "p06-experiment-summary/v1", Project: "P06",
+		GeneratedAt: time.Now().UTC(), GoVersion: runtime.Version(), Metrics: map[string]int{},
+	}
+	must := func(name string, cases int, err error, details string) {
+		status := "pass"
+		if err != nil {
+			status, details = "fail", err.Error()
+		}
+		result.Checks = append(result.Checks, check{Name: name, Status: status, Cases: cases, Details: details})
+		if err != nil {
+			writeAndExit(result, *outPath, 1)
+		}
+	}
+
+	permutations, err := standaloneSchedules()
+	must("standalone-schedule-independence", permutations, err, "all six-item completion schedules restore input order")
+	result.Metrics["standalone_schedule_permutations"] = permutations
+
+	partitions, err := standalonePartitions()
+	must("standalone-batch-partitions", partitions, err, "all contiguous partitions preserve aligned batch meaning")
+	result.Metrics["standalone_batch_partitions"] = partitions
+
+	batchSizes, err := flowBatchSizes()
+	must("flow-batch-size-equivalence", batchSizes, err, "batch sizes 1..N agree with item execution")
+	result.Metrics["flow_batch_sizes"] = batchSizes
+
+	stages, legacyItems, err := repeatedNames()
+	must("flow-report-nonconflation", stages, err, fmt.Sprintf("v2 stages=%d; legacy display-name aggregate items=%d", stages, legacyItems))
+	result.Metrics["repeated_name_stages"] = stages
+
+	captures, liveCalls, replayed, recorder, err := capturedRetry()
+	must("captured-retry-offline-replay", captures, err, fmt.Sprintf("live calls=%d; replayed attempts=%d", liveCalls, replayed))
+	result.Metrics["captured_attempts"] = captures
+	result.Metrics["live_effect_calls"] = liveCalls
+	result.Metrics["offline_replayed_attempts"] = replayed
+
+	selected, err := globalSnapshot()
+	must("snapshot-global-barrier", len(selected), err, fmt.Sprintf("membership=%v", selected))
+
+	unsafeRejected := unsafeRetryRejected()
+	if !unsafeRejected {
+		must("non-idempotent-retry-refusal", 1, errors.New("unsafe retry accepted"), "")
+	}
+	must("non-idempotent-retry-refusal", 1, nil, "capture is replay, not exactly-once mutation control")
+
+	if *capturePath != "" {
+		if err := effectlog.WriteSnapshot(*capturePath, recorder.Snapshot()); err != nil {
+			must("write-capture", 1, err, "")
+		}
+	}
+	writeAndExit(result, *outPath, 0)
+}
+
+func standaloneSchedules() (int, error) {
+	requests := make([]standalone.Request, 6)
+	for index := range requests {
+		payload, _ := json.Marshal(map[string]int{"value": index})
+		requests[index] = standalone.Request{SemanticKey: fmt.Sprintf("item-%d", index), Payload: payload}
+	}
+	policy := standalone.Policy{DisplayName: "pure", StepID: "step_pure_v1", Effect: standalone.Pure, Attempts: 1, Budget: -1}
+	op := func(_ context.Context, _ standalone.Invocation, request standalone.Request) standalone.Outcome {
+		return standalone.Outcome{Value: "ok:" + request.SemanticKey}
+	}
+	baseline, err := standalone.Run(context.Background(), requests, policy, &standalone.State{}, op)
+	if err != nil {
+		return 0, err
+	}
+	count := 0
+	forEachPermutation(len(requests), func(schedule []int) {
+		if err != nil {
+			return
+		}
+		variant := policy
+		variant.Schedule = schedule
+		var actual standalone.Result
+		actual, err = standalone.Run(context.Background(), requests, variant, &standalone.State{}, op)
+		if err == nil && !reflect.DeepEqual(actual.Outputs, baseline.Outputs) {
+			err = fmt.Errorf("schedule %v changed outputs", schedule)
+		}
+		count++
+	})
+	return count, err
+}
+
+func standalonePartitions() (int, error) {
+	requests := make([]standalone.Request, 8)
+	expected := make([]standalone.Outcome, len(requests))
+	for index := range requests {
+		requests[index] = standalone.Request{SemanticKey: fmt.Sprintf("item-%d", index), Payload: json.RawMessage(`{}`)}
+		expected[index] = standalone.Outcome{Value: "ok:" + requests[index].SemanticKey}
+	}
+	partitions := standalone.PartitionMasks(len(requests))
+	for _, partition := range partitions {
+		actual, err := standalone.RunBatches(requests, partition, func(batch []standalone.Request) ([]standalone.Outcome, error) {
+			outputs := make([]standalone.Outcome, len(batch))
+			for index, request := range batch {
+				outputs[index] = standalone.Outcome{Value: "ok:" + request.SemanticKey}
+			}
+			return outputs, nil
+		})
+		if err != nil {
+			return len(partitions), err
+		}
+		if !reflect.DeepEqual(actual, expected) {
+			return len(partitions), fmt.Errorf("partition %v changed outputs", partition)
+		}
+	}
+	return len(partitions), nil
+}
+
+func flowBatchSizes() (int, error) {
+	items := []int{1, 2, 3, 4, 5, 6, 7, 8}
+	base := adapter.PureIntStep("square", "v1", 4, func(value int) int { return value * value })
+	reference, _, err := flow.Run(context.Background(), base, items, flow.Options{})
+	if err != nil {
+		return 0, err
+	}
+	for size := 1; size <= len(items); size++ {
+		bulk := flow.Bulk(base, func(_ context.Context, batch []int) ([]int, error) {
+			outputs := make([]int, len(batch))
+			for index, value := range batch {
+				outputs[index] = value * value
+			}
+			return outputs, nil
+		}, size)
+		actual, _, err := flow.Run(context.Background(), bulk, items, flow.Options{})
+		if err != nil {
+			return size, err
+		}
+		if !reflect.DeepEqual(adapter.SemanticInts(reference), adapter.SemanticInts(actual)) {
+			return size, fmt.Errorf("batch size %d changed outputs", size)
+		}
+	}
+	return len(items), nil
+}
+
+func repeatedNames() (int, int, error) {
+	first := adapter.PureIntStep("transform", "increment-v1", 1, func(value int) int { return value + 1 })
+	second := adapter.PureIntStep("transform", "double-v1", 1, func(value int) int { return value * 2 })
+	_, report, err := flow.Run(context.Background(), flow.Pipe2(first, second), []int{1, 2}, flow.Options{
+		Trace: flow.TraceOptions{RunID: "demo-report", Clock: fixedClock()},
+	})
+	if err != nil {
+		return 0, 0, err
+	}
+	if err := report.Validate(); err != nil {
+		return 0, 0, err
+	}
+	if len(report.Stages) != 2 || report.Stages[0].StageID == report.Stages[1].StageID {
+		return len(report.Stages), report.Step("transform").Items, fmt.Errorf("stage identity conflated")
+	}
+	return len(report.Stages), report.Step("transform").Items, nil
+}
+
+func capturedRetry() (captures, calls, replayed int, recorder *effectlog.Memory, err error) {
+	recorder, err = effectlog.New(effectlog.Options{Mode: effectlog.ModeCapture, Clock: fixedClock()})
+	if err != nil {
+		return
+	}
+	var live atomic.Int32
+	step := flow.Step[string, string]{
+		Name: "generate", ID: effectlog.DefinitionID("p06.demo.generate", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectCaptured},
+		Policy:   flow.Policy{Retry: flow.RetrySpec{Attempts: 2, Backoff: flow.Backoff{Base: time.Nanosecond, Cap: time.Nanosecond}}},
+		Capture:  flow.JSONCapture[string, string](func(value string) (string, error) { return "prompt:" + value, nil }),
+		Do: func(_ context.Context, value string) (string, error) {
+			if live.Add(1) == 1 {
+				return "", &flow.StatusError{Status: 503, Err: errors.New("transient")}
+			}
+			return "answer:" + value, nil
+		},
+	}
+	first, _, err := flow.Run(context.Background(), step, []string{"oak"}, flow.Options{Effects: recorder})
+	if err != nil {
+		return 0, int(live.Load()), 0, recorder, err
+	}
+	replayRecorder, err := effectlog.NewFromSnapshot(recorder.Snapshot(), effectlog.Options{Mode: effectlog.ModeReplay, Clock: fixedClock()})
+	if err != nil {
+		return 0, int(live.Load()), 0, recorder, err
+	}
+	step.Do = func(context.Context, string) (string, error) { return "", errors.New("live replay violation") }
+	second, report, err := flow.Run(context.Background(), step, []string{"oak"}, flow.Options{Effects: replayRecorder})
+	if err != nil {
+		return 0, int(live.Load()), 0, recorder, err
+	}
+	if first[0].Value != second[0].Value {
+		err = fmt.Errorf("capture and replay outputs differ")
+	}
+	return len(recorder.Snapshot().Captures), int(live.Load()), report.Step("generate").Replayed, recorder, err
+}
+
+func globalSnapshot() ([]bool, error) {
+	results, _, err := flow.Run(context.Background(), adapter.TopOneSnapshot("top-one"), []int{3, 10, 7}, flow.Options{})
+	if err != nil {
+		return nil, err
+	}
+	selected := []bool{results[0].Value, results[1].Value, results[2].Value}
+	if !reflect.DeepEqual(selected, []bool{false, true, false}) {
+		return selected, fmt.Errorf("wrong top-one view")
+	}
+	return selected, nil
+}
+
+func unsafeRetryRejected() bool {
+	recorder, _ := effectlog.New(effectlog.Options{Mode: effectlog.ModeCapture})
+	step := flow.Step[string, string]{
+		Name: "charge", ID: effectlog.DefinitionID("p06.demo.charge", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectNonIdempotent},
+		Policy:   flow.Policy{Retry: flow.RetrySpec{Attempts: 2}},
+		Capture:  flow.JSONCapture[string, string](func(value string) (string, error) { return value, nil }),
+		Do:       func(_ context.Context, value string) (string, error) { return value, nil },
+	}
+	_, _, err := flow.Run(context.Background(), step, []string{"invoice"}, flow.Options{Effects: recorder})
+	return err != nil
+}
+
+func writeAndExit(value summary, path string, status int) {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	data = append(data, '\n')
+	if path != "" {
+		if err := os.WriteFile(path, data, 0o644); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+	}
+	_, _ = os.Stdout.Write(data)
+	if status != 0 {
+		os.Exit(status)
+	}
+}
+
+func fixedClock() func() time.Time {
+	var tick atomic.Int64
+	origin := time.Date(2026, 8, 5, 12, 0, 0, 0, time.UTC)
+	return func() time.Time { return origin.Add(time.Duration(tick.Add(1)) * time.Microsecond) }
+}
+
+func forEachPermutation(length int, visit func([]int)) {
+	values := make([]int, length)
+	for index := range values {
+		values[index] = index
+	}
+	var generate func(int)
+	generate = func(position int) {
+		if position == length {
+			visit(append([]int(nil), values...))
+			return
+		}
+		for index := position; index < length; index++ {
+			values[position], values[index] = values[index], values[position]
+			generate(position + 1)
+			values[position], values[index] = values[index], values[position]
+		}
+	}
+	generate(0)
+}
