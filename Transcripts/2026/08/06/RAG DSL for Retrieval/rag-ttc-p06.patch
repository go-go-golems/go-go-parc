@@ -0,0 +1,66 @@
+// Package adapter contains the narrow P06 adapter to rag-ttc's flow runtime.
+// It adds no scheduler or graph language; ordinary typed Step composition
+// remains the public programming model.
+package adapter
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+)
+
+// PureIntStep constructs a stable, explicitly pure item-local fixture.
+func PureIntStep(name, version string, workers int, fn func(int) int) flow.Step[int, int] {
+	return flow.Step[int, int]{
+		Name: name,
+		ID:   effectlog.DefinitionID("p06.fixture."+name, version),
+		Contract: flow.Contract{
+			Effect: flow.EffectPure, Locality: flow.ItemLocal,
+			Description: "deterministic P06 conformance fixture",
+		},
+		Policy: flow.Policy{Workers: workers},
+		Do: func(_ context.Context, value int) (int, error) {
+			if fn == nil {
+				return 0, fmt.Errorf("fixture function is nil")
+			}
+			return fn(value), nil
+		},
+	}
+}
+
+// TopOneSnapshot returns an aligned global selection view.
+func TopOneSnapshot(name string) flow.Step[int, bool] {
+	return flow.Snapshot(flow.SnapshotSpec[int, bool]{
+		Name: name,
+		ID:   effectlog.DefinitionID("p06.fixture.global-top-one", "v1"),
+		Contract: flow.Contract{
+			Effect:      flow.EffectPure,
+			Description: "global top-one membership view over complete input snapshot",
+		},
+		DoAll: func(_ context.Context, values []int) ([]bool, error) {
+			selected := make([]bool, len(values))
+			if len(values) == 0 {
+				return selected, nil
+			}
+			best := 0
+			for index := 1; index < len(values); index++ {
+				if values[index] > values[best] {
+					best = index
+				}
+			}
+			selected[best] = true
+			return selected, nil
+		},
+	})
+}
+
+// SemanticInts projects successful aligned integer results.
+func SemanticInts(results []flow.Result[int]) []int {
+	values := make([]int, len(results))
+	for index, result := range results {
+		values[index] = result.Value
+	}
+	return values
+}
