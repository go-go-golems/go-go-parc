diff --git a/pkg/flow/trace.go b/pkg/flow/trace.go
new file mode 100644
index 0000000000000000000000000000000000000000..b371d0fea64383c45188b63cd84df215733f4fcf
--- /dev/null
+++ b/pkg/flow/trace.go
@@ -0,0 +1,174 @@
+package flow
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/execution"
+)
+
+// operationTracker is an internal, concurrency-safe ledger for the logical
+// operations of one stage. It does not schedule or execute them.
+type operationTracker struct {
+	scope stageScope
+	env   *runEnv
+
+	mutex      sync.Mutex
+	operations map[OperationID]*OperationReport
+}
+
+func newOperationTracker(scope stageScope, env *runEnv) *operationTracker {
+	return &operationTracker{scope: scope, env: env, operations: map[OperationID]*OperationReport{}}
+}
+
+func (tracker *operationTracker) ensure(index int, semanticKey string) (OperationID, bool) {
+	return tracker.ensureWithKey([]int{index}, semanticKey, operationLocalKey(index, semanticKey))
+}
+
+func (tracker *operationTracker) ensureBatch(indexes []int, semanticKey, localKey string, batchID BatchID) (OperationID, bool) {
+	operation, created := tracker.ensureWithKey(indexes, semanticKey, localKey)
+	tracker.mutex.Lock()
+	tracker.operations[operation].BatchID = batchID
+	tracker.mutex.Unlock()
+	return operation, created
+}
+
+func (tracker *operationTracker) ensureWithKey(indexes []int, semanticKey, localKey string) (OperationID, bool) {
+	operation := effectlog.DeriveOperationID(tracker.scope.stage, localKey)
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	if existing, ok := tracker.operations[operation]; ok {
+		existing.Indexes = appendUniqueInts(existing.Indexes, indexes...)
+		return operation, false
+	}
+	tracker.operations[operation] = &OperationReport{
+		OperationID: operation,
+		StageID:     tracker.scope.stage,
+		StepID:      tracker.scope.step,
+		Name:        tracker.scope.name,
+		Indexes:     append([]int(nil), indexes...),
+		SemanticKey: semanticKey,
+		Status:      OperationPending,
+	}
+	return operation, true
+}
+
+func (tracker *operationTracker) setBatch(operation OperationID, batch BatchID) {
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	if report := tracker.operations[operation]; report != nil {
+		report.BatchID = batch
+	}
+}
+
+func (tracker *operationTracker) beginAttempt(operation OperationID, number, index int, semanticKey string, batch BatchID) Invocation {
+	attempt := effectlog.DeriveAttemptID(operation, number)
+	started := tracker.env.now()
+	tracker.mutex.Lock()
+	report := tracker.operations[operation]
+	if report != nil {
+		report.BatchID = batch
+		report.Attempts = append(report.Attempts, AttemptReport{
+			AttemptID: attempt, Number: number, StartedAt: started,
+		})
+	}
+	tracker.mutex.Unlock()
+	return Invocation{
+		Run: tracker.scope.run, Step: tracker.scope.step, Stage: tracker.scope.stage,
+		Operation: operation, Attempt: attempt, Batch: batch,
+		AttemptNumber: number, InputIndex: index, SemanticKey: semanticKey,
+	}
+}
+
+func (tracker *operationTracker) finishAttempt(operation OperationID, number int, class ErrorClass, err error, replayed bool, captureKey string) {
+	finished := tracker.env.now()
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	report := tracker.operations[operation]
+	if report == nil {
+		return
+	}
+	for index := range report.Attempts {
+		if report.Attempts[index].Number != number {
+			continue
+		}
+		report.Attempts[index].FinishedAt = finished
+		report.Attempts[index].Replayed = replayed
+		report.Attempts[index].CaptureKey = captureKey
+		if err != nil {
+			report.Attempts[index].ErrorClass = class.String()
+			report.Attempts[index].Error = err.Error()
+		}
+		return
+	}
+}
+
+func (tracker *operationTracker) status(operation OperationID, status OperationStatus, cache execution.CacheState, class ErrorClass, err error) {
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	report := tracker.operations[operation]
+	if report == nil {
+		return
+	}
+	report.Status = status
+	if cache != "" {
+		report.Cache = cache
+	}
+	if err != nil {
+		report.ErrorClass = class.String()
+		report.Error = err.Error()
+	}
+}
+
+func (tracker *operationTracker) setCache(operation OperationID, cache execution.CacheState) {
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	if report := tracker.operations[operation]; report != nil {
+		report.Cache = cache
+	}
+}
+
+func (tracker *operationTracker) snapshot() []OperationReport {
+	tracker.mutex.Lock()
+	defer tracker.mutex.Unlock()
+	operations := make([]OperationReport, 0, len(tracker.operations))
+	for _, operation := range tracker.operations {
+		operations = append(operations, cloneOperation(*operation))
+	}
+	sort.Slice(operations, func(i, j int) bool { return operations[i].OperationID < operations[j].OperationID })
+	return operations
+}
+
+func stageReport(scope stageScope, counts StepReport, operations []OperationReport) Report {
+	return Report{
+		SchemaVersion: ReportSchemaV2,
+		RunID:         scope.run,
+		Steps:         map[string]StepReport{scope.name: counts},
+		Stages: []StageReport{{
+			StageID: scope.stage, StepID: scope.step, Name: scope.name,
+			Ordinal: scope.ordinal, Contract: scope.contract, Counts: counts,
+		}},
+		Operations: operations,
+	}
+}
+
+func emitScopedEvent(ctx context.Context, options Options, scope stageScope, event Event) error {
+	if options.Ledger == nil {
+		return nil
+	}
+	sequence, at := options.env.stamp()
+	event.Sequence = sequence
+	event.At = at
+	event.SchemaVersion = OperationTraceSchemaV1
+	event.RunID = scope.run
+	event.StepID = scope.step
+	event.StageID = scope.stage
+	event.Step = scope.name
+	if err := options.Ledger.Event(ctx, event); err != nil {
+		return fmt.Errorf("step %q: ledger event: %w", scope.name, err)
+	}
+	return nil
+}
diff --git a/pkg/flowtest/compare.go b/pkg/flowtest/compare.go
new file mode 100644
index 0000000000000000000000000000000000000000..ccea16d9a383233799bddfc1ca8ccc2d1d57758a
--- /dev/null
+++ b/pkg/flowtest/compare.go
@@ -0,0 +1,145 @@
+package flowtest
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+)
+
+// Executor is one operational implementation of the same declared operation.
+type Executor[I, O any] func(context.Context, []I) ([]flow.Result[O], flow.Report, error)
+
+// Variant names an operational policy transformation to compare with a
+// baseline: parallelism, cache, retry, bulk, capture/replay, or another adapter.
+type Variant[I, O any] struct {
+	Name string
+	Run  Executor[I, O]
+}
+
+// SemanticState excludes cache state and attempt count. Those values explain
+// execution history but do not change the admitted item result.
+type SemanticState string
+
+const (
+	Succeeded   SemanticState = "succeeded"
+	Quarantined SemanticState = "quarantined"
+	Skipped     SemanticState = "skipped"
+)
+
+// SemanticItem is the default projection used for output transparency.
+type SemanticItem[O any] struct {
+	Value        O             `json:"value"`
+	State        SemanticState `json:"state"`
+	ErrorClass   string        `json:"error_class,omitempty"`
+	ErrorMessage string        `json:"error_message,omitempty"`
+}
+
+// Observation retains semantic output, operational report, and terminal error.
+type Observation[O any] struct {
+	Semantic []SemanticItem[O] `json:"semantic"`
+	Report   flow.Report       `json:"report"`
+	Error    string            `json:"error,omitempty"`
+}
+
+// Difference is one falsifying operational variant.
+type Difference struct {
+	Variant string `json:"variant"`
+	Reason  string `json:"reason"`
+}
+
+// Assessment is the machine-readable result of one metamorphic comparison.
+type Assessment[O any] struct {
+	Name        string                    `json:"name"`
+	Transparent bool                      `json:"transparent"`
+	Baseline    Observation[O]            `json:"baseline"`
+	Variants    map[string]Observation[O] `json:"variants"`
+	Differences []Difference              `json:"differences,omitempty"`
+}
+
+// Case configures one metamorphic experiment. Equal may override the default
+// deep equality on SemanticItem projections. EqualError may refine terminal
+// error equivalence; by default both runs must either succeed or fail.
+type Case[I, O any] struct {
+	Name       string
+	Inputs     []I
+	Baseline   Executor[I, O]
+	Variants   []Variant[I, O]
+	Equal      func([]SemanticItem[O], []SemanticItem[O]) bool
+	EqualError func(error, error) bool
+}
+
+// Project removes operational metadata from aligned flow results.
+func Project[O any](results []flow.Result[O]) []SemanticItem[O] {
+	projected := make([]SemanticItem[O], len(results))
+	for index, result := range results {
+		item := SemanticItem[O]{Value: result.Value, State: Succeeded}
+		switch {
+		case result.Quarantined != nil:
+			item.State = Quarantined
+			item.ErrorClass = result.Quarantined.Class.String()
+			item.ErrorMessage = result.Quarantined.Message
+		case result.Skipped:
+			item.State = Skipped
+		}
+		projected[index] = item
+	}
+	return projected
+}
+
+// Compare runs a baseline and every variant and reports semantic mismatches.
+func Compare[I, O any](ctx context.Context, test Case[I, O]) (Assessment[O], error) {
+	if test.Name == "" {
+		return Assessment[O]{}, fmt.Errorf("flow transparency case needs a name")
+	}
+	if test.Baseline == nil {
+		return Assessment[O]{}, fmt.Errorf("flow transparency case %q needs a baseline", test.Name)
+	}
+	equal := test.Equal
+	if equal == nil {
+		equal = func(left, right []SemanticItem[O]) bool { return reflect.DeepEqual(left, right) }
+	}
+	equalError := test.EqualError
+	if equalError == nil {
+		equalError = func(left, right error) bool { return (left == nil) == (right == nil) }
+	}
+
+	baselineResults, baselineReport, baselineErr := test.Baseline(ctx, cloneInputs(test.Inputs))
+	assessment := Assessment[O]{
+		Name: test.Name, Transparent: true,
+		Baseline: observe(baselineResults, baselineReport, baselineErr),
+		Variants: map[string]Observation[O]{},
+	}
+	for _, variant := range test.Variants {
+		if variant.Name == "" || variant.Run == nil {
+			return Assessment[O]{}, fmt.Errorf("flow transparency case %q has incomplete variant", test.Name)
+		}
+		results, report, err := variant.Run(ctx, cloneInputs(test.Inputs))
+		observation := observe(results, report, err)
+		assessment.Variants[variant.Name] = observation
+		if !equal(assessment.Baseline.Semantic, observation.Semantic) {
+			assessment.Transparent = false
+			assessment.Differences = append(assessment.Differences, Difference{
+				Variant: variant.Name, Reason: "semantic outputs differ",
+			})
+		}
+		if !equalError(baselineErr, err) {
+			assessment.Transparent = false
+			assessment.Differences = append(assessment.Differences, Difference{
+				Variant: variant.Name, Reason: "terminal error contracts differ",
+			})
+		}
+	}
+	return assessment, nil
+}
+
+func observe[O any](results []flow.Result[O], report flow.Report, err error) Observation[O] {
+	observation := Observation[O]{Semantic: Project(results), Report: report}
+	if err != nil {
+		observation.Error = err.Error()
+	}
+	return observation
+}
+
+func cloneInputs[I any](values []I) []I { return append([]I(nil), values...) }
