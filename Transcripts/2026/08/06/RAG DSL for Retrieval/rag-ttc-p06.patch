@@ -0,0 +1,533 @@
+package effectlog
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"sync"
+	"time"
+)
+
+const (
+	CaptureSchema  = "captured-effect/v1"
+	EventSchema    = "captured-effect-event/v1"
+	SnapshotSchema = "captured-effect-snapshot/v1"
+)
+
+// Mode controls whether Execute calls live work or replayable capture data.
+type Mode string
+
+const (
+	// ModeLive always calls the supplied function and records trace events only.
+	ModeLive Mode = "live"
+	// ModeCapture records the first outcome for each semantic request attempt;
+	// repeats replay that outcome and therefore do not duplicate the effect.
+	ModeCapture Mode = "capture"
+	// ModeReplay refuses live work and requires a previously captured outcome.
+	ModeReplay Mode = "replay"
+)
+
+// ErrReplayMiss identifies a semantic request absent from a replay snapshot.
+var ErrReplayMiss = errors.New("captured effect replay miss")
+
+// ErrPayloadMismatch means a caller reused a semantic key for different
+// request bytes. The capture is not replayed because doing so would turn an
+// incomplete semantic key into a silent cache-corruption bug.
+var ErrPayloadMismatch = errors.New("captured effect payload mismatch")
+
+// Request describes one attempted effect. Step and SemanticKey define replay
+// identity together with AttemptNumber. The remaining IDs describe this run.
+type Request struct {
+	Run           RunID           `json:"run_id,omitempty"`
+	Step          StepID          `json:"step_id"`
+	Stage         StageID         `json:"stage_id,omitempty"`
+	Operation     OperationID     `json:"operation_id,omitempty"`
+	Attempt       AttemptID       `json:"attempt_id,omitempty"`
+	Batch         BatchID         `json:"batch_id,omitempty"`
+	AttemptNumber int             `json:"attempt_number"`
+	SemanticKey   string          `json:"semantic_key"`
+	Payload       json.RawMessage `json:"payload,omitempty"`
+}
+
+// Outcome is the complete admitted observation of one attempted effect.
+// Provider/application failure is data here; Execute errors are reserved for
+// recorder, encoding, cancellation, and replay-integrity failures.
+type Outcome struct {
+	Response     json.RawMessage `json:"response,omitempty"`
+	ErrorClass   string          `json:"error_class,omitempty"`
+	ErrorMessage string          `json:"error_message,omitempty"`
+}
+
+// RecordedResult reports an outcome and whether live work was avoided.
+type RecordedResult struct {
+	CaptureKey string  `json:"capture_key"`
+	Outcome    Outcome `json:"outcome"`
+	Replayed   bool    `json:"replayed"`
+}
+
+// EventKind names a recorder lifecycle event.
+type EventKind string
+
+const (
+	EventStarted  EventKind = "started"
+	EventRecorded EventKind = "recorded"
+	EventReplayed EventKind = "replayed"
+	EventFinished EventKind = "finished"
+)
+
+// Event is one append-only trace entry.
+type Event struct {
+	SchemaVersion string      `json:"schema_version"`
+	Sequence      uint64      `json:"sequence"`
+	Run           RunID       `json:"run_id,omitempty"`
+	Step          StepID      `json:"step_id"`
+	Stage         StageID     `json:"stage_id,omitempty"`
+	Operation     OperationID `json:"operation_id,omitempty"`
+	Attempt       AttemptID   `json:"attempt_id,omitempty"`
+	Batch         BatchID     `json:"batch_id,omitempty"`
+	AttemptNumber int         `json:"attempt_number"`
+	Kind          EventKind   `json:"kind"`
+	At            time.Time   `json:"at"`
+	DurationNanos int64       `json:"duration_nanos,omitempty"`
+	CaptureKey    string      `json:"capture_key"`
+	SemanticKey   string      `json:"semantic_key"`
+	ErrorClass    string      `json:"error_class,omitempty"`
+	ErrorMessage  string      `json:"error_message,omitempty"`
+}
+
+// Capture is one integrity-protected replay record.
+type Capture struct {
+	Schema        string          `json:"schema"`
+	CaptureKey    string          `json:"capture_key"`
+	Step          StepID          `json:"step_id"`
+	AttemptNumber int             `json:"attempt_number"`
+	SemanticKey   string          `json:"semantic_key"`
+	Payload       json.RawMessage `json:"payload,omitempty"`
+	Outcome       Outcome         `json:"outcome"`
+	RecordedAt    time.Time       `json:"recorded_at"`
+	DurationNanos int64           `json:"duration_nanos"`
+	ContentDigest string          `json:"content_digest"`
+}
+
+// Snapshot is the portable offline replay artifact. Events are optional for
+// replay but retained for operational analysis.
+type Snapshot struct {
+	Schema   string    `json:"schema"`
+	Captures []Capture `json:"captures"`
+	Events   []Event   `json:"events,omitempty"`
+}
+
+// Recorder executes or replays effect-shaped calls.
+type Recorder interface {
+	Execute(context.Context, Request, func(context.Context) Outcome) (RecordedResult, error)
+	Replay(Request) (RecordedResult, bool)
+	Events() []Event
+	Snapshot() Snapshot
+}
+
+// Options configures an in-memory recorder.
+type Options struct {
+	Mode  Mode
+	Clock func() time.Time
+}
+
+// Memory is a concurrency-safe capture/replay recorder.
+type Memory struct {
+	mode  Mode
+	clock func() time.Time
+
+	mu       sync.Mutex
+	sequence uint64
+	captures map[string]Capture
+	events   []Event
+	inflight map[string]*call
+}
+
+var _ Recorder = (*Memory)(nil)
+
+type call struct {
+	done   chan struct{}
+	result RecordedResult
+	err    error
+}
+
+// New creates an empty recorder.
+func New(options Options) (*Memory, error) {
+	mode := options.Mode
+	if mode == "" {
+		mode = ModeCapture
+	}
+	switch mode {
+	case ModeLive, ModeCapture, ModeReplay:
+	default:
+		return nil, fmt.Errorf("unknown effectlog mode %q", mode)
+	}
+	clock := options.Clock
+	if clock == nil {
+		clock = time.Now
+	}
+	return &Memory{
+		mode: mode, clock: clock,
+		captures: map[string]Capture{}, inflight: map[string]*call{},
+	}, nil
+}
+
+// NewFromSnapshot validates and loads a portable replay artifact.
+func NewFromSnapshot(snapshot Snapshot, options Options) (*Memory, error) {
+	memory, err := New(options)
+	if err != nil {
+		return nil, err
+	}
+	if snapshot.Schema != SnapshotSchema {
+		return nil, fmt.Errorf("effectlog snapshot schema %q, expected %q", snapshot.Schema, SnapshotSchema)
+	}
+	for _, capture := range snapshot.Captures {
+		if err := capture.validate(); err != nil {
+			return nil, err
+		}
+		if existing, ok := memory.captures[capture.CaptureKey]; ok && !capturesEqual(existing, capture) {
+			return nil, fmt.Errorf("effectlog snapshot repeats conflicting capture %q", capture.CaptureKey)
+		}
+		memory.captures[capture.CaptureKey] = cloneCapture(capture)
+	}
+	seenSequences := make(map[uint64]bool, len(snapshot.Events))
+	memory.events = make([]Event, 0, len(snapshot.Events))
+	for _, event := range snapshot.Events {
+		if err := event.validate(); err != nil {
+			return nil, err
+		}
+		if seenSequences[event.Sequence] {
+			return nil, fmt.Errorf("effectlog snapshot repeats event sequence %d", event.Sequence)
+		}
+		seenSequences[event.Sequence] = true
+		memory.events = append(memory.events, event)
+		if event.Sequence > memory.sequence {
+			memory.sequence = event.Sequence
+		}
+	}
+	sort.Slice(memory.events, func(i, j int) bool { return memory.events[i].Sequence < memory.events[j].Sequence })
+	return memory, nil
+}
+
+// Execute invokes live work or replays a captured attempt according to Mode.
+func (memory *Memory) Execute(ctx context.Context, request Request, fn func(context.Context) Outcome) (RecordedResult, error) {
+	if memory == nil {
+		return RecordedResult{}, fmt.Errorf("effectlog recorder is nil")
+	}
+	if err := validateRequest(request); err != nil {
+		return RecordedResult{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return RecordedResult{}, err
+	}
+	key := captureKey(request)
+
+	memory.mu.Lock()
+	if memory.mode != ModeLive {
+		if capture, ok := memory.captures[key]; ok {
+			if !bytes.Equal(capture.Payload, request.Payload) {
+				memory.mu.Unlock()
+				return RecordedResult{}, fmt.Errorf("%w: %s", ErrPayloadMismatch, key)
+			}
+			result := RecordedResult{CaptureKey: key, Outcome: cloneOutcome(capture.Outcome), Replayed: true}
+			memory.appendEventLocked(request, key, EventReplayed, 0, result.Outcome)
+			memory.mu.Unlock()
+			return result, nil
+		}
+		if memory.mode == ModeReplay {
+			memory.mu.Unlock()
+			return RecordedResult{}, fmt.Errorf("%w: %s", ErrReplayMiss, key)
+		}
+		if existing, ok := memory.inflight[key]; ok {
+			memory.mu.Unlock()
+			select {
+			case <-ctx.Done():
+				return RecordedResult{}, ctx.Err()
+			case <-existing.done:
+				result := existing.result
+				result.Replayed = true
+				return result, existing.err
+			}
+		}
+		current := &call{done: make(chan struct{})}
+		memory.inflight[key] = current
+		memory.appendEventLocked(request, key, EventStarted, 0, Outcome{})
+		memory.mu.Unlock()
+
+		result, err := memory.callAndCapture(ctx, request, key, fn)
+		memory.mu.Lock()
+		current.result, current.err = result, err
+		delete(memory.inflight, key)
+		close(current.done)
+		memory.mu.Unlock()
+		return result, err
+	}
+	memory.appendEventLocked(request, key, EventStarted, 0, Outcome{})
+	memory.mu.Unlock()
+	return memory.callLive(ctx, request, key, fn)
+}
+
+func (memory *Memory) callAndCapture(ctx context.Context, request Request, key string, fn func(context.Context) Outcome) (RecordedResult, error) {
+	if fn == nil {
+		return RecordedResult{}, fmt.Errorf("effectlog live function is required for capture miss")
+	}
+	started := memory.clock().UTC()
+	outcome := cloneOutcome(fn(ctx))
+	finished := memory.clock().UTC()
+	if err := validateOutcome(outcome); err != nil {
+		return RecordedResult{}, err
+	}
+	capture := Capture{
+		Schema: CaptureSchema, CaptureKey: key, Step: request.Step,
+		AttemptNumber: request.AttemptNumber, SemanticKey: request.SemanticKey,
+		Payload: cloneRaw(request.Payload), Outcome: outcome, RecordedAt: started,
+		DurationNanos: max(finished.Sub(started).Nanoseconds(), 0),
+	}
+	capture.ContentDigest = capture.digest()
+	memory.mu.Lock()
+	memory.captures[key] = cloneCapture(capture)
+	memory.appendEventLocked(request, key, EventRecorded, capture.DurationNanos, outcome)
+	memory.appendEventLocked(request, key, EventFinished, capture.DurationNanos, outcome)
+	memory.mu.Unlock()
+	return RecordedResult{CaptureKey: key, Outcome: cloneOutcome(outcome)}, nil
+}
+
+func (memory *Memory) callLive(ctx context.Context, request Request, key string, fn func(context.Context) Outcome) (RecordedResult, error) {
+	if fn == nil {
+		return RecordedResult{}, fmt.Errorf("effectlog live function is required")
+	}
+	started := memory.clock().UTC()
+	outcome := cloneOutcome(fn(ctx))
+	finished := memory.clock().UTC()
+	if err := validateOutcome(outcome); err != nil {
+		return RecordedResult{}, err
+	}
+	duration := max(finished.Sub(started).Nanoseconds(), 0)
+	memory.mu.Lock()
+	memory.appendEventLocked(request, key, EventFinished, duration, outcome)
+	memory.mu.Unlock()
+	return RecordedResult{CaptureKey: key, Outcome: outcome}, nil
+}
+
+// Replay resolves one request without executing live work.
+func (memory *Memory) Replay(request Request) (RecordedResult, bool) {
+	if memory == nil || validateRequest(request) != nil {
+		return RecordedResult{}, false
+	}
+	key := captureKey(request)
+	memory.mu.Lock()
+	defer memory.mu.Unlock()
+	capture, ok := memory.captures[key]
+	if !ok || !bytes.Equal(capture.Payload, request.Payload) {
+		return RecordedResult{}, false
+	}
+	return RecordedResult{CaptureKey: key, Outcome: cloneOutcome(capture.Outcome), Replayed: true}, true
+}
+
+// Events returns an immutable copy ordered by append sequence.
+func (memory *Memory) Events() []Event {
+	if memory == nil {
+		return nil
+	}
+	memory.mu.Lock()
+	defer memory.mu.Unlock()
+	return append([]Event(nil), memory.events...)
+}
+
+// Snapshot returns captures in deterministic key order and events in sequence order.
+func (memory *Memory) Snapshot() Snapshot {
+	if memory == nil {
+		return Snapshot{Schema: SnapshotSchema}
+	}
+	memory.mu.Lock()
+	defer memory.mu.Unlock()
+	keys := make([]string, 0, len(memory.captures))
+	for key := range memory.captures {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	captures := make([]Capture, 0, len(keys))
+	for _, key := range keys {
+		captures = append(captures, cloneCapture(memory.captures[key]))
+	}
+	events := append([]Event(nil), memory.events...)
+	sort.SliceStable(events, func(i, j int) bool { return events[i].Sequence < events[j].Sequence })
+	return Snapshot{Schema: SnapshotSchema, Captures: captures, Events: events}
+}
+
+// WriteSnapshot atomically writes a replay artifact.
+func WriteSnapshot(path string, snapshot Snapshot) error {
+	data, err := json.MarshalIndent(snapshot, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshal effectlog snapshot: %w", err)
+	}
+	temporary := path + ".tmp"
+	if err := os.WriteFile(temporary, append(data, '\n'), 0o600); err != nil {
+		return fmt.Errorf("write effectlog snapshot: %w", err)
+	}
+	if err := os.Rename(temporary, path); err != nil {
+		_ = os.Remove(temporary)
+		return fmt.Errorf("publish effectlog snapshot: %w", err)
+	}
+	return nil
+}
+
+// ReadSnapshot reads and validates a replay artifact.
+func ReadSnapshot(path string) (Snapshot, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return Snapshot{}, fmt.Errorf("read effectlog snapshot: %w", err)
+	}
+	var snapshot Snapshot
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&snapshot); err != nil {
+		return Snapshot{}, fmt.Errorf("decode effectlog snapshot: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err == nil {
+		return Snapshot{}, fmt.Errorf("decode effectlog snapshot: trailing JSON value")
+	} else if !errors.Is(err, io.EOF) {
+		return Snapshot{}, fmt.Errorf("decode effectlog snapshot trailer: %w", err)
+	}
+	memory, err := NewFromSnapshot(snapshot, Options{Mode: ModeReplay})
+	if err != nil {
+		return Snapshot{}, err
+	}
+	return memory.Snapshot(), nil
+}
+
+func validateRequest(request Request) error {
+	if request.Step == "" {
+		return fmt.Errorf("effectlog step ID is required")
+	}
+	if request.AttemptNumber < 1 {
+		return fmt.Errorf("effectlog attempt number must be positive")
+	}
+	if request.SemanticKey == "" {
+		return fmt.Errorf("effectlog semantic key is required")
+	}
+	if len(request.Payload) > 0 && !json.Valid(request.Payload) {
+		return fmt.Errorf("effectlog request payload is not valid JSON")
+	}
+	return nil
+}
+
+func validateOutcome(outcome Outcome) error {
+	if len(outcome.Response) > 0 && !json.Valid(outcome.Response) {
+		return fmt.Errorf("effectlog response is not valid JSON")
+	}
+	if outcome.ErrorMessage == "" && outcome.ErrorClass != "" {
+		return fmt.Errorf("effectlog error class requires an error message")
+	}
+	if outcome.ErrorMessage != "" && len(outcome.Response) > 0 {
+		return fmt.Errorf("effectlog outcome cannot contain both response and error")
+	}
+	return nil
+}
+
+func captureKey(request Request) string {
+	payload := struct {
+		Schema        string `json:"schema"`
+		Step          StepID `json:"step_id"`
+		SemanticKey   string `json:"semantic_key"`
+		AttemptNumber int    `json:"attempt_number"`
+	}{CaptureSchema, request.Step, request.SemanticKey, request.AttemptNumber}
+	data, _ := json.Marshal(payload)
+	sum := sha256.Sum256(data)
+	return "capture_" + hex.EncodeToString(sum[:])
+}
+
+func (capture Capture) digest() string {
+	copy := capture
+	copy.ContentDigest = ""
+	data, _ := json.Marshal(copy)
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func (event Event) validate() error {
+	if event.SchemaVersion != EventSchema {
+		return fmt.Errorf("effectlog event schema %q, expected %q", event.SchemaVersion, EventSchema)
+	}
+	if event.Sequence < 1 || event.Step == "" || event.AttemptNumber < 1 || event.SemanticKey == "" || event.CaptureKey == "" {
+		return fmt.Errorf("effectlog event sequence %d has incomplete identity", event.Sequence)
+	}
+	switch event.Kind {
+	case EventStarted, EventRecorded, EventReplayed, EventFinished:
+	default:
+		return fmt.Errorf("effectlog event sequence %d has unknown kind %q", event.Sequence, event.Kind)
+	}
+	if event.At.IsZero() {
+		return fmt.Errorf("effectlog event sequence %d has no timestamp", event.Sequence)
+	}
+	if event.DurationNanos < 0 {
+		return fmt.Errorf("effectlog event sequence %d has negative duration", event.Sequence)
+	}
+	request := Request{Step: event.Step, SemanticKey: event.SemanticKey, AttemptNumber: event.AttemptNumber}
+	if event.CaptureKey != captureKey(request) {
+		return fmt.Errorf("effectlog event sequence %d has mismatched capture key", event.Sequence)
+	}
+	if err := validateOutcome(Outcome{ErrorClass: event.ErrorClass, ErrorMessage: event.ErrorMessage}); err != nil {
+		return fmt.Errorf("effectlog event sequence %d: %w", event.Sequence, err)
+	}
+	return nil
+}
+
+func (capture Capture) validate() error {
+	if capture.Schema != CaptureSchema {
+		return fmt.Errorf("effectlog capture schema %q, expected %q", capture.Schema, CaptureSchema)
+	}
+	if capture.CaptureKey == "" || capture.Step == "" || capture.SemanticKey == "" || capture.AttemptNumber < 1 {
+		return fmt.Errorf("effectlog capture %q has incomplete identity", capture.CaptureKey)
+	}
+	request := Request{Step: capture.Step, SemanticKey: capture.SemanticKey, AttemptNumber: capture.AttemptNumber, Payload: capture.Payload}
+	if capture.CaptureKey != captureKey(request) {
+		return fmt.Errorf("effectlog capture %q has mismatched key", capture.CaptureKey)
+	}
+	if err := validateOutcome(capture.Outcome); err != nil {
+		return fmt.Errorf("effectlog capture %q: %w", capture.CaptureKey, err)
+	}
+	if capture.ContentDigest != capture.digest() {
+		return fmt.Errorf("effectlog capture %q failed content digest validation", capture.CaptureKey)
+	}
+	return nil
+}
+
+func (memory *Memory) appendEventLocked(request Request, key string, kind EventKind, duration int64, outcome Outcome) {
+	memory.sequence++
+	memory.events = append(memory.events, Event{
+		SchemaVersion: EventSchema,
+		Sequence:      memory.sequence, Run: request.Run, Step: request.Step, Stage: request.Stage,
+		Operation: request.Operation, Attempt: request.Attempt, Batch: request.Batch,
+		AttemptNumber: request.AttemptNumber, Kind: kind, At: memory.clock().UTC(),
+		DurationNanos: duration, CaptureKey: key, SemanticKey: request.SemanticKey,
+		ErrorClass: outcome.ErrorClass, ErrorMessage: outcome.ErrorMessage,
+	})
+}
+
+func cloneRaw(value json.RawMessage) json.RawMessage { return append(json.RawMessage(nil), value...) }
+func cloneOutcome(value Outcome) Outcome {
+	value.Response = cloneRaw(value.Response)
+	return value
+}
+func cloneCapture(value Capture) Capture {
+	value.Payload = cloneRaw(value.Payload)
+	value.Outcome = cloneOutcome(value.Outcome)
+	return value
+}
+func capturesEqual(left, right Capture) bool {
+	left.RecordedAt, right.RecordedAt = time.Time{}, time.Time{}
+	left.DurationNanos, right.DurationNanos = 0, 0
+	left.ContentDigest, right.ContentDigest = "", ""
+	leftData, _ := json.Marshal(left)
+	rightData, _ := json.Marshal(right)
+	return string(leftData) == string(rightData)
+}
