+func TestAllContiguousBatchPartitionsAreEquivalentWhenAligned(t *testing.T) {
+	requests := fixtureRequests(8)
+	expected := make([]Outcome, len(requests))
+	for index, request := range requests {
+		expected[index] = Outcome{Value: "ok:" + request.SemanticKey}
+	}
+	partitions := PartitionMasks(len(requests))
+	if len(partitions) != 128 {
+		t.Fatalf("partitions=%d", len(partitions))
+	}
+	for _, partition := range partitions {
+		actual, err := RunBatches(requests, partition, func(batch []Request) ([]Outcome, error) {
+			outputs := make([]Outcome, len(batch))
+			for index, request := range batch {
+				outputs[index] = Outcome{Value: "ok:" + request.SemanticKey}
