+		identityStep := Step[[]I, []O]{Name: spec.Name, Identity: spec.Identity}
+		value, err := identityStep.Key(items)
+		if err != nil {
+			return fail(err)
+		}
+		digestValue, err := keyDigest(value)
+		if err != nil {
+			return fail(err)
+		}
