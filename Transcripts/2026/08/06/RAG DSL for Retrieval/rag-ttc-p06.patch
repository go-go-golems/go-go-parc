+
+func BenchmarkFlowBulkAligned100(b *testing.B) {
+	base := PureIntStep("bench-bulk", "v1", 4, func(value int) int { return value * 2 })
+	step := flow.Bulk(base, func(_ context.Context, values []int) ([]int, error) {
+		outputs := make([]int, len(values))
+		for index, value := range values {
+			outputs[index] = value * 2
+		}
+		return outputs, nil
+	}, 20)
+	for range b.N {
+		if _, _, err := flow.Run(context.Background(), step, benchmarkItems, flow.Options{}); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkFlowCacheHit100(b *testing.B) {
+	step := flow.Step[int, int]{
+		Name: "bench-cache", ID: effectlog.DefinitionID("p06.bench.cache", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectPure},
+		Identity: flow.Identity[int]{Kind: "p06.bench.cache", Version: "v1", Key: func(value int) ([]byte, error) {
+			return []byte(fmt.Sprint(value)), nil
+		}},
+		Policy: flow.Policy{Workers: 8},
+		Do:     func(_ context.Context, value int) (int, error) { return value * 2, nil },
+	}
+	store := flow.NewMemoryStore()
+	if _, _, err := flow.Run(context.Background(), step, benchmarkItems, flow.Options{Store: store}); err != nil {
+		b.Fatal(err)
+	}
+	b.ResetTimer()
+	for range b.N {
+		if _, _, err := flow.Run(context.Background(), step, benchmarkItems, flow.Options{Store: store}); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkFlowCapturedGenerationReplay100(b *testing.B) {
+	prompts := make([]string, 100)
+	for index := range prompts {
+		prompts[index] = fmt.Sprintf("prompt-%03d", index)
+	}
+	step := flow.Step[string, string]{
+		Name: "bench-generate", ID: effectlog.DefinitionID("p06.bench.generate", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectCaptured},
+		Policy:   flow.Policy{Workers: 8},
+		Capture:  flow.JSONCapture[string, string](func(value string) (string, error) { return value, nil }),
+		Do:       func(_ context.Context, value string) (string, error) { return "answer:" + value, nil },
+	}
+	capture, _ := effectlog.New(effectlog.Options{Mode: effectlog.ModeCapture})
+	if _, _, err := flow.Run(context.Background(), step, prompts, flow.Options{Effects: capture}); err != nil {
+		b.Fatal(err)
+	}
+	snapshot := capture.Snapshot()
+	step.Do = func(context.Context, string) (string, error) { return "", fmt.Errorf("live work forbidden") }
+	b.ResetTimer()
+	for range b.N {
+		replay, err := effectlog.NewFromSnapshot(snapshot, effectlog.Options{Mode: effectlog.ModeReplay})
+		if err != nil {
+			b.Fatal(err)
+		}
+		if _, _, err := flow.Run(context.Background(), step, prompts, flow.Options{Effects: replay}); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
