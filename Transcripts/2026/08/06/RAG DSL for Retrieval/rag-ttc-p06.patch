index 0000000000000000000000000000000000000000..3b05d80df7b56e4797cc4625baad827ff534b8f3
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/standalone/batch.go
@@ -0,0 +1,58 @@
+package standalone
+
+import "fmt"
+
+// BatchFunc must return one aligned outcome for every request.
+type BatchFunc func([]Request) ([]Outcome, error)
+
+// RunBatches is the reference batch adapter. Partitions is a list of positive
+// sizes that must cover every request exactly once.
+func RunBatches(requests []Request, partitions []int, operation BatchFunc) ([]Outcome, error) {
+	if operation == nil {
+		return nil, fmt.Errorf("batch operation is required")
+	}
+	outputs := make([]Outcome, len(requests))
+	position := 0
+	for batchIndex, size := range partitions {
+		if size < 1 || position+size > len(requests) {
+			return nil, fmt.Errorf("invalid batch %d size %d", batchIndex, size)
+		}
+		batch := requests[position : position+size]
+		values, err := operation(batch)
+		if err != nil {
+			return nil, err
+		}
+		if len(values) != len(batch) {
+			return nil, fmt.Errorf("batch %d returned %d outputs for %d inputs", batchIndex, len(values), len(batch))
+		}
+		copy(outputs[position:position+size], values)
+		position += size
+	}
+	if position != len(requests) {
+		return nil, fmt.Errorf("partitions cover %d of %d requests", position, len(requests))
+	}
+	return outputs, nil
+}
+
+// PartitionMasks enumerates every ordered contiguous partition of n items.
+func PartitionMasks(n int) [][]int {
+	if n < 1 {
+		return nil
+	}
+	partitions := make([][]int, 0, 1<<max(n-1, 0))
+	for mask := 0; mask < 1<<(n-1); mask++ {
+		current := []int{}
+		size := 1
+		for boundary := 0; boundary < n-1; boundary++ {
+			if mask&(1<<boundary) != 0 {
+				current = append(current, size)
+				size = 1
+			} else {
+				size++
+			}
+		}
+		current = append(current, size)
+		partitions = append(partitions, current)
+	}
+	return partitions
+}
