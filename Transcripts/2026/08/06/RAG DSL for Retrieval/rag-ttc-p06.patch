+func TestAllCompletionSchedulesRestoreInputOrder(t *testing.T) {
+	requests := fixtureRequests(6)
+	baseline, err := Run(context.Background(), requests, fixturePolicy(), &State{}, deterministicOperation())
+	if err != nil {
+		t.Fatal(err)
+	}
+	permutations := 0
+	forEachPermutation(len(requests), func(schedule []int) {
+		policy := fixturePolicy()
+		policy.Schedule = schedule
+		actual, runErr := Run(context.Background(), requests, policy, &State{}, deterministicOperation())
+		if runErr != nil {
+			t.Fatalf("schedule=%v: %v", schedule, runErr)
+		}
+		if !reflect.DeepEqual(actual.Outputs, baseline.Outputs) {
+			t.Fatalf("schedule=%v outputs=%v baseline=%v", schedule, actual.Outputs, baseline.Outputs)
+		}
+		permutations++
+	})
+	if permutations != 720 {
+		t.Fatalf("tested %d permutations", permutations)
+	}
+}
