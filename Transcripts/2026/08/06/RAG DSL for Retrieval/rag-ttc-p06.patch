+package effectlog
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestCaptureThenReplayAvoidsDuplicateEffect(t *testing.T) {
+	clock := deterministicClock(time.Date(2026, 8, 5, 12, 0, 0, 0, time.UTC), time.Millisecond)
+	recorder, err := New(Options{Mode: ModeCapture, Clock: clock})
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := fixtureRequest(1)
+	var calls atomic.Int32
+	work := func(context.Context) Outcome {
+		calls.Add(1)
+		return Outcome{Response: json.RawMessage(`{"answer":42}`)}
+	}
+	first, err := recorder.Execute(context.Background(), request, work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := recorder.Execute(context.Background(), request, work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Replayed || !second.Replayed || calls.Load() != 1 {
+		t.Fatalf("first=%+v second=%+v calls=%d", first, second, calls.Load())
+	}
+	if string(first.Outcome.Response) != string(second.Outcome.Response) {
+		t.Fatal("replay changed response")
+	}
+}
+
+func TestReplayUsesSemanticAttemptIdentityNotTraceIdentity(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture})
+	first := fixtureRequest(1)
+	_, err := recorder.Execute(context.Background(), first, func(context.Context) Outcome {
+		return Outcome{ErrorClass: "transient", ErrorMessage: "timeout"}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second := first
+	second.Run = "another-run"
+	second.Stage = "another-stage"
+	second.Operation = "another-operation"
+	second.Attempt = "another-attempt"
+	result, ok := recorder.Replay(second)
+	if !ok || result.Outcome.ErrorClass != "transient" {
+		t.Fatalf("replay=%+v ok=%v", result, ok)
+	}
+	second.AttemptNumber = 2
+	if _, ok := recorder.Replay(second); ok {
+		t.Fatal("attempt number must separate captured observations")
+	}
+}
+
+func TestReplayModeFailsClosedOnMiss(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeReplay})
+	_, err := recorder.Execute(context.Background(), fixtureRequest(1), func(context.Context) Outcome {
+		t.Fatal("live work must not run")
+		return Outcome{}
+	})
+	if !errors.Is(err, ErrReplayMiss) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestSnapshotTamperingIsDetected(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture})
+	_, err := recorder.Execute(context.Background(), fixtureRequest(1), func(context.Context) Outcome {
+		return Outcome{Response: json.RawMessage(`"original"`)}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot := recorder.Snapshot()
+	snapshot.Captures[0].Outcome.Response = json.RawMessage(`"tampered"`)
+	if _, err := NewFromSnapshot(snapshot, Options{Mode: ModeReplay}); err == nil {
+		t.Fatal("tampered capture accepted")
+	}
+}
+
+func TestConcurrentDuplicateCaptureIsSingleFlight(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture})
+	request := fixtureRequest(1)
+	var calls atomic.Int32
+	const workers = 64
+	var wait sync.WaitGroup
+	wait.Add(workers)
+	errorsFound := make(chan error, workers)
+	for range workers {
+		go func() {
+			defer wait.Done()
+			_, err := recorder.Execute(context.Background(), request, func(context.Context) Outcome {
+				calls.Add(1)
+				time.Sleep(time.Millisecond)
+				return Outcome{Response: json.RawMessage(`7`)}
+			})
+			errorsFound <- err
+		}()
+	}
+	wait.Wait()
+	close(errorsFound)
+	for err := range errorsFound {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("live calls=%d", calls.Load())
+	}
+	if len(recorder.Snapshot().Captures) != 1 {
+		t.Fatal("expected one capture")
+	}
+}
+
+func TestTraceIdentityHierarchy(t *testing.T) {
+	step := DefinitionID("rag.generate", "v3")
+	stageA := DeriveStageID("run-fixed", 1, step)
+	stageB := DeriveStageID("run-fixed", 2, step)
+	if stageA == stageB {
+		t.Fatal("repeated step placements conflated")
+	}
+	operation := DeriveOperationID(stageA, "request-17")
+	if DeriveAttemptID(operation, 1) == DeriveAttemptID(operation, 2) {
+		t.Fatal("attempts conflated")
+	}
+}
+
+func fixtureRequest(attempt int) Request {
+	step := DefinitionID("rag.fixture", "v1")
+	stage := DeriveStageID("run-1", 1, step)
+	operation := DeriveOperationID(stage, "item-1")
+	return Request{
+		Run: "run-1", Step: step, Stage: stage, Operation: operation,
+		Attempt: DeriveAttemptID(operation, attempt), AttemptNumber: attempt,
+		SemanticKey: "fixture-semantic-key", Payload: json.RawMessage(`{"q":"oak"}`),
+	}
+}
+
+func deterministicClock(start time.Time, step time.Duration) func() time.Time {
+	var mutex sync.Mutex
+	now := start
+	return func() time.Time {
+		mutex.Lock()
+		defer mutex.Unlock()
+		value := now
+		now = now.Add(step)
+		return value
+	}
+}
+
+func TestSemanticKeyReuseWithDifferentPayloadFailsClosed(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture})
+	first := fixtureRequest(1)
+	_, err := recorder.Execute(context.Background(), first, func(context.Context) Outcome {
+		return Outcome{Response: json.RawMessage(`"first"`)}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second := first
+	second.Payload = json.RawMessage(`{"q":"maple"}`)
+	_, err = recorder.Execute(context.Background(), second, func(context.Context) Outcome {
+		t.Fatal("mismatched payload must not execute or replay")
+		return Outcome{}
+	})
+	if !errors.Is(err, ErrPayloadMismatch) {
+		t.Fatalf("got %v", err)
+	}
+	if _, ok := recorder.Replay(second); ok {
+		t.Fatal("unchecked Replay accepted a mismatched payload")
+	}
+}
+
+func TestReadSnapshotRejectsTrailingJSON(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture})
+	_, err := recorder.Execute(context.Background(), fixtureRequest(1), func(context.Context) Outcome {
+		return Outcome{Response: json.RawMessage(`1`)}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(recorder.Snapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := t.TempDir() + "/capture.json"
+	data = append(data, []byte("\n{}\n")...)
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReadSnapshot(path); err == nil {
+		t.Fatal("trailing JSON accepted")
+	}
+}
+
+func TestSnapshotRejectsInvalidCaptureEvent(t *testing.T) {
+	recorder, _ := New(Options{Mode: ModeCapture, Clock: deterministicClock(
+		time.Date(2026, 8, 5, 12, 0, 0, 0, time.UTC), time.Millisecond,
+	)})
+	_, err := recorder.Execute(context.Background(), fixtureRequest(1), func(context.Context) Outcome {
+		return Outcome{Response: json.RawMessage(`1`)}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot := recorder.Snapshot()
+	if len(snapshot.Events) == 0 || snapshot.Events[0].SchemaVersion != EventSchema {
+		t.Fatalf("events=%+v", snapshot.Events)
+	}
+	snapshot.Events[0].SchemaVersion = OperationTraceSchemaForTest
+	if _, err := NewFromSnapshot(snapshot, Options{Mode: ModeReplay}); err == nil {
+		t.Fatal("invalid capture-event schema accepted")
+	}
+}
+
+const OperationTraceSchemaForTest = "operation-trace/v1"
