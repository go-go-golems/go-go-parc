new file mode 100755
index 0000000000000000000000000000000000000000..dacf1edf376cfb3a1093e408f92204cacddf7342
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/scripts/validate_artifacts.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Validate P06 neutral fixtures, traces, reports, captures, and results."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from jsonschema import Draft202012Validator, FormatChecker, RefResolver
+
+
+def load(path: Path) -> Any:
+    with path.open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def validator(schema_path: Path) -> Draft202012Validator:
+    schema = load(schema_path)
+    store: dict[str, Any] = {}
+    for candidate in schema_path.parent.glob("*.schema.json"):
+        value = load(candidate)
+        store[candidate.resolve().as_uri()] = value
+        store[candidate.name] = value
+        if isinstance(value, dict) and "$id" in value:
+            store[str(value["$id"])] = value
+    resolver = RefResolver.from_schema(schema, store=store)
+    return Draft202012Validator(schema, resolver=resolver, format_checker=FormatChecker())
+
+
+def check(value: Any, schema_path: Path, label: str, errors: list[str]) -> None:
+    found = sorted(validator(schema_path).iter_errors(value), key=lambda item: list(item.path))
+    for error in found:
+        location = "/".join(str(part) for part in error.absolute_path) or "<root>"
+        errors.append(f"{label}: {location}: {error.message}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    schemas = root / "schemas"
+    errors: list[str] = []
+    counts = {
+        "fixtures": 0,
+        "trace_events": 0,
+        "flow_reports": 0,
+        "capture_snapshots": 0,
+        "captures": 0,
+        "project_results": 0,
+    }
+
+    fixture_schema = schemas / "p06-fixture-v1.schema.json"
+    for path in sorted((root / "fixtures").glob("*.json")):
+        check(load(path), fixture_schema, str(path.relative_to(root)), errors)
+        counts["fixtures"] += 1
+
+    report_path = root / "results/raw/sample-flow-report.json"
+    check(load(report_path), schemas / "flow-report-v2.schema.json", str(report_path.relative_to(root)), errors)
+    counts["flow_reports"] += 1
+
+    trace_path = root / "results/raw/sample-operation-trace.jsonl"
+    trace_validator = validator(schemas / "operation-trace-v1.schema.json")
+    previous = 0
+    with trace_path.open("r", encoding="utf-8") as handle:
+        for line_number, line in enumerate(handle, start=1):
+            event = json.loads(line)
+            for error in trace_validator.iter_errors(event):
+                location = "/".join(str(part) for part in error.absolute_path) or "<root>"
+                errors.append(f"{trace_path.relative_to(root)}:{line_number}: {location}: {error.message}")
+            sequence = event.get("sequence", 0)
+            if sequence <= previous:
+                errors.append(f"{trace_path.relative_to(root)}:{line_number}: sequence {sequence} is not increasing")
+            previous = sequence
+            counts["trace_events"] += 1
+
+    snapshot_path = root / "results/raw/captured-effects.json"
+    snapshot = load(snapshot_path)
+    check(snapshot, schemas / "captured-effect-snapshot-v1.schema.json", str(snapshot_path.relative_to(root)), errors)
+    counts["capture_snapshots"] += 1
+    capture_validator = validator(schemas / "captured-effect-v1.schema.json")
+    for index, capture in enumerate(snapshot.get("captures", [])):
+        for error in capture_validator.iter_errors(capture):
+            location = "/".join(str(part) for part in error.absolute_path) or "<root>"
+            errors.append(f"{snapshot_path.relative_to(root)}:captures/{index}/{location}: {error.message}")
+        counts["captures"] += 1
+
+    result_path = root / "results.json"
+    if result_path.exists():
+        check(load(result_path), schemas / "project-result.schema.json", str(result_path.relative_to(root)), errors)
+        counts["project_results"] += 1
+
+    output = {
+        "schema_version": "p06-artifact-validation/v1",
+        "status": "pass" if not errors else "fail",
+        "counts": counts,
+        "errors": errors,
+    }
+    text = json.dumps(output, indent=2, sort_keys=True) + "\n"
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(text, encoding="utf-8")
+    print(text, end="")
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
