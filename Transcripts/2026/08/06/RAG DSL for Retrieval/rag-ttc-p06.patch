+package flowtest
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+)
+
+func TestCompareSeparatesSemanticOutputFromOperationalTrace(t *testing.T) {
+	step := func(workers int) Executor[int, int] {
+		return func(ctx context.Context, items []int) ([]flow.Result[int], flow.Report, error) {
+			return flow.Run(ctx, flow.Step[int, int]{
+				Name: "double", Contract: flow.Contract{Effect: flow.EffectPure},
+				Policy: flow.Policy{Workers: workers},
+				Do: func(_ context.Context, value int) (int, error) {
+					time.Sleep(time.Duration(5-value) * time.Microsecond)
+					return value * 2, nil
+				},
+			}, items, flow.Options{})
+		}
+	}
+	assessment, err := Compare(context.Background(), Case[int, int]{
+		Name: "workers", Inputs: []int{1, 2, 3, 4}, Baseline: step(1),
+		Variants: []Variant[int, int]{{Name: "parallel", Run: step(4)}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !assessment.Transparent || len(assessment.Differences) != 0 {
+		t.Fatalf("assessment=%+v", assessment)
+	}
+	if assessment.Baseline.Report.RunID == assessment.Variants["parallel"].Report.RunID {
+		t.Fatal("operational runs unexpectedly share trace identity")
+	}
+}
+
+func TestCompareFindsNonTransparentVariant(t *testing.T) {
+	executor := func(reverse bool) Executor[int, int] {
+		return func(ctx context.Context, items []int) ([]flow.Result[int], flow.Report, error) {
+			results := make([]flow.Result[int], len(items))
+			for index, item := range items {
+				target := index
+				if reverse {
+					target = len(items) - 1 - index
+				}
+				results[target] = flow.Result[int]{Value: item}
+			}
+			return results, flow.Report{}, nil
+		}
+	}
+	assessment, err := Compare(context.Background(), Case[int, int]{
+		Name: "ordering", Inputs: []int{1, 2, 3}, Baseline: executor(false),
+		Variants: []Variant[int, int]{{Name: "reversed", Run: executor(true)}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if assessment.Transparent || len(assessment.Differences) == 0 {
+		t.Fatal("non-transparent variant passed")
+	}
+}
