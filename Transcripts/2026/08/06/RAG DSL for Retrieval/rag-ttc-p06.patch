+package effectlog
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// RunID identifies one execution trace.
+type RunID string
+
+// StepID identifies a stable step definition independently of its display name.
+type StepID string
+
+// StageID identifies one placement of a step definition in one run.
+type StageID string
+
+// OperationID identifies one logical operation, possibly with many attempts.
+type OperationID string
+
+// AttemptID identifies one concrete attempt of a logical operation.
+type AttemptID string
+
+// BatchID identifies one physical batch containing one or more operations.
+type BatchID string
+
+// DefinitionID derives a stable step identifier from a semantic kind/version
+// pair. A display name is intentionally not part of the input.
+func DefinitionID(kind, version string) StepID {
+	return StepID(derive("step", kind, version))
+}
+
+// DeriveStageID derives a run-local stage placement identifier.
+func DeriveStageID(run RunID, ordinal uint64, step StepID) StageID {
+	return StageID(derive("stage", string(run), fmt.Sprintf("%d", ordinal), string(step)))
+}
+
+// DeriveOperationID derives a logical operation identifier. localKey must be
+// stable within the stage, such as a semantic cache-key digest or input index.
+func DeriveOperationID(stage StageID, localKey string) OperationID {
+	return OperationID(derive("operation", string(stage), localKey))
+}
+
+// DeriveAttemptID derives an attempt identifier from its logical operation.
+func DeriveAttemptID(operation OperationID, number int) AttemptID {
+	return AttemptID(derive("attempt", string(operation), fmt.Sprintf("%d", number)))
+}
+
+// DeriveBatchID derives an identifier for one physical batch.
+func DeriveBatchID(stage StageID, localKey string) BatchID {
+	return BatchID(derive("batch", string(stage), localKey))
+}
+
+// NewRunID creates an opaque run identifier. Tests and replay tools should
+// inject a fixed RunID instead when cross-run trace comparison is required.
+func NewRunID() RunID {
+	var entropy [16]byte
+	if _, err := rand.Read(entropy[:]); err == nil {
+		return RunID("run_" + hex.EncodeToString(entropy[:]))
+	}
+	return RunID(derive("run", time.Now().UTC().Format(time.RFC3339Nano)))
+}
+
+// ValidateID rejects empty or whitespace-only IDs at API boundaries.
+func ValidateID(kind string, value fmt.Stringer) error {
+	if strings.TrimSpace(value.String()) == "" {
+		return fmt.Errorf("%s is required", kind)
+	}
+	return nil
+}
+
+func derive(domain string, parts ...string) string {
+	h := sha256.New()
+	writePart(h, "rag-ttc-effectlog/v1")
+	writePart(h, domain)
+	for _, part := range parts {
+		writePart(h, part)
+	}
+	return domain + "_" + hex.EncodeToString(h.Sum(nil))
+}
+
+func writePart(h interface{ Write([]byte) (int, error) }, value string) {
+	length := fmt.Sprintf("%d:", len(value))
+	_, _ = h.Write([]byte(length))
+	_, _ = h.Write([]byte(value))
+}
+
+func (id RunID) String() string       { return string(id) }
+func (id StepID) String() string      { return string(id) }
+func (id StageID) String() string     { return string(id) }
+func (id OperationID) String() string { return string(id) }
+func (id AttemptID) String() string   { return string(id) }
+func (id BatchID) String() string     { return string(id) }
