+func invokeBulk[I, O any](ctx context.Context, step Step[I, O], doBulk func(context.Context, []I) ([]O, error), classifier Classifier, items []I, invocation Invocation, options Options) invocationResult[[]O] {
+	callContext := withInvocation(ctx, invocation)
+	if step.Capture == nil || options.Effects == nil {
+		values, err := doBulk(callContext, items)
+		class := Fatal
+		if err != nil {
+			class = classifier.Classify(err)
+		}
+		return invocationResult[[]O]{value: values, err: err, class: class, live: true}
+	}
+	requests := make([]json.RawMessage, len(items))
+	for index, item := range items {
+		payload, err := step.Capture.encodeRequest(item)
+		if err != nil {
+			return invocationResult[[]O]{err: err, class: Fatal}
+		}
+		requests[index] = payload
+	}
+	payload, err := json.Marshal(requests)
+	if err != nil {
+		return invocationResult[[]O]{err: err, class: Fatal}
+	}
+	request := effectlog.Request{
+		Run: invocation.Run, Step: invocation.Step, Stage: invocation.Stage,
+		Operation: invocation.Operation, Attempt: invocation.Attempt, Batch: invocation.Batch,
+		AttemptNumber: invocation.AttemptNumber, SemanticKey: invocation.SemanticKey,
+		Payload: payload,
+	}
+	var codecErr error
+	result, err := options.Effects.Execute(callContext, request, func(liveContext context.Context) effectlog.Outcome {
+		values, callErr := doBulk(liveContext, items)
+		if callErr != nil {
+			class := classifier.Classify(callErr)
+			return effectlog.Outcome{ErrorClass: class.String(), ErrorMessage: callErr.Error()}
+		}
+		responses := make([]json.RawMessage, len(values))
+		for index, value := range values {
+			encoded, encodeErr := step.Capture.encodeResponse(value)
+			if encodeErr != nil {
+				codecErr = encodeErr
+				return effectlog.Outcome{ErrorClass: Fatal.String(), ErrorMessage: encodeErr.Error()}
+			}
+			responses[index] = encoded
+		}
+		encoded, encodeErr := json.Marshal(responses)
+		if encodeErr != nil {
+			codecErr = encodeErr
+			return effectlog.Outcome{ErrorClass: Fatal.String(), ErrorMessage: encodeErr.Error()}
+		}
+		return effectlog.Outcome{Response: encoded}
+	})
+	if err != nil {
+		return invocationResult[[]O]{err: err, class: Fatal}
+	}
+	if codecErr != nil {
+		return invocationResult[[]O]{err: codecErr, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+	}
+	if result.Outcome.ErrorMessage != "" {
+		class, parseErr := parseErrorClass(result.Outcome.ErrorClass)
+		if parseErr != nil {
+			return invocationResult[[]O]{err: parseErr, class: Fatal, replayed: result.Replayed, captureKey: result.CaptureKey}
+		}
+		return invocationResult[[]O]{
+			err: errors.New(result.Outcome.ErrorMessage), class: class,
+			live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey,
+		}
+	}
+	var responses []json.RawMessage
+	if err := json.Unmarshal(result.Outcome.Response, &responses); err != nil {
+		return invocationResult[[]O]{err: err, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+	}
+	values := make([]O, len(responses))
+	for index, response := range responses {
+		value, err := step.Capture.decodeResponse(response)
+		if err != nil {
+			return invocationResult[[]O]{err: err, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+		}
+		values[index] = value
+	}
+	return invocationResult[[]O]{value: values, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+}
