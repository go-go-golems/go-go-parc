+package errgroup
+import (
+ "context"
+ "sync"
+)
+type Group struct { cancel func(); wg sync.WaitGroup; once sync.Once; err error }
+func WithContext(ctx context.Context) (*Group, context.Context) { c, cancel := context.WithCancel(ctx); return &Group{cancel:cancel}, c }
+func (g *Group) Go(fn func() error) { g.wg.Add(1); go func(){ defer g.wg.Done(); if err:=fn(); err!=nil { g.once.Do(func(){g.err=err; if g.cancel!=nil {g.cancel()} }) } }() }
+func (g *Group) Wait() error { g.wg.Wait(); if g.cancel!=nil {g.cancel()}; return g.err }
