+func TestCapturedRetryReplaysAttemptSequenceOffline(t *testing.T) {
+	recorder, err := effectlog.New(effectlog.Options{Mode: effectlog.ModeCapture, Clock: fixedTestClock()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var calls atomic.Int32
+	step := Step[string, string]{
+		Name: "generate", ID: effectlog.DefinitionID("fixture.generate", "v1"),
+		Contract: Contract{Effect: EffectCaptured},
+		Policy: Policy{Retry: RetrySpec{
+			Attempts: 2, Backoff: Backoff{Base: time.Nanosecond, Cap: time.Nanosecond},
+		}},
+		Capture: JSONCapture[string, string](func(value string) (string, error) { return "prompt:" + value, nil }),
+		Do: func(_ context.Context, value string) (string, error) {
+			if calls.Add(1) == 1 {
+				return "", &StatusError{Status: 503, Err: errors.New("transient fixture")}
+			}
+			return "answer:" + value, nil
+		},
+	}
+	first, firstReport, err := Run(context.Background(), step, []string{"oak"}, Options{
+		Effects: recorder, Trace: TraceOptions{RunID: "capture-run", Clock: fixedTestClock()},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first[0].Value != "answer:oak" || calls.Load() != 2 {
+		t.Fatalf("first=%+v calls=%d", first, calls.Load())
+	}
+	if firstReport.Step("generate").WorkCalls != 2 || len(firstReport.Operations[0].Attempts) != 2 {
+		t.Fatalf("first report=%+v", firstReport)
+	}
+
+	replay, err := effectlog.NewFromSnapshot(recorder.Snapshot(), effectlog.Options{Mode: effectlog.ModeReplay, Clock: fixedTestClock()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	step.Do = func(context.Context, string) (string, error) {
+		t.Fatal("offline replay called live provider")
+		return "", nil
+	}
+	second, secondReport, err := Run(context.Background(), step, []string{"oak"}, Options{
+		Effects: replay, Trace: TraceOptions{RunID: "replay-run", Clock: fixedTestClock()},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second[0].Value != first[0].Value {
+		t.Fatalf("capture=%q replay=%q", first[0].Value, second[0].Value)
+	}
+	if secondReport.Step("generate").WorkCalls != 0 || secondReport.Step("generate").Replayed != 2 {
+		t.Fatalf("replay report=%+v", secondReport.Step("generate"))
+	}
+}
