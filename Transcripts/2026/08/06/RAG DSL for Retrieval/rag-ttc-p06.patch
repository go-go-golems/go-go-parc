+		t.Fatalf("per-item=%v bulk=%v", valuesOf(perItem), valuesOf(batched))
+	}
+
+	reversed := Bulk(base, func(_ context.Context, batch []int) ([]int, error) {
+		outputs := make([]int, len(batch))
+		for index, value := range batch {
+			outputs[len(batch)-1-index] = value * value
+		}
+		return outputs, nil
+	}, len(items))
+	wrong, _, err := Run(context.Background(), reversed, items, Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reflect.DeepEqual(valuesOf(perItem), valuesOf(wrong)) {
+		t.Fatal("order-sensitive batch counterexample did not differ")
+	}
+}
