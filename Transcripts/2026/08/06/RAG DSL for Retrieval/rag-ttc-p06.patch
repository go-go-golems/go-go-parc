+// Validate checks the structural integrity of a v2 report. It intentionally
+// does not decide whether provider responses are semantically correct; it
+// verifies that the trace hierarchy is non-conflating and internally linked.
+func (report Report) Validate() error {
+	if report.SchemaVersion != ReportSchemaV2 {
+		return fmt.Errorf("flow report schema %q, expected %q", report.SchemaVersion, ReportSchemaV2)
+	}
+	if report.RunID == "" {
+		return fmt.Errorf("flow report run ID is required")
+	}
+	if report.Status == StatusCompleted && report.StopReason != StopCompleted {
+		return fmt.Errorf("completed flow report has stop reason %q", report.StopReason)
+	}
+	if report.Status == StatusStopped && report.StopReason == StopNone {
+		return fmt.Errorf("stopped flow report has no stop reason")
+	}
+	stages := make(map[StageID]StageReport, len(report.Stages))
+	ordinals := make(map[uint64]StageID, len(report.Stages))
+	for _, stage := range report.Stages {
+		if stage.StageID == "" || stage.StepID == "" || stage.Name == "" || stage.Ordinal == 0 {
+			return fmt.Errorf("flow report contains incomplete stage identity: %+v", stage)
+		}
+		expectedStage := effectlog.DeriveStageID(report.RunID, stage.Ordinal, stage.StepID)
+		if stage.StageID != expectedStage {
+			return fmt.Errorf("flow report stage %q does not match run, ordinal, and step identity", stage.StageID)
+		}
+		if _, exists := stages[stage.StageID]; exists {
+			return fmt.Errorf("flow report repeats stage ID %q", stage.StageID)
+		}
+		if existing, exists := ordinals[stage.Ordinal]; exists {
+			return fmt.Errorf("flow report stages %q and %q share ordinal %d", existing, stage.StageID, stage.Ordinal)
+		}
+		stages[stage.StageID] = stage
+		ordinals[stage.Ordinal] = stage.StageID
+	}
+	operations := make(map[OperationID]bool, len(report.Operations))
+	attempts := map[AttemptID]bool{}
+	for _, operation := range report.Operations {
+		if operation.OperationID == "" || operation.StageID == "" || operation.StepID == "" || operation.Name == "" {
+			return fmt.Errorf("flow report contains incomplete operation identity: %+v", operation)
+		}
+		if operations[operation.OperationID] {
+			return fmt.Errorf("flow report repeats operation ID %q", operation.OperationID)
+		}
+		operations[operation.OperationID] = true
+		stage, exists := stages[operation.StageID]
+		if !exists {
+			return fmt.Errorf("flow operation %q references unknown stage %q", operation.OperationID, operation.StageID)
+		}
+		if operation.StepID != stage.StepID || operation.Name != stage.Name {
+			return fmt.Errorf("flow operation %q disagrees with its stage identity", operation.OperationID)
+		}
+		seenNumbers := map[int]bool{}
+		for _, attempt := range operation.Attempts {
+			if attempt.AttemptID == "" || attempt.Number < 1 {
+				return fmt.Errorf("flow operation %q has incomplete attempt identity", operation.OperationID)
+			}
+			expectedAttempt := effectlog.DeriveAttemptID(operation.OperationID, attempt.Number)
+			if attempt.AttemptID != expectedAttempt {
+				return fmt.Errorf("flow attempt %q does not match operation and attempt number", attempt.AttemptID)
+			}
+			if attempts[attempt.AttemptID] {
+				return fmt.Errorf("flow report repeats attempt ID %q", attempt.AttemptID)
+			}
+			if seenNumbers[attempt.Number] {
+				return fmt.Errorf("flow operation %q repeats attempt number %d", operation.OperationID, attempt.Number)
+			}
+			attempts[attempt.AttemptID] = true
+			seenNumbers[attempt.Number] = true
+		}
+	}
+	return nil
+}
