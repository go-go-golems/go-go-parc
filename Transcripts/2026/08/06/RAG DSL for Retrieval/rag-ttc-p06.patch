@@ -0,0 +1,27 @@
+package standalone
+
+// ItemLocalTopOne demonstrates the invalid item-local interpretation of a
+// global top-one operation: every item sees only itself and is selected.
+func ItemLocalTopOne(scores []int) []bool {
+	selected := make([]bool, len(scores))
+	for index := range selected {
+		selected[index] = true
+	}
+	return selected
+}
+
+// SnapshotTopOne observes the complete collection and returns an aligned view.
+func SnapshotTopOne(scores []int) []bool {
+	selected := make([]bool, len(scores))
+	if len(scores) == 0 {
+		return selected
+	}
+	best := 0
+	for index := 1; index < len(scores); index++ {
+		if scores[index] > scores[best] {
+			best = index
+		}
+	}
+	selected[best] = true
+	return selected
+}
diff --git a/research/p06-flow-executor-semantics-effects/standalone/model.go b/research/p06-flow-executor-semantics-effects/standalone/model.go
new file mode 100644
index 0000000000000000000000000000000000000000..008d180cfc4acefea2d77595691fac523cca092f
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/standalone/model.go
@@ -0,0 +1,187 @@
+package standalone
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+// Run executes requests in Policy.Schedule but writes every output back to its
+// input position. It is deliberately sequential: schedule permutations model
+// all relevant completion orders for an add-only, item-local executor.
+func Run(ctx context.Context, requests []Request, policy Policy, state *State, operation Operation) (Result, error) {
+	result := Result{Outputs: make([]Outcome, len(requests))}
+	if err := validatePolicy(policy); err != nil {
+		result.StopReason = "invalid-contract"
+		return result, err
+	}
+	if state == nil {
+		state = &State{}
+	}
+	if state.Cache == nil {
+		state.Cache = map[string]Outcome{}
+	}
+	if state.Captures == nil {
+		state.Captures = map[string]Capture{}
+	}
+	schedule, err := normalizeSchedule(len(requests), policy.Schedule)
+	if err != nil {
+		result.StopReason = "invalid-schedule"
+		return result, err
+	}
+	attempts := policy.Attempts
+	if attempts < 1 {
+		attempts = 1
+	}
+	runID := hash("run", policy.StepID, fmt.Sprint(schedule))
+	stageID := hash("stage", runID, policy.StepID, "1")
+	sequence := 0
+	now := time.Date(2026, 8, 5, 12, 0, 0, 0, time.UTC)
+	emit := func(kind string, invocation Invocation, replayed bool, outcome Outcome) {
+		sequence++
+		result.Events = append(result.Events, Event{
+			Sequence: sequence, Kind: kind, At: now.Add(time.Duration(sequence) * time.Microsecond),
+			Invocation: invocation, Replayed: replayed,
+			ErrorClass: outcome.ErrorClass, ErrorMessage: outcome.ErrorMessage,
+		})
+	}
+
+	for _, index := range schedule {
+		if err := ctx.Err(); err != nil {
+			result.StopReason = "canceled"
+			return result, err
+		}
+		request := requests[index]
+		if request.SemanticKey == "" || !json.Valid(request.Payload) {
+			result.StopReason = "invalid-request"
+			return result, fmt.Errorf("request %d has invalid semantic identity or payload", index)
+		}
+		operationID := hash("operation", stageID, request.SemanticKey)
+		if policy.UseCache {
+			if cached, ok := state.Cache[request.SemanticKey]; ok {
+				result.Outputs[index] = cached
+				result.CacheHits++
+				emit("cache-hit", invocation(runID, policy.StepID, stageID, operationID, 0, index, request.SemanticKey), false, cached)
+				continue
+			}
+		}
+		if policy.Budget >= 0 && result.Admitted >= policy.Budget {
+			result.StopReason = "budget-exhausted"
+			return result, fmt.Errorf("budget exhausted before request %d", index)
+		}
+		result.Admitted++
+
+		var final Outcome
+		for attempt := 1; attempt <= attempts; attempt++ {
+			current := invocation(runID, policy.StepID, stageID, operationID, attempt, index, request.SemanticKey)
+			emit("attempt-started", current, false, Outcome{})
+			captureKey := hash("capture", policy.StepID, request.SemanticKey, fmt.Sprint(attempt))
+			if policy.Capture != CaptureOff {
+				if capture, ok := state.Captures[captureKey]; ok {
+					if !bytes.Equal(capture.Payload, request.Payload) {
+						result.StopReason = "capture-payload-mismatch"
+						return result, fmt.Errorf("semantic key %q reused for different payload", request.SemanticKey)
+					}
+					final = capture.Outcome
+					result.Replayed++
+					emit("attempt-finished", current, true, final)
+				} else {
+					if policy.Capture == CaptureReplay {
+						result.StopReason = "replay-miss"
+						return result, fmt.Errorf("replay miss for %s", captureKey)
+					}
+					if operation == nil {
+						return result, fmt.Errorf("live operation is required")
+					}
+					final = operation(ctx, current, request)
+					result.WorkCalls++
+					state.Captures[captureKey] = Capture{Key: captureKey, Payload: append(json.RawMessage(nil), request.Payload...), Outcome: final}
+					emit("attempt-finished", current, false, final)
+				}
+			} else {
+				if operation == nil {
+					return result, fmt.Errorf("live operation is required")
+				}
+				final = operation(ctx, current, request)
+				result.WorkCalls++
+				emit("attempt-finished", current, false, final)
+			}
+			if final.ErrorClass == NoError {
+				break
+			}
+			if final.ErrorClass != Transient || attempt == attempts {
+				break
+			}
+		}
+		result.Outputs[index] = final
+		if policy.UseCache && final.ErrorClass == NoError {
+			state.Cache[request.SemanticKey] = final
+		}
+	}
+	result.Completed = true
+	result.StopReason = "completed"
+	return result, nil
+}
+
+func validatePolicy(policy Policy) error {
+	if policy.DisplayName == "" || policy.StepID == "" {
+		return fmt.Errorf("display name and stable step ID are required")
+	}
+	attempts := policy.Attempts
+	if attempts < 1 {
+		attempts = 1
+	}
+	if policy.Effect == NonIdempotent && attempts > 1 {
+		return fmt.Errorf("non-idempotent operation cannot be retried; recording does not deduplicate ambiguous mutations")
+	}
+	if policy.Effect == Captured && policy.Capture == CaptureOff {
+		return fmt.Errorf("captured operation requires capture or replay mode")
+	}
+	return nil
+}
+
+func normalizeSchedule(length int, schedule []int) ([]int, error) {
+	if len(schedule) == 0 {
+		schedule = make([]int, length)
+		for index := range schedule {
+			schedule[index] = index
+		}
+		return schedule, nil
+	}
+	if len(schedule) != length {
+		return nil, fmt.Errorf("schedule has %d indexes for %d requests", len(schedule), length)
+	}
+	seen := make([]bool, length)
+	for _, index := range schedule {
+		if index < 0 || index >= length || seen[index] {
+			return nil, fmt.Errorf("schedule is not a permutation")
+		}
+		seen[index] = true
+	}
+	return append([]int(nil), schedule...), nil
+}
+
+func invocation(runID, stepID, stageID, operationID string, attempt, index int, semanticKey string) Invocation {
+	attemptID := ""
+	if attempt > 0 {
+		attemptID = hash("attempt", operationID, fmt.Sprint(attempt))
+	}
+	return Invocation{
+		RunID: runID, StepID: stepID, StageID: stageID, OperationID: operationID,
+		AttemptID: attemptID, AttemptNumber: attempt, InputIndex: index, SemanticKey: semanticKey,
+	}
+}
+
+func hash(domain string, parts ...string) string {
+	digest := sha256.New()
+	_, _ = digest.Write([]byte("p06-standalone/v1\x00" + domain))
+	for _, part := range parts {
+		_, _ = digest.Write([]byte{0})
+		_, _ = digest.Write([]byte(part))
+	}
+	return domain + "_" + hex.EncodeToString(digest.Sum(nil))
+}
