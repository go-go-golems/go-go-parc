+#!/usr/bin/env bash
+set -euo pipefail
+
+PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd "$PROJECT_DIR/../.." && pwd)"
+RESULTS="$PROJECT_DIR/results/raw"
+mkdir -p "$RESULTS"
+
+IMPORT_ROOT="github.com/the-tree-center/rag-ttc"
+PACKAGES=(
+  "$IMPORT_ROOT/pkg/effectlog"
+  "$IMPORT_ROOT/pkg/flow"
+  "$IMPORT_ROOT/pkg/flowtest"
+  "$IMPORT_ROOT/research/p06-flow-executor-semantics-effects/standalone"
+  "$IMPORT_ROOT/research/p06-flow-executor-semantics-effects/adapter"
+)
+
+cleanup() { :; }
+if [[ "${P06_USE_MODULE:-auto}" == "1" ]] || {
+  [[ "${P06_USE_MODULE:-auto}" == "auto" ]] &&
+  (cd "$REPO_DIR" && GO111MODULE=on go list -m >/dev/null 2>&1)
+}; then
+  export GO111MODULE=on
+  cd "$REPO_DIR"
+  echo "P06: using repository module and declared dependency graph"
+else
+  HARNESS="$(mktemp -d "${TMPDIR:-/tmp}/rag-ttc-p06-gopath.XXXXXX")"
+  cleanup() { rm -rf "$HARNESS"; }
+  trap cleanup EXIT
+  mkdir -p "$HARNESS/src/github.com/the-tree-center"
+  cp -R "$PROJECT_DIR/compat/src/." "$HARNESS/src/"
+  ln -s "$REPO_DIR" "$HARNESS/src/$IMPORT_ROOT"
+  export GO111MODULE=off
+  export GOPATH="$HARNESS"
+  cd "$REPO_DIR"
+  echo "P06: using validation-only offline GOPATH compatibility harness"
+fi
+
+{
+  echo '$ go test -count=1 -race <P06 target packages>'
+  go test -count=1 -race "${PACKAGES[@]}"
+} 2>&1 | tee "$RESULTS/test-output.txt"
+
+{
+  echo '$ go vet <P06 target packages>'
+  go vet "${PACKAGES[@]}"
+} 2>&1 | tee "$RESULTS/vet-output.txt"
+
+{
+  echo '$ go build generation and embedding adapters'
+  go build "$IMPORT_ROOT/pkg/rag/generation" "$IMPORT_ROOT/pkg/rag/embedding"
+} 2>&1 | tee "$RESULTS/adapter-build-output.txt"
+
+go run "$IMPORT_ROOT/research/p06-flow-executor-semantics-effects/cmd/p06-demo" \
+  -out "$RESULTS/experiment-summary.json" \
+  -capture "$RESULTS/captured-effects.json" \
+  | tee "$RESULTS/demo-output.json"
+
+go run "$IMPORT_ROOT/research/p06-flow-executor-semantics-effects/cmd/p06-artifacts" \
+  -report "$RESULTS/sample-flow-report.json" \
+  -trace "$RESULTS/sample-operation-trace.jsonl"
+
+if python3 -c 'import jsonschema' >/dev/null 2>&1; then
+  PYTHONWARNINGS=ignore python3 "$PROJECT_DIR/scripts/validate_artifacts.py" \
+    --root "$PROJECT_DIR" \
+    --out "$RESULTS/schema-validation.json"
+else
+  echo 'P06: Python jsonschema unavailable; skipping JSON Schema validation' | tee "$RESULTS/schema-validation-skipped.txt"
+fi
+
+if [[ "${P06_BENCH:-0}" == "1" ]]; then
+  go test -run '^$' -bench '^BenchmarkFlow' -benchmem -benchtime=50x \
+    "$IMPORT_ROOT/research/p06-flow-executor-semantics-effects/adapter" \
+    | tee "$RESULTS/benchmarks.txt"
+fi
+
+printf '\nP06 complete. Primary outputs:\n'
+printf '  %s\n' \
+  "$RESULTS/test-output.txt" \
+  "$RESULTS/experiment-summary.json" \
+  "$RESULTS/captured-effects.json" \
+  "$RESULTS/sample-flow-report.json" \
+  "$RESULTS/sample-operation-trace.jsonl" \
+  "$RESULTS/schema-validation.json"
