@@ -0,0 +1,117 @@
+// Package standalone is an executable specification for P06. It has no
+// dependency on rag-ttc's production executor.
+package standalone
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+)
+
+// EffectKind states the precondition under which retry can be considered.
+type EffectKind string
+
+const (
+	Pure          EffectKind = "pure"
+	ReadOnly      EffectKind = "read-only"
+	Idempotent    EffectKind = "idempotent"
+	Captured      EffectKind = "captured"
+	NonIdempotent EffectKind = "non-idempotent"
+)
+
+// ErrorClass controls retry and item disposition in the reference model.
+type ErrorClass string
+
+const (
+	NoError   ErrorClass = ""
+	Transient ErrorClass = "transient"
+	DataError ErrorClass = "data"
+	Fatal     ErrorClass = "fatal"
+)
+
+// CaptureMode controls the reference observation store.
+type CaptureMode string
+
+const (
+	CaptureOff    CaptureMode = "off"
+	CaptureRecord CaptureMode = "capture"
+	CaptureReplay CaptureMode = "replay"
+)
+
+// Request has stable semantic identity and a diagnostic JSON payload.
+type Request struct {
+	SemanticKey string          `json:"semantic_key"`
+	Payload     json.RawMessage `json:"payload"`
+}
+
+// Outcome is the admitted response or classified operation failure.
+type Outcome struct {
+	Value        string     `json:"value,omitempty"`
+	ErrorClass   ErrorClass `json:"error_class,omitempty"`
+	ErrorMessage string     `json:"error_message,omitempty"`
+}
+
+// Invocation distinguishes one logical operation from one retry attempt.
+type Invocation struct {
+	RunID         string `json:"run_id"`
+	StepID        string `json:"step_id"`
+	StageID       string `json:"stage_id"`
+	OperationID   string `json:"operation_id"`
+	AttemptID     string `json:"attempt_id"`
+	AttemptNumber int    `json:"attempt_number"`
+	InputIndex    int    `json:"input_index"`
+	SemanticKey   string `json:"semantic_key"`
+}
+
+// Operation is the only live external boundary in the model.
+type Operation func(context.Context, Invocation, Request) Outcome
+
+// Policy varies execution history without being part of semantic request ID.
+type Policy struct {
+	DisplayName string      `json:"display_name"`
+	StepID      string      `json:"step_id"`
+	Effect      EffectKind  `json:"effect"`
+	Attempts    int         `json:"attempts"`
+	Budget      int         `json:"budget"`
+	UseCache    bool        `json:"use_cache"`
+	Capture     CaptureMode `json:"capture"`
+	// Schedule is a permutation of input indexes. It models completion order;
+	// outputs must still be restored to input order.
+	Schedule []int `json:"schedule,omitempty"`
+}
+
+// Event is operational history, not semantic output.
+type Event struct {
+	Sequence     int        `json:"sequence"`
+	Kind         string     `json:"kind"`
+	At           time.Time  `json:"at"`
+	Invocation   Invocation `json:"invocation"`
+	Replayed     bool       `json:"replayed,omitempty"`
+	ErrorClass   ErrorClass `json:"error_class,omitempty"`
+	ErrorMessage string     `json:"error_message,omitempty"`
+}
+
+// State holds persistent final-result cache and attempt captures.
+type State struct {
+	Cache    map[string]Outcome `json:"cache"`
+	Captures map[string]Capture `json:"captures"`
+}
+
+// Capture is one replayable attempt observation.
+type Capture struct {
+	Key     string          `json:"key"`
+	Payload json.RawMessage `json:"payload"`
+	Outcome Outcome         `json:"outcome"`
+}
+
+// Result distinguishes semantic output from operational observations.
+type Result struct {
+	Outputs    []Outcome `json:"outputs"`
+	Events     []Event   `json:"events"`
+	WorkCalls  int       `json:"work_calls"`
+	Replayed   int       `json:"replayed"`
+	CacheHits  int       `json:"cache_hits"`
+	Admitted   int       `json:"admitted"`
+	Completed  bool      `json:"completed"`
+	StopReason string    `json:"stop_reason,omitempty"`
+}
diff --git a/research/p06-flow-executor-semantics-effects/standalone/batch.go b/research/p06-flow-executor-semantics-effects/standalone/batch.go
