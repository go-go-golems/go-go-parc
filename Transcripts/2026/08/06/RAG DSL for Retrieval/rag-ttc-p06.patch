@@ -0,0 +1,185 @@
+package require
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func fail(t testing.TB, format string, args ...any) {
+	t.Helper()
+	t.Fatalf(format, args...)
+}
+
+func NoError(t testing.TB, err error, _ ...any) {
+	t.Helper()
+	if err != nil {
+		fail(t, "unexpected error: %v", err)
+	}
+}
+func Error(t testing.TB, err error, _ ...any) {
+	t.Helper()
+	if err == nil {
+		fail(t, "expected an error")
+	}
+}
+func ErrorIs(t testing.TB, err, target error, _ ...any) {
+	t.Helper()
+	if !errors.Is(err, target) {
+		fail(t, "expected error %v to match %v", err, target)
+	}
+}
+func Equal(t testing.TB, expected, actual any, _ ...any) {
+	t.Helper()
+	if !reflect.DeepEqual(expected, actual) {
+		fail(t, "not equal:\nexpected: %#v\nactual:   %#v", expected, actual)
+	}
+}
+func True(t testing.TB, value bool, _ ...any) {
+	t.Helper()
+	if !value {
+		fail(t, "expected true")
+	}
+}
+func False(t testing.TB, value bool, _ ...any) {
+	t.Helper()
+	if value {
+		fail(t, "expected false")
+	}
+}
+func Nil(t testing.TB, value any, _ ...any) {
+	t.Helper()
+	if !isNil(value) {
+		fail(t, "expected nil, got %#v", value)
+	}
+}
+func NotNil(t testing.TB, value any, _ ...any) {
+	t.Helper()
+	if isNil(value) {
+		fail(t, "expected non-nil")
+	}
+}
+func Empty(t testing.TB, value any, _ ...any) {
+	t.Helper()
+	if !isEmpty(value) {
+		fail(t, "expected empty, got %#v", value)
+	}
+}
+func NotEmpty(t testing.TB, value any, _ ...any) {
+	t.Helper()
+	if isEmpty(value) {
+		fail(t, "expected non-empty")
+	}
+}
+func Len(t testing.TB, value any, length int, _ ...any) {
+	t.Helper()
+	v := reflect.ValueOf(value)
+	if !v.IsValid() {
+		fail(t, "cannot take length of nil")
+	}
+	switch v.Kind() {
+	case reflect.Array, reflect.Chan, reflect.Map, reflect.Slice, reflect.String:
+		if v.Len() != length {
+			fail(t, "expected length %d, got %d", length, v.Len())
+		}
+	default:
+		fail(t, "cannot take length of %T", value)
+	}
+}
+func Contains(t testing.TB, container, element any, _ ...any) {
+	t.Helper()
+	if !contains(container, element) {
+		fail(t, "%#v does not contain %#v", container, element)
+	}
+}
+func NotContains(t testing.TB, container, element any, _ ...any) {
+	t.Helper()
+	if contains(container, element) {
+		fail(t, "%#v unexpectedly contains %#v", container, element)
+	}
+}
+func Less(t testing.TB, a, b any, _ ...any) {
+	t.Helper()
+	af, aok := asFloat(a)
+	bf, bok := asFloat(b)
+	if !aok || !bok || !(af < bf) {
+		fail(t, "expected %#v to be less than %#v", a, b)
+	}
+}
+
+func isNil(value any) bool {
+	if value == nil {
+		return true
+	}
+	v := reflect.ValueOf(value)
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return v.IsNil()
+	}
+	return false
+}
+
+func isEmpty(value any) bool {
+	if value == nil {
+		return true
+	}
+	v := reflect.ValueOf(value)
+	switch v.Kind() {
+	case reflect.Array, reflect.Map, reflect.Slice, reflect.String, reflect.Chan:
+		return v.Len() == 0
+	case reflect.Bool:
+		return !v.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return v.Int() == 0
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return v.Uint() == 0
+	case reflect.Float32, reflect.Float64:
+		return v.Float() == 0
+	case reflect.Interface, reflect.Ptr:
+		return v.IsNil()
+	}
+	return reflect.DeepEqual(value, reflect.Zero(v.Type()).Interface())
+}
+
+func contains(container, element any) bool {
+	if s, ok := container.(string); ok {
+		return strings.Contains(s, fmt.Sprint(element))
+	}
+	v := reflect.ValueOf(container)
+	if !v.IsValid() {
+		return false
+	}
+	switch v.Kind() {
+	case reflect.Map:
+		e := reflect.ValueOf(element)
+		if e.IsValid() && e.Type().AssignableTo(v.Type().Key()) {
+			return v.MapIndex(e).IsValid()
+		}
+		return false
+	case reflect.Array, reflect.Slice:
+		for i := 0; i < v.Len(); i++ {
+			if reflect.DeepEqual(v.Index(i).Interface(), element) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func asFloat(value any) (float64, bool) {
+	v := reflect.ValueOf(value)
+	if !v.IsValid() {
+		return 0, false
+	}
+	switch v.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return float64(v.Int()), true
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return float64(v.Uint()), true
+	case reflect.Float32, reflect.Float64:
+		return v.Float(), true
+	}
+	return 0, false
+}
