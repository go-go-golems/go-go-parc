index 0000000000000000000000000000000000000000..15b71fef0df7501694bb4875907e45abefe15985
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/adapter/fault_test.go
@@ -0,0 +1,94 @@
+package adapter
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/flow"
+)
+
+func TestLegacyUnknownAmbiguousRetryDuplicatesMutation(t *testing.T) {
+	mutations := 0
+	step := flow.Step[string, string]{
+		Name: "legacy-charge",
+		// EffectUnknown preserves backward compatibility but makes no safety claim.
+		Contract: flow.Contract{Effect: flow.EffectUnknown},
+		Policy: flow.Policy{Retry: flow.RetrySpec{
+			Attempts: 2, Backoff: flow.Backoff{Base: time.Nanosecond, Cap: time.Nanosecond},
+		}},
+		Do: func(_ context.Context, value string) (string, error) {
+			mutations++
+			if mutations == 1 {
+				return "", &flow.StatusError{Status: 503, Err: errors.New("response lost after charge")}
+			}
+			return value, nil
+		},
+	}
+	_, _, err := flow.Run(context.Background(), step, []string{"invoice-17"}, flow.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if mutations != 2 {
+		t.Fatalf("mutations=%d", mutations)
+	}
+}
+
+func TestDeclaredNonIdempotentAmbiguousRetryIsRejectedBeforeEffect(t *testing.T) {
+	mutations := 0
+	step := flow.Step[string, string]{
+		Name: "declared-charge", ID: effectlog.DefinitionID("p06.fixture.charge", "v1"),
+		Contract: flow.Contract{Effect: flow.EffectNonIdempotent},
+		Policy:   flow.Policy{Retry: flow.RetrySpec{Attempts: 2}},
+		Do: func(_ context.Context, value string) (string, error) {
+			mutations++
+			return value, nil
+		},
+	}
+	_, _, err := flow.Run(context.Background(), step, []string{"invoice-17"}, flow.Options{})
+	if err == nil || mutations != 0 {
+		t.Fatalf("err=%v mutations=%d", err, mutations)
+	}
+}
+
+func TestBulkPartialResponseFailsClosed(t *testing.T) {
+	base := PureIntStep("partial", "v1", 1, func(value int) int { return value })
+	step := flow.Bulk(base, func(_ context.Context, values []int) ([]int, error) {
+		return append([]int(nil), values[:len(values)-1]...), nil
+	}, 4)
+	_, report, err := flow.Run(context.Background(), step, []int{1, 2, 3, 4}, flow.Options{})
+	if err == nil || report.StopReason != flow.StopFailed {
+		t.Fatalf("err=%v report=%+v", err, report)
+	}
+	for _, operation := range report.Operations {
+		if operation.Status != flow.OperationFailed {
+			t.Fatalf("operation=%+v", operation)
+		}
+	}
+}
+
+func TestBudgetBoundaryMatrix(t *testing.T) {
+	const items = 5
+	for budget := 0; budget <= items; budget++ {
+		step := flow.Step[int, int]{
+			Name: "budget", ID: effectlog.DefinitionID("p06.fixture.budget", "v1"),
+			Contract: flow.Contract{Effect: flow.EffectPure},
+			Policy: flow.Policy{Workers: 1, Admission: []flow.Resource{{
+				Name: "calls", Ceiling: items, Budget: budget,
+			}}},
+			Do: func(_ context.Context, value int) (int, error) { return value, nil },
+		}
+		_, report, err := flow.Run(context.Background(), step, []int{0, 1, 2, 3, 4}, flow.Options{})
+		if budget == items {
+			if err != nil || report.Status != flow.StatusCompleted {
+				t.Fatalf("budget=%d err=%v report=%+v", budget, err, report)
+			}
+			continue
+		}
+		if err == nil || report.StopReason != flow.StopBudgetExhausted {
+			t.Fatalf("budget=%d err=%v report=%+v", budget, err, report)
+		}
+	}
+}
diff --git a/research/p06-flow-executor-semantics-effects/api.md b/research/p06-flow-executor-semantics-effects/api.md
new file mode 100644
index 0000000000000000000000000000000000000000..7eebe622fcee112f799deda1e2358e976a7b8831
--- /dev/null
+++ b/research/p06-flow-executor-semantics-effects/api.md
@@ -0,0 +1,134 @@
+# P06 public API guide
+
+## 1. Declare what a step is allowed to do
+
+```go
+step := flow.Step[Request, Response]{
+    Name: "retrieve", // presentation only
+    ID:   effectlog.DefinitionID("rag.retrieve", "v2"),
+    Contract: flow.Contract{
+        Effect:      flow.EffectReadOnly,
+        Locality:    flow.ItemLocal,
+        Description: "read-only index query",
+    },
+    Policy: flow.Policy{
+        Workers: 8,
+        Retry: flow.RetrySpec{Attempts: 3},
+    },
+    Do: retrieve,
+}
+```
+
+`EffectReadOnly` permits retry because the declared operation does not mutate the external world. `EffectNonIdempotent` with more than one attempt is rejected before item one.
+
+## 2. Capture external observations for offline replay
+
+```go
+step.Capture = flow.JSONCapture[Request, Response](
+    func(request Request) (string, error) {
+        return request.SemanticFingerprint(), nil
+    },
+)
+
+recorder, _ := effectlog.New(effectlog.Options{
+    Mode: effectlog.ModeCapture,
+})
+
+outputs, report, err := flow.Run(ctx, step, inputs, flow.Options{
+    Effects: recorder,
+})
+
+effectlog.WriteSnapshot("effects.json", recorder.Snapshot())
+```
+
+Replay performs no live call:
+
+```go
+snapshot, _ := effectlog.ReadSnapshot("effects.json")
+replay, _ := effectlog.NewFromSnapshot(snapshot, effectlog.Options{
+    Mode: effectlog.ModeReplay,
+})
+
+outputs, report, err = flow.Run(ctx, step, inputs, flow.Options{
+    Effects: replay,
+})
+```
+
+Replay identity is `(StepID, semantic request key, attempt number)`. Run, stage, operation, attempt trace IDs, timestamps, and worker scheduling do not change replay lookup. The recorder verifies that the supplied payload exactly matches the captured payload; reusing an incomplete semantic key for different request bytes fails closed.
+
+## 3. Distinguish cache from capture
+
+```go
+flow.Options{
+    Store:   durableResultStore, // final admitted output
+    Effects: attemptRecorder,    // raw attempt outcomes
+}
+```
+
+The cache answers, "Can this logical result be reused?" Capture answers, "What did each attempted external call observe?" A cache hit has no provider attempt. A captured transient failure may be replayed so the same retry path is exercised offline.
+
+## 4. Use collection-global operations explicitly
+
+```go
+topOne := flow.Snapshot(flow.SnapshotSpec[Candidate, bool]{
+    Name: "global-top-one",
+    ID:   effectlog.DefinitionID("rag.global-top-one", "v1"),
+    Contract: flow.Contract{Effect: flow.EffectPure},
+    DoAll: func(ctx context.Context, items []Candidate) ([]bool, error) {
+        // Return one aligned membership value per input.
+    },
+})
+```
+
+`Step.Barrier = true` only waits until upstream has completed. It does not pass the complete collection to `Do`. Use `Snapshot` for top-k, global normalization, cross-item deduplication, or diversification.
+
+## 5. Inspect non-conflating reports
+
+```go
+for _, stage := range report.Stages {
+    fmt.Println(stage.StageID, stage.StepID, stage.Name, stage.Counts)
+}
+for _, operation := range report.Operations {
+    fmt.Println(operation.OperationID, operation.Indexes, operation.Status)
+    for _, attempt := range operation.Attempts {
+        fmt.Println(attempt.AttemptID, attempt.Number, attempt.Replayed)
+    }
+}
+
+if err := report.Validate(); err != nil {
+    return err
+}
+```
+
+`report.Steps[name]` remains as a compatibility projection and aggregates repeated stages by display name. It is intentionally lossy. New consumers should use `Stages` and `Operations`.
+
+## 6. Compare policy variants semantically
+
+```go
+assessment, err := flowtest.Compare(ctx, flowtest.Case[int, int]{
+    Name: "sequential-vs-parallel",
+    Inputs: inputs,
+    Baseline: func(ctx context.Context, in []int) ([]flow.Result[int], flow.Report, error) {
+        return flow.Run(ctx, sequential, in, flow.Options{})
+    },
+    Variants: []flowtest.Variant[int, int]{
+        {Name: "parallel", Run: func(ctx context.Context, in []int) ([]flow.Result[int], flow.Report, error) {
+            return flow.Run(ctx, parallel, in, flow.Options{})
+        }},
+    },
+})
+```
+
+The default projection compares aligned values, quarantine records, skip state, and terminal errors. It intentionally ignores timestamps, retry counts, cache outcomes, trace IDs, and other operational history.
+
+## 7. Batch only with an explicit mapping contract
+
+```go
+batched := flow.Bulk(base, func(ctx context.Context, in []Item) ([]Vector, error) {
+    out, err := provider.Embed(ctx, in)
+    // Required: len(out) == len(in), and out[i] belongs to in[i].
+    return out, err
+}, 64)
+```
+
+The runtime detects response length mismatch. It cannot detect a same-length permutation when output values carry no input identity. Provider adapters should validate returned request/item IDs where possible, and the conformance harness should compare batched execution to per-item execution.
