+func TestReportV2SeparatesRepeatedDisplayNames(t *testing.T) {
+	first := Step[int, int]{
+		Name: "transform", ID: effectlog.DefinitionID("fixture.increment", "v1"),
+		Contract: Contract{Effect: EffectPure},
+		Do:       func(_ context.Context, value int) (int, error) { return value + 1, nil },
+	}
+	second := Step[int, int]{
+		Name: "transform", ID: effectlog.DefinitionID("fixture.double", "v1"),
+		Contract: Contract{Effect: EffectPure},
+		Do:       func(_ context.Context, value int) (int, error) { return value * 2, nil },
+	}
+	results, report, err := Run(context.Background(), Pipe2(first, second), []int{1, 2}, Options{
+		Trace: TraceOptions{RunID: "fixed-run", Clock: fixedTestClock()},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := []int{results[0].Value, results[1].Value}; !reflect.DeepEqual(got, []int{4, 6}) {
+		t.Fatalf("outputs=%v", got)
+	}
+	if len(report.Stages) != 2 {
+		t.Fatalf("stages=%d report=%+v", len(report.Stages), report)
+	}
+	if report.Stages[0].Name != "transform" || report.Stages[1].Name != "transform" {
+		t.Fatalf("names=%q,%q", report.Stages[0].Name, report.Stages[1].Name)
+	}
+	if report.Stages[0].StageID == report.Stages[1].StageID || report.Stages[0].StepID == report.Stages[1].StepID {
+		t.Fatal("stage or definition identity conflated")
+	}
+	if report.Stages[0].Counts.Items != 2 || report.Stages[1].Counts.Items != 2 {
+		t.Fatalf("stage counts=%+v", report.Stages)
+	}
+	// The compatibility view is intentionally lossy and therefore aggregates.
+	if report.Step("transform").Items != 4 {
+		t.Fatalf("legacy aggregate=%+v", report.Step("transform"))
+	}
+}
