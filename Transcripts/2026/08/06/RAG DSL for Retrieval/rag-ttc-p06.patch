+			tracker.status(operation, OperationCacheHit, execution.CacheHit, Fatal, nil)
+			outcome := execution.CacheOutcome{KeyDigest: semanticKey, State: execution.CacheHit}
+			results := make([]Result[O], len(loaded))
+			for index, value := range loaded {
+				results[index] = Result[O]{Value: value, Cache: outcome}
+				if spec.OnResult != nil {
+					if err := spec.OnResult(ctx, index, value, outcome); err != nil {
+						return fail(fmt.Errorf("snapshot step %q item %d: result hook: %w", spec.Name, index, err))
+					}
+				}
+			}
+			if err := emitScopedEvent(ctx, options, scope, Event{
+				Index: -1, Type: EventHit, OperationID: operation,
+				BatchID: batchID, SemanticKey: semanticKey, Cache: execution.CacheHit,
+			}); err != nil {
+				return fail(err)
+			}
+			return results, report(), nil
+		}
+		counts.Misses = len(items)
+		if err := emitScopedEvent(ctx, options, scope, Event{
+			Index: -1, Type: EventCacheMiss, OperationID: operation,
+			BatchID: batchID, SemanticKey: semanticKey,
+		}); err != nil {
+			return fail(err)
+		}
+	}
+
+	for _, resource := range spec.Policy.Admission {
+		if err := options.env.limiter(resource.Name).Wait(ctx, 1); err != nil {
+			status := OperationFailed
+			eventType := EventAttemptFailed
+			if errors.Is(err, execution.ErrBudgetExceeded) {
+				status = OperationBudgetRefused
+				eventType = EventBudgetRefused
+			}
+			tracker.status(operation, status, "", Fatal, err)
+			_ = emitScopedEvent(ctx, options, scope, Event{
+				Index: -1, Type: eventType, OperationID: operation, BatchID: batchID,
+				SemanticKey: semanticKey, Class: Fatal.String(), Error: err.Error(),
+			})
+			return fail(fmt.Errorf("snapshot step %q: wait for resource %q: %w", spec.Name, resource.Name, err))
+		}
+	}
+
+	classifier := spec.Policy.Retry.Class
+	if classifier == nil {
+		classifier = DefaultClassifier
+	}
+	attempts := spec.Policy.Retry.Attempts
+	if attempts < 1 {
+		attempts = 1
+	}
+	backoff := spec.Policy.Retry.Backoff.withDefaults()
+	delay := backoff.Base
+	var lastErr error
+	lastClass := Fatal
+	var lastInvocation Invocation
+	for attempt := 1; attempt <= attempts; attempt++ {
+		if attempt > 1 {
+			jittered := delay + time.Duration(rand.Int63n(int64(delay)/2+1))
+			select {
+			case <-ctx.Done():
+				tracker.status(operation, OperationFailed, "", Fatal, ctx.Err())
+				return fail(ctx.Err())
+			case <-time.After(jittered):
+			}
+			delay *= 2
+			if delay > backoff.Cap {
+				delay = backoff.Cap
+			}
+		}
+		invocation := tracker.beginAttempt(operation, attempt, -1, semanticKey, batchID)
+		lastInvocation = invocation
+		if err := emitScopedEvent(ctx, options, scope, Event{
+			Index: -1, Type: EventAttemptStarted, OperationID: operation,
+			AttemptID: invocation.Attempt, Attempt: attempt, BatchID: batchID,
+			SemanticKey: semanticKey,
+		}); err != nil {
+			return fail(err)
+		}
+		call := invokeSnapshot(ctx, spec, classifier, items, invocation, options)
+		if call.live {
+			counts.WorkCalls++
+		} else if call.replayed {
+			counts.Replayed++
+		}
+		tracker.finishAttempt(operation, attempt, call.class, call.err, call.replayed, call.captureKey)
+		if call.err == nil {
+			if len(call.value) != len(items) {
+				err := fmt.Errorf("snapshot step %q returned %d results for %d inputs", spec.Name, len(call.value), len(items))
+				tracker.status(operation, OperationFailed, "", Fatal, err)
+				return fail(err)
+			}
+			if call.live && spec.Meter != nil {
+				counts.Meters = Meters{}
+				counts.Meters.Add(spec.Meter(call.value))
+			}
+			cacheState := execution.CacheState("")
+			if cached {
+				if err := options.Store.Store(context.WithoutCancel(ctx), *key, call.value); err != nil {
+					tracker.status(operation, OperationFailed, "", Fatal, err)
+					return fail(fmt.Errorf("snapshot step %q: store cache entry: %w", spec.Name, err))
+				}
+				counts.Stored++
+				cacheState = execution.CacheStored
+			}
+			tracker.status(operation, OperationSucceeded, cacheState, Fatal, nil)
+			outcome := execution.CacheOutcome{KeyDigest: semanticKey, State: cacheState}
+			results := make([]Result[O], len(call.value))
+			for index, value := range call.value {
+				results[index] = Result[O]{Value: value, Cache: outcome}
+				if spec.OnResult != nil {
+					if err := spec.OnResult(ctx, index, value, outcome); err != nil {
+						return fail(fmt.Errorf("snapshot step %q item %d: result hook: %w", spec.Name, index, err))
+					}
+				}
+			}
+			eventType := EventDone
+			if cached {
+				eventType = EventStored
+			}
+			if err := emitScopedEvent(ctx, options, scope, Event{
+				Index: -1, Type: eventType, OperationID: operation,
+				AttemptID: invocation.Attempt, Attempt: attempt, BatchID: batchID,
+				SemanticKey: semanticKey, Cache: cacheState, Replayed: call.replayed,
+			}); err != nil {
+				return fail(err)
+			}
+			return results, report(), nil
+		}
+		lastErr, lastClass = call.err, call.class
+		if err := emitScopedEvent(ctx, options, scope, Event{
+			Index: -1, Type: EventAttemptFailed, OperationID: operation,
+			AttemptID: invocation.Attempt, Attempt: attempt, BatchID: batchID,
+			SemanticKey: semanticKey, Class: call.class.String(), Error: call.err.Error(),
+			Replayed: call.replayed,
+		}); err != nil {
+			return fail(err)
+		}
+		if call.class == Transient && attempt < attempts {
+			counts.Retries++
+			if counts.RetriesByClass == nil {
+				counts.RetriesByClass = map[string]int{}
+			}
+			counts.RetriesByClass[call.class.String()]++
+			continue
+		}
+		break
+	}
+
+	mode := spec.Policy.OnError
+	if lastClass == Fatal || mode == FailFast {
+		tracker.status(operation, OperationFailed, "", lastClass, lastErr)
+		return fail(fmt.Errorf("snapshot step %q [%s]: %w", spec.Name, lastClass, lastErr))
+	}
+	results := make([]Result[O], len(items))
+	status := OperationQuarantined
+	eventType := EventQuarantined
+	if mode == Skip {
+		status = OperationSkipped
+		eventType = EventSkipped
+		counts.Skipped = len(items)
+		for index := range results {
+			results[index].Skipped = true
+		}
+	} else {
+		counts.Quarantined = len(items)
+		for index := range results {
+			results[index].Quarantined = &ItemError{
+				Step: spec.Name, Index: index, Class: lastClass,
+				Attempts: lastInvocation.AttemptNumber, Message: lastErr.Error(),
+			}
+		}
+	}
+	tracker.status(operation, status, "", lastClass, lastErr)
+	if err := emitScopedEvent(ctx, options, scope, Event{
+		Index: -1, Type: eventType, OperationID: operation,
+		AttemptID: lastInvocation.Attempt, Attempt: lastInvocation.AttemptNumber,
+		BatchID: batchID, SemanticKey: semanticKey,
+		Class: lastClass.String(), Error: lastErr.Error(),
+	}); err != nil {
+		return fail(err)
+	}
+	return results, report(), nil
+}
+
+func invokeSnapshot[I, O any](ctx context.Context, spec SnapshotSpec[I, O], classifier Classifier, items []I, invocation Invocation, options Options) invocationResult[[]O] {
+	callContext := withInvocation(ctx, invocation)
+	if spec.Capture == nil || options.Effects == nil {
+		value, err := spec.DoAll(callContext, items)
+		class := Fatal
+		if err != nil {
+			class = classifier.Classify(err)
+		}
+		return invocationResult[[]O]{value: value, err: err, class: class, live: true}
+	}
+	payload, err := spec.Capture.encodeRequest(items)
+	if err != nil {
+		return invocationResult[[]O]{err: err, class: Fatal}
+	}
+	request := effectlog.Request{
+		Run: invocation.Run, Step: invocation.Step, Stage: invocation.Stage,
+		Operation: invocation.Operation, Attempt: invocation.Attempt, Batch: invocation.Batch,
+		AttemptNumber: invocation.AttemptNumber, SemanticKey: invocation.SemanticKey,
+		Payload: payload,
+	}
+	var codecErr error
+	result, err := options.Effects.Execute(callContext, request, func(liveContext context.Context) effectlog.Outcome {
+		values, callErr := spec.DoAll(liveContext, items)
+		if callErr != nil {
+			class := classifier.Classify(callErr)
+			return effectlog.Outcome{ErrorClass: class.String(), ErrorMessage: callErr.Error()}
+		}
+		response, encodeErr := spec.Capture.encodeResponse(values)
+		if encodeErr != nil {
+			codecErr = encodeErr
+			return effectlog.Outcome{ErrorClass: Fatal.String(), ErrorMessage: encodeErr.Error()}
+		}
+		return effectlog.Outcome{Response: response}
+	})
+	if err != nil {
+		return invocationResult[[]O]{err: err, class: Fatal}
+	}
+	if codecErr != nil {
+		return invocationResult[[]O]{err: codecErr, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+	}
+	if result.Outcome.ErrorMessage != "" {
+		class, parseErr := parseErrorClass(result.Outcome.ErrorClass)
+		if parseErr != nil {
+			return invocationResult[[]O]{err: parseErr, class: Fatal, replayed: result.Replayed, captureKey: result.CaptureKey}
+		}
+		return invocationResult[[]O]{
+			err: errors.New(result.Outcome.ErrorMessage), class: class,
+			live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey,
+		}
+	}
+	values, decodeErr := spec.Capture.decodeResponse(result.Outcome.Response)
+	if decodeErr != nil {
+		return invocationResult[[]O]{err: decodeErr, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+	}
+	return invocationResult[[]O]{value: values, class: Fatal, live: !result.Replayed, replayed: result.Replayed, captureKey: result.CaptureKey}
+}
+
+func resourceNames(resources []Resource) []string {
+	names := make([]string, 0, len(resources))
+	for _, resource := range resources {
+		names = append(names, resource.Name)
+	}
+	return names
+}
