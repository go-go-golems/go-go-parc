+package flow
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/rand"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/effectlog"
+	"github.com/the-tree-center/rag-ttc/pkg/execution"
+)
+
+// SnapshotSpec defines a true collection-level operation. Unlike Step.Barrier,
+// DoAll receives the complete clean input snapshot and must return one output
+// per input position. Global normalization, global reranking scores, and top-k
+// membership masks belong here.
+type SnapshotSpec[I, O any] struct {
+	Name     string
+	ID       StepID
+	Identity Identity[[]I]
+	Contract Contract
+	Policy   Policy
+	Capture  *CaptureSpec[[]I, []O]
+	DoAll    func(context.Context, []I) ([]O, error)
+	Meter    func([]O) Meters
+	OnResult func(context.Context, int, O, execution.CacheOutcome) error
+}
+
+// Snapshot creates an item-aligned step whose function observes the complete
+// collection. Cardinality-changing selection should be represented as an
+// aligned membership/view record, then compacted outside flow.Run.
+func Snapshot[I, O any](spec SnapshotSpec[I, O]) Step[I, O] {
+	contract := spec.Contract
+	contract.Locality = SnapshotGlobal
+	id := spec.ID
+	if id == "" && spec.Identity.Kind != "" && spec.Identity.Version != "" {
+		id = effectlog.DefinitionID(spec.Identity.Kind, spec.Identity.Version)
+	}
+	step := Step[I, O]{
+		Name: spec.Name, ID: id, Contract: contract, Policy: spec.Policy,
+		snapshot: true,
+	}
+	step.captureReady = func(options Options) bool {
+		return spec.Capture != nil && options.Effects != nil
+	}
+	step.override = func(ctx context.Context, items []I, options Options) ([]Result[O], Report, error) {
+		return runSnapshot(ctx, spec, contract, items, options)
+	}
+	return step
+}
+
+func runSnapshot[I, O any](ctx context.Context, spec SnapshotSpec[I, O], contract Contract, items []I, options Options) ([]Result[O], Report, error) {
+	if options.scope == nil {
+		return nil, Report{}, fmt.Errorf("snapshot step %q has no stage trace scope", spec.Name)
+	}
+	scope := *options.scope
+	counts := StepReport{Items: len(items)}
+	tracker := newOperationTracker(scope, options.env)
+	report := func() Report {
+		counts.Spend = options.env.snapshot(resourceNames(spec.Policy.Admission))
+		return stageReport(scope, cloneStepReport(counts), tracker.snapshot())
+	}
+	fail := func(err error) ([]Result[O], Report, error) { return nil, report(), err }
+	if spec.Name == "" {
+		return fail(fmt.Errorf("every snapshot step needs a name"))
+	}
+	if spec.DoAll == nil {
+		return fail(fmt.Errorf("snapshot step %q needs DoAll", spec.Name))
+	}
+	captured := spec.Capture != nil && options.Effects != nil
+	if err := contract.validate(spec.Policy, captured, true); err != nil {
+		return fail(fmt.Errorf("snapshot step %q contract: %w", spec.Name, err))
+	}
+	if len(items) == 0 {
+		return []Result[O]{}, report(), nil
+	}
+
+	indexes := make([]int, len(items))
+	for index := range items {
+		indexes[index] = index
