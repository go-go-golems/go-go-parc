+package geppetto
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestProviderConfigurationFingerprintSensitivityAndSecretRedaction(t *testing.T) {
+	base := map[string]any{
+		"chat":  map[string]any{"engine": "model-a", "temperature": 0.1, "api_keys": map[string]any{"openai": "TOP-SECRET"}},
+		"retry": map[string]any{"attempts": 3},
+	}
+	first, err := providerConfigurationFingerprint("generation", "openai", "model-a", base)
+	require.NoError(t, err)
+	require.NotContains(t, first, "TOP-SECRET")
+
+	changed := map[string]any{
+		"chat":  map[string]any{"engine": "model-a", "temperature": 0.2, "api_keys": map[string]any{"openai": "TOP-SECRET"}},
+		"retry": map[string]any{"attempts": 3},
+	}
+	second, err := providerConfigurationFingerprint("generation", "openai", "model-a", changed)
+	require.NoError(t, err)
+	require.NotEqual(t, first, second)
+
+	rotated := map[string]any{
+		"chat":  map[string]any{"engine": "model-a", "temperature": 0.1, "api_keys": map[string]any{"openai": "ROTATED-SECRET"}},
+		"retry": map[string]any{"attempts": 3},
+	}
+	third, err := providerConfigurationFingerprint("generation", "openai", "model-a", rotated)
+	require.NoError(t, err)
+	require.Equal(t, first, third)
+
+	projection := redactConfiguration(base)
+	require.NotContains(t, strings.TrimSpace(toJSON(t, projection)), "TOP-SECRET")
+}
+
+func toJSON(t testing.TB, value any) string {
+	t.Helper()
+	b, err := json.Marshal(value)
+	require.NoError(t, err)
+	return string(b)
+}
