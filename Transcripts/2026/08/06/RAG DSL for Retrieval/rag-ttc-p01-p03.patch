--- a/pkg/rag/providers/geppetto/fingerprint.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/providers/geppetto/fingerprint.go	2026-08-05 19:22:49.270602282 +0000
@@ -0,0 +1,95 @@
+package geppetto
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"unicode"
+
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+)
+
+// providerConfigurationFingerprint hashes the resolved, non-secret provider
+// configuration. The projection is intentionally conservative: every
+// serializable non-secret field participates, while credential-bearing fields
+// retain only a redacted presence marker. This may invalidate more cache data
+// than a hand-minimal key, but it cannot expose raw credentials.
+func providerConfigurationFingerprint(role, provider, model string, settings any) (string, error) {
+	raw, err := json.Marshal(settings)
+	if err != nil {
+		return "", fmt.Errorf("marshal provider settings: %w", err)
+	}
+	var value any
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return "", fmt.Errorf("decode provider settings projection: %w", err)
+	}
+	projected := redactConfiguration(value)
+	canonical, err := json.Marshal(projected)
+	if err != nil {
+		return "", fmt.Errorf("encode provider settings projection: %w", err)
+	}
+	fingerprint, err := semanticid.FingerprintValue("rag.provider.configuration", "v1", semanticid.MustObject(
+		semanticid.Field{Name: "role", Value: semanticid.MustString(strings.TrimSpace(role))},
+		semanticid.Field{Name: "provider", Value: semanticid.MustString(strings.TrimSpace(provider))},
+		semanticid.Field{Name: "model", Value: semanticid.MustString(strings.TrimSpace(model))},
+		semanticid.Field{Name: "settings_projection", Value: semanticid.Bytes(canonical)},
+	))
+	if err != nil {
+		return "", fmt.Errorf("fingerprint provider settings: %w", err)
+	}
+	return fingerprint.String(), nil
+}
+
+func redactConfiguration(value any) any {
+	switch x := value.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for key, child := range x {
+			if secretConfigurationKey(key) {
+				out[key] = map[string]any{"redacted": true, "present": configurationPresent(child)}
+				continue
+			}
+			out[key] = redactConfiguration(child)
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, child := range x {
+			out[i] = redactConfiguration(child)
+		}
+		return out
+	default:
+		return value
+	}
+}
+
+func secretConfigurationKey(key string) bool {
+	var b strings.Builder
+	for _, r := range strings.ToLower(key) {
+		if unicode.IsLetter(r) || unicode.IsDigit(r) {
+			b.WriteRune(r)
+		}
+	}
+	normalized := b.String()
+	for _, marker := range []string{"apikey", "authorization", "credential", "password", "secret", "accesstoken", "refreshtoken", "bearertoken", "headers"} {
+		if strings.Contains(normalized, marker) {
+			return true
+		}
+	}
+	return false
+}
+
+func configurationPresent(value any) bool {
+	switch x := value.(type) {
+	case nil:
+		return false
+	case string:
+		return strings.TrimSpace(x) != ""
+	case []any:
+		return len(x) > 0
+	case map[string]any:
+		return len(x) > 0
+	default:
+		return true
+	}
+}
