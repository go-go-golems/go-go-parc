+package derive
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestFactIdentityUsesCanonicalContent(t *testing.T) {
+	t.Parallel()
+	a, err := NewFactFromJSON("claim", "v1", []byte(`{"b":1.0,"a":"x"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := NewFactFromJSON("claim", "v1", []byte(`{"a":"x","b":1e0}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.ID != b.ID {
+		t.Fatalf("equivalent JSON changed identity: %s != %s", a.ID, b.ID)
+	}
+	c, err := NewFactFromJSON("claim", "v1", []byte(`{"a":"x","b":2}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.ID == c.ID {
+		t.Fatal("semantic payload mutation did not change identity")
+	}
+}
+
+func TestObservationsDoNotAlterFactIdentity(t *testing.T) {
+	t.Parallel()
+	f, err := NewFact("chunk", "v1", map[string]any{"text": "same source"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	o1, err := NewObservation("score", "v1", f.ID, "q1", map[string]any{"score": .1, "rank": 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	o2, err := NewObservation("score", "v1", f.ID, "q2", map[string]any{"score": .99, "rank": 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if o1.ID == o2.ID {
+		t.Fatal("different observations should have different observation IDs")
+	}
+	if o1.Subject != f.ID || o2.Subject != f.ID {
+		t.Fatal("observations changed their fact subject")
+	}
+	got, err := recomputeFactID(f)
+	if err != nil || got != f.ID {
+		t.Fatalf("fact identity changed: %v %s", err, got)
+	}
+}
+
+func TestDiamondProvenanceAndProofBundle(t *testing.T) {
+	t.Parallel()
+	x := makeDiamond(t)
+	report := Verify(x.State)
+	if !report.Valid {
+		t.Fatalf("diamond should verify: %+v", report.Issues)
+	}
+	if report.Ranks[x.SourceA.ID] != 0 || report.Ranks[x.SourceB.ID] != 0 {
+		t.Fatalf("seed ranks: %+v", report.Ranks)
+	}
+	if report.Ranks[x.Claim.ID] != 1 {
+		t.Fatalf("claim rank=%d, want 1", report.Ranks[x.Claim.ID])
+	}
+	bundle, err := BuildProofBundle(x.State, []FactID{x.Claim.ID}, "corpus-2026-08", "pipeline-v1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(bundle.State.Derivations) != 4 {
+		t.Fatalf("bundle derivations=%d, want 4", len(bundle.State.Derivations))
+	}
+	proofs := 0
+	for _, d := range bundle.State.Derivations {
+		if d.Output == x.Claim.ID {
+			proofs++
+		}
+	}
+	if proofs != 2 {
+		t.Fatalf("claim proofs=%d, want 2", proofs)
+	}
+	if r := VerifyProofBundle(bundle); !r.Valid {
+		t.Fatalf("proof bundle invalid: %+v", r.Issues)
+	}
+}
+
+func TestVerificationRejectsTamperingAndMissingDependencies(t *testing.T) {
+	t.Parallel()
+	x := makeDiamond(t)
+	snap := x.State.Snapshot()
+	for i := range snap.Facts {
+		if snap.Facts[i].ID == x.SourceA.ID {
+			snap.Facts[i].Payload = json.RawMessage(`{"document":"tampered","text":"wrong"}`)
+		}
+	}
+	tampered, err := FromSnapshot(snap)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r := Verify(tampered); r.Valid {
+		t.Fatal("tampered fact unexpectedly verified")
+	}
+
+	snap = x.State.Snapshot()
+	kept := snap.Facts[:0]
+	for _, f := range snap.Facts {
+		if f.ID != x.SourceB.ID {
+			kept = append(kept, f)
+		}
+	}
+	snap.Facts = kept
+	missing, err := FromSnapshot(snap)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := Verify(missing)
+	if r.Valid {
+		t.Fatal("missing dependency unexpectedly verified")
+	}
+	found := false
+	for _, issue := range r.Issues {
+		if issue.Code == "derivation-input-missing" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("missing dependency issue absent: %+v", r.Issues)
+	}
+}
+
+func TestDerivationInputOrderIsCanonical(t *testing.T) {
+	t.Parallel()
+	makeFact := func(kind, schema string, payload any) Fact {
+		f, err := NewFact(kind, schema, payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return f
+	}
+	a := makeFact("source", "v1", map[string]any{"name": "a"})
+	b := makeFact("source", "v1", map[string]any{"name": "b"})
+	out := makeFact("claim", "v1", map[string]any{"value": "combined"})
+	left, err := NewDerivation(out.ID, "combine", "v1", []Input{{Role: "right", Fact: b.ID}, {Role: "left", Fact: a.ID}}, "q", "cfg", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	right, err := NewDerivation(out.ID, "combine", "v1", []Input{{Role: "left", Fact: a.ID}, {Role: "right", Fact: b.ID}}, "q", "cfg", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if left.ID != right.ID {
+		t.Fatalf("premise delivery order changed derivation identity: %s != %s", left.ID, right.ID)
+	}
+	if len(left.Inputs) != 2 || left.Inputs[0].Role != "left" || left.Inputs[1].Role != "right" {
+		t.Fatalf("constructor did not retain canonical premise order: %#v", left.Inputs)
+	}
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/knowledgecodec/codec.go b/pkg/rag/derive/knowledgecodec/codec.go
--- a/pkg/rag/derive/knowledgecodec/codec.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/knowledgecodec/codec.go	2026-08-05 19:21:04.812059454 +0000
@@ -0,0 +1,69 @@
+// Package knowledgecodec adapts the current knowledge database records to the
+// canonical provenance kernel. Stable claim content becomes a fact; extraction
+// method, confidence, status, source spans, and legacy IDs remain derivation or
+// observation records.
+package knowledgecodec
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive"
+	"github.com/the-tree-center/rag-ttc/pkg/rag/knowledge"
+)
+
+// Fact converts a knowledge.Fact. chunkFacts maps legacy chunk IDs to canonical
+// source fact IDs and makes missing lineage an explicit error.
+func Fact(value knowledge.Fact, chunkFacts map[string]derive.FactID, requestID, configID string) (derive.Fact, derive.Derivation, derive.Observation, error) {
+	fact, err := derive.NewFact("claim", "rag.knowledge.fact/v1", map[string]any{
+		"subject_id":        value.SubjectID,
+		"predicate":         value.Predicate,
+		"object_concept_id": value.ObjectConceptID,
+		"object_text":       value.ObjectText,
+		"value_number":      value.ValueNumber,
+		"unit":              value.Unit,
+		"qualifiers":        value.Qualifiers,
+	})
+	if err != nil {
+		return derive.Fact{}, derive.Derivation{}, derive.Observation{}, err
+	}
+	type source struct {
+		legacy string
+		fact   derive.FactID
+	}
+	seen := map[derive.FactID]bool{}
+	var sources []source
+	for _, span := range value.Evidence {
+		id := chunkFacts[span.ChunkID]
+		if id == "" {
+			return derive.Fact{}, derive.Derivation{}, derive.Observation{}, fmt.Errorf("knowledge fact %q references unmapped chunk %q", value.ID, span.ChunkID)
+		}
+		if !seen[id] {
+			seen[id] = true
+			sources = append(sources, source{span.ChunkID, id})
+		}
+	}
+	sort.Slice(sources, func(i, j int) bool {
+		if sources[i].legacy != sources[j].legacy {
+			return sources[i].legacy < sources[j].legacy
+		}
+		return sources[i].fact < sources[j].fact
+	})
+	inputs := make([]derive.Input, len(sources))
+	for i, src := range sources {
+		inputs[i] = derive.Input{Role: "evidence", Fact: src.fact}
+	}
+	proof, err := derive.NewDerivation(fact.ID, "knowledge-extraction", "v1", inputs, requestID, configID, map[string]any{
+		"legacy_fact_id": value.ID,
+		"status":         value.Status,
+		"method":         value.Method,
+		"evidence":       value.Evidence,
+	})
+	if err != nil {
+		return derive.Fact{}, derive.Derivation{}, derive.Observation{}, err
+	}
+	observation, err := derive.NewObservation("extraction-confidence", "rag.knowledge.confidence/v1", fact.ID, requestID, map[string]any{
+		"method": value.Method, "status": value.Status, "confidence": value.Confidence,
+	})
+	return fact, proof, observation, err
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/merge_test.go b/pkg/rag/derive/merge_test.go
--- a/pkg/rag/derive/merge_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/merge_test.go	2026-08-05 19:15:33.086175232 +0000
@@ -0,0 +1,191 @@
+package derive
+
+import (
+	"math/rand"
+	"sync"
+	"testing"
+)
+
+func TestJoinLawsAndAllDeliveryOrders(t *testing.T) {
+	x := makeDiamond(t)
+	parts := []State{}
+	for _, f := range []Fact{x.SourceA, x.SourceB, x.Claim} {
+		s, err := NewState().WithFact(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		parts = append(parts, s)
+	}
+	proofs := NewState()
+	var err error
+	for _, d := range []Derivation{x.SeedA, x.SeedB, x.Extract, x.Resolve} {
+		proofs, err = proofs.WithDerivation(d)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	obs := NewState()
+	for _, o := range []Observation{x.ScoreA, x.ScoreB} {
+		obs, err = obs.WithObservation(o)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	parts = append(parts, proofs, obs)
+
+	a, b, c := parts[0], parts[1], parts[2]
+	if !Join(a, b).Equal(Join(b, a)) {
+		t.Fatal("commutativity failed")
+	}
+	if !Join(Join(a, b), c).Equal(Join(a, Join(b, c))) {
+		t.Fatal("associativity failed")
+	}
+	if !Join(a, a).Equal(a) {
+		t.Fatal("idempotence failed")
+	}
+	if !Join(a, NewState()).Equal(a) || !Join(NewState(), a).Equal(a) {
+		t.Fatal("identity failed")
+	}
+
+	want := NewState()
+	for _, p := range parts {
+		want = Join(want, p)
+	}
+	for i, order := range allPermutations(parts) {
+		got := NewState()
+		for _, p := range order {
+			got = Join(got, p)
+		}
+		if !got.Equal(want) {
+			t.Fatalf("permutation %d diverged\nwant=%s\ngot=%s", i, describeState(want), describeState(got))
+		}
+	}
+}
+
+func TestJoinGeneratedLaws(t *testing.T) {
+	rng := rand.New(rand.NewSource(20260805))
+	for trial := 0; trial < 500; trial++ {
+		states := make([]State, 3)
+		for i := range states {
+			s := NewState()
+			for j := 0; j < rng.Intn(7); j++ {
+				f, err := NewFact("generated", "v1", map[string]any{"key": rng.Intn(5), "value": rng.Intn(9)})
+				if err != nil {
+					t.Fatal(err)
+				}
+				s, err = s.WithFact(f)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			states[i] = s
+		}
+		a, b, c := states[0], states[1], states[2]
+		if !Join(a, b).Equal(Join(b, a)) {
+			t.Fatalf("trial %d commutativity", trial)
+		}
+		if !Join(Join(a, b), c).Equal(Join(a, Join(b, c))) {
+			t.Fatalf("trial %d associativity", trial)
+		}
+		if !Join(a, a).Equal(a) {
+			t.Fatalf("trial %d idempotence", trial)
+		}
+		if !Join(a, NewState()).Equal(a) {
+			t.Fatalf("trial %d identity", trial)
+		}
+	}
+}
+
+func TestIdentityConflictRetainsAllVariantsAndIsRetrySafe(t *testing.T) {
+	f, err := NewFact("claim", "v1", map[string]any{"value": "A"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bad := f
+	bad.Payload = []byte(`{"value":"B"}`) // Deliberately keeps the original ID.
+	a := singletonFactState(t, f)
+	b := singletonFactState(t, bad)
+	ab, ba := Join(a, b), Join(b, a)
+	if !ab.Equal(ba) {
+		t.Fatal("conflict result depends on arrival order")
+	}
+	if len(ab.FactVariants(f.ID)) != 2 {
+		t.Fatalf("variants=%d, want 2", len(ab.FactVariants(f.ID)))
+	}
+	if _, ok := ab.Fact(f.ID); ok {
+		t.Fatal("conflicted ID should not resolve as unique")
+	}
+	if len(ab.Conflicts()) != 1 {
+		t.Fatalf("conflicts=%+v", ab.Conflicts())
+	}
+	if Verify(ab).Valid {
+		t.Fatal("identity conflict unexpectedly verified")
+	}
+	if !Join(ab, b).Equal(ab) {
+		t.Fatal("retry changed conflicted state")
+	}
+}
+
+func TestConcurrentRetriesConverge(t *testing.T) {
+	x := makeDiamond(t)
+	parts := []State{}
+	for _, f := range []Fact{x.SourceA, x.SourceB, x.Claim} {
+		s, _ := NewState().WithFact(f)
+		parts = append(parts, s)
+	}
+	for _, d := range []Derivation{x.SeedA, x.SeedB, x.Extract, x.Resolve} {
+		s, _ := NewState().WithDerivation(d)
+		parts = append(parts, s)
+	}
+	for _, o := range []Observation{x.ScoreA, x.ScoreB} {
+		s, _ := NewState().WithObservation(o)
+		parts = append(parts, s)
+	}
+	want := NewState()
+	for _, p := range parts {
+		want = Join(want, p)
+	}
+
+	for run := 0; run < 100; run++ {
+		ledger := NewLedger(NewState())
+		var wg sync.WaitGroup
+		for repeat := 0; repeat < 4; repeat++ {
+			for _, p := range parts {
+				p := p
+				wg.Add(1)
+				go func() { defer wg.Done(); ledger.Merge(p) }()
+			}
+		}
+		wg.Wait()
+		if got := ledger.Snapshot(); !got.Equal(want) {
+			t.Fatalf("run %d diverged", run)
+		}
+	}
+}
+
+func TestDeterministicSnapshotRoundTrip(t *testing.T) {
+	x := makeDiamond(t)
+	b1, err := x.State.CanonicalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	b2, err := x.State.CanonicalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b1) != string(b2) {
+		t.Fatal("serialization is nondeterministic")
+	}
+	round, err := FromSnapshot(x.State.Snapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !round.Equal(x.State) {
+		t.Fatal("snapshot round trip changed state")
+	}
+	f1, _ := x.State.Fingerprint()
+	f2, _ := round.Fingerprint()
+	if f1 != f2 {
+		t.Fatalf("fingerprint changed: %s != %s", f1, f2)
+	}
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/proof.go b/pkg/rag/derive/proof.go
--- a/pkg/rag/derive/proof.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/proof.go	2026-08-05 19:12:43.212109656 +0000
@@ -0,0 +1,88 @@
+package derive
+
+import (
+	"fmt"
+	"sort"
+)
+
+const proofBundleSchema = "rag-proof-bundle/v1"
+
+type ProofBundle struct {
+	Schema          string   `json:"schema"`
+	CorpusID        string   `json:"corpus_id,omitempty"`
+	ConfigurationID string   `json:"configuration_id,omitempty"`
+	Selected        []FactID `json:"selected"`
+	State           Snapshot `json:"state"`
+}
+
+func BuildProofBundle(state State, selected []FactID, corpusID, configID string) (ProofBundle, error) {
+	if r := Verify(state); !r.Valid {
+		return ProofBundle{}, fmt.Errorf("cannot build proof bundle from invalid state: %d issues", len(r.Issues))
+	}
+	queue := append([]FactID(nil), selected...)
+	incF := map[FactID]bool{}
+	incD := map[DerivationID]bool{}
+	for len(queue) > 0 {
+		id := queue[0]
+		queue = queue[1:]
+		if incF[id] {
+			continue
+		}
+		if _, ok := state.Fact(id); !ok {
+			return ProofBundle{}, fmt.Errorf("selected fact %s missing or conflicted", id)
+		}
+		incF[id] = true
+		for _, d := range state.Derivations() {
+			if d.Output == id {
+				incD[d.ID] = true
+				for _, in := range d.Inputs {
+					queue = append(queue, in.Fact)
+				}
+			}
+		}
+	}
+	sub := NewState()
+	var e error
+	for _, id := range sortedFactIDs(incF) {
+		f, _ := state.Fact(id)
+		sub, e = sub.WithFact(f)
+		if e != nil {
+			return ProofBundle{}, e
+		}
+	}
+	for _, id := range sortedDerivationIDs(incD) {
+		d, _ := state.Derivation(id)
+		sub, e = sub.WithDerivation(d)
+		if e != nil {
+			return ProofBundle{}, e
+		}
+	}
+	for _, o := range state.Observations() {
+		if incF[o.Subject] {
+			sub, e = sub.WithObservation(o)
+			if e != nil {
+				return ProofBundle{}, e
+			}
+		}
+	}
+	sel := append([]FactID(nil), selected...)
+	sort.Slice(sel, func(i, j int) bool { return sel[i] < sel[j] })
+	return ProofBundle{proofBundleSchema, corpusID, configID, sel, sub.Snapshot()}, nil
+}
+func VerifyProofBundle(b ProofBundle) VerificationReport {
+	if b.Schema != proofBundleSchema {
+		return VerificationReport{Issues: []ValidationIssue{{Code: "proof-bundle-schema", Message: fmt.Sprintf("unsupported schema %q", b.Schema)}}}
+	}
+	s, e := FromSnapshot(b.State)
+	if e != nil {
+		return VerificationReport{Issues: []ValidationIssue{{Code: "proof-bundle-decode", Message: e.Error()}}}
+	}
+	r := Verify(s)
+	for _, id := range b.Selected {
+		if _, ok := s.Fact(id); !ok {
+			r.Issues = append(r.Issues, ValidationIssue{"proof-bundle-selection-missing", "fact", string(id), "selected fact absent or conflicted"})
+		}
+	}
+	r.Valid = len(r.Issues) == 0
+	return r
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/ragcodec/codec.go b/pkg/rag/derive/ragcodec/codec.go
--- a/pkg/rag/derive/ragcodec/codec.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/ragcodec/codec.go	2026-08-05 19:21:04.811432864 +0000
@@ -0,0 +1,89 @@
+// Package ragcodec adapts existing rag values to the canonical fact,
+// derivation, and observation model. It deliberately keeps request-specific
+// scores and ranks out of immutable fact payloads.
+package ragcodec
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/the-tree-center/rag-ttc/pkg/digest"
+	"github.com/the-tree-center/rag-ttc/pkg/rag"
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive"
+)
+
+// Chunk converts one immutable source chunk into a canonical fact and seed
+// derivation. The legacy chunk ID is retained as lineage, not used as the
+// canonical fact identity.
+func Chunk(chunk rag.Chunk, requestID, corpusID string) (derive.Fact, derive.Derivation, error) {
+	if strings.TrimSpace(chunk.DocumentID) == "" {
+		return derive.Fact{}, derive.Derivation{}, fmt.Errorf("chunk document ID is required")
+	}
+	contentDigest := chunk.ContentDigest
+	if contentDigest == "" {
+		contentDigest = digest.Text(chunk.Text)
+	}
+	fact, err := derive.NewFact("source-chunk", "rag.chunk/v1", map[string]any{
+		"document_id":    chunk.DocumentID,
+		"ordinal":        chunk.Ordinal,
+		"byte_start":     chunk.Range.ByteStart,
+		"byte_end":       chunk.Range.ByteEnd,
+		"text":           chunk.Text,
+		"content_digest": contentDigest,
+		"chunker":        chunk.Chunker,
+	})
+	if err != nil {
+		return derive.Fact{}, derive.Derivation{}, err
+	}
+	proof, err := derive.NewSeedDerivation(fact.ID, "rag-chunk", "v1", requestID, corpusID, map[string]any{
+		"legacy_chunk_id": chunk.ID,
+	})
+	return fact, proof, err
+}
+
+// Representation converts derived retrieval material into a fact supported by
+// its source chunk. Model and prompt identifiers are included because they can
+// change the representation text and therefore its meaning as retrieval input.
+func Representation(value rag.Representation, source derive.FactID, requestID, configID string) (derive.Fact, derive.Derivation, error) {
+	if source == "" {
+		return derive.Fact{}, derive.Derivation{}, fmt.Errorf("representation source fact is required")
+	}
+	contentDigest := value.ContentDigest
+	if contentDigest == "" {
+		contentDigest = digest.Text(value.Text)
+	}
+	fact, err := derive.NewFact("retrieval-representation", "rag.representation/v1", map[string]any{
+		"kind":           value.Kind,
+		"text":           value.Text,
+		"content_digest": contentDigest,
+		"model":          value.Model,
+		"prompt_digest":  value.PromptDigest,
+	})
+	if err != nil {
+		return derive.Fact{}, derive.Derivation{}, err
+	}
+	proof, err := derive.NewDerivation(fact.ID, "build-representation", "v1", []derive.Input{{Role: "source-chunk", Fact: source}}, requestID, configID, map[string]any{
+		"legacy_representation_id": value.ID,
+		"legacy_chunk_id":          value.ChunkID,
+	})
+	return fact, proof, err
+}
+
+// Evidence converts hydrated evidence into a source fact, seed proof, and a
+// query-local retrieval observation. Rank and scores never enter Fact.ID.
+func Evidence(value rag.Evidence, requestID, corpusID, method string) (derive.Fact, derive.Derivation, derive.Observation, error) {
+	fact, proof, err := Chunk(value.Chunk, requestID, corpusID)
+	if err != nil {
+		return derive.Fact{}, derive.Derivation{}, derive.Observation{}, err
+	}
+	payload := map[string]any{
+		"method":          method,
+		"rank":            value.Rank,
+		"retrieval_score": value.RetrievalScore,
+	}
+	if value.RerankerScore != nil {
+		payload["reranker_score"] = *value.RerankerScore
+	}
+	observation, err := derive.NewObservation("retrieval-result", "rag.evidence-observation/v1", fact.ID, requestID, payload)
+	return fact, proof, observation, err
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/ragcodec/codec_test.go b/pkg/rag/derive/ragcodec/codec_test.go
