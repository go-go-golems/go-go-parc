--- a/pkg/rag/toolanswer/deterministic_ledger.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/toolanswer/deterministic_ledger.go	2026-08-05 19:21:05.396132827 +0000
@@ -0,0 +1,115 @@
+package toolanswer
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+	"unicode/utf8"
+
+	"github.com/the-tree-center/rag-ttc/pkg/rag"
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive"
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive/ragcodec"
+)
+
+// DeterministicEvidenceLedger separates add-only candidate admission from the
+// non-monotone budgeted view. AddCandidate never consumes a citation or rune
+// budget. Finalize ranks the globally merged snapshot and assigns labels only
+// after all candidates for the view have been admitted.
+type DeterministicEvidenceLedger struct {
+	mu         sync.Mutex
+	state      *derive.Ledger
+	chunks     map[derive.FactID]rag.Chunk
+	candidates map[string]derive.Candidate
+	toolCalls  map[derive.FactID]map[string]bool
+}
+
+func NewDeterministicEvidenceLedger() *DeterministicEvidenceLedger {
+	return &DeterministicEvidenceLedger{
+		state: derive.NewLedger(derive.NewState()), chunks: map[derive.FactID]rag.Chunk{},
+		candidates: map[string]derive.Candidate{}, toolCalls: map[derive.FactID]map[string]bool{},
+	}
+}
+
+// AddCandidate is retry-safe. Repeating the same chunk, observation, and tool
+// call produces no semantic change; alternate tool calls remain as alternate
+// provenance and observations.
+func (l *DeterministicEvidenceLedger) AddCandidate(chunk rag.Chunk, toolCallID, corpusID, method string, utility float64) error {
+	if l == nil || l.state == nil {
+		return fmt.Errorf("deterministic evidence ledger is nil")
+	}
+	fact, proof, observation, err := ragcodec.Evidence(rag.Evidence{Chunk: chunk, RetrievalScore: utility}, toolCallID, corpusID, method)
+	if err != nil {
+		return err
+	}
+	delta := derive.NewState()
+	delta, err = delta.WithFact(fact)
+	if err != nil {
+		return err
+	}
+	delta, err = delta.WithDerivation(proof)
+	if err != nil {
+		return err
+	}
+	delta, err = delta.WithObservation(observation)
+	if err != nil {
+		return err
+	}
+	l.state.Merge(delta)
+
+	candidate := derive.Candidate{Fact: fact.ID, Observation: observation.ID, StableKey: chunk.ID, Utility: utility, Units: utf8.RuneCountInString(chunk.Text)}
+	key := fmt.Sprintf("%s\x00%s\x00%s", candidate.Fact, candidate.Observation, candidate.StableKey)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.chunks[fact.ID] = chunk
+	l.candidates[key] = candidate
+	if l.toolCalls[fact.ID] == nil {
+		l.toolCalls[fact.ID] = map[string]bool{}
+	}
+	if toolCallID != "" {
+		l.toolCalls[fact.ID][toolCallID] = true
+	}
+	return nil
+}
+
+// Finalize constructs a deterministic selected view. maxDistinct and maxRunes
+// are view budgets and therefore cannot mutate or discard the canonical state.
+func (l *DeterministicEvidenceLedger) Finalize(maxDistinct, maxRunes int) ([]EvidenceRef, derive.State, error) {
+	if l == nil || l.state == nil {
+		return nil, derive.State{}, fmt.Errorf("deterministic evidence ledger is nil")
+	}
+	if maxDistinct <= 0 || maxRunes <= 0 {
+		return nil, derive.State{}, fmt.Errorf("selection limits must be positive")
+	}
+	state := l.state.Snapshot()
+	l.mu.Lock()
+	candidates := make([]derive.Candidate, 0, len(l.candidates))
+	for _, candidate := range l.candidates {
+		candidates = append(candidates, candidate)
+	}
+	chunks := make(map[derive.FactID]rag.Chunk, len(l.chunks))
+	for id, chunk := range l.chunks {
+		chunks[id] = chunk
+	}
+	calls := make(map[derive.FactID][]string, len(l.toolCalls))
+	for id, set := range l.toolCalls {
+		for call := range set {
+			calls[id] = append(calls[id], call)
+		}
+		sort.Strings(calls[id])
+	}
+	l.mu.Unlock()
+	selected, err := derive.Select(state, candidates, derive.SelectionPolicy{Version: "tool-evidence-v1", MaxItems: maxDistinct, MaxUnits: maxRunes, LabelPrefix: "E"})
+	if err != nil {
+		return nil, state, err
+	}
+	refs := make([]EvidenceRef, 0, len(selected))
+	for _, item := range selected {
+		chunk := chunks[item.Candidate.Fact]
+		firstCall := ""
+		if len(calls[item.Candidate.Fact]) > 0 {
+			firstCall = calls[item.Candidate.Fact][0]
+		}
+		refs = append(refs, EvidenceRef{Citation: item.Label, ChunkID: chunk.ID, DocumentID: chunk.DocumentID, Text: chunk.Text, FirstToolCallID: firstCall})
+	}
+	return refs, state, nil
+}
