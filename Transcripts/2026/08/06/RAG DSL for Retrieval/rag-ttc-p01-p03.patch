--- a/pkg/semanticid/fingerprint.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/semanticid/fingerprint.go	2026-08-05 19:10:47.953483811 +0000
@@ -0,0 +1,122 @@
+package semanticid
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const fingerprintTextPrefix = "sid1"
+
+var domainPattern = regexp.MustCompile(`^[a-z][a-z0-9._/-]*$`)
+var versionPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]*$`)
+
+type Domain string
+type Version string
+type Fingerprint struct {
+	Domain  Domain
+	Version Version
+	Sum     [sha256.Size]byte
+}
+
+func FingerprintValue(domain Domain, version Version, value Value) (Fingerprint, error) {
+	if err := validateDomain(domain); err != nil {
+		return Fingerprint{}, err
+	}
+	if err := validateVersion(version); err != nil {
+		return Fingerprint{}, err
+	}
+	var b bytes.Buffer
+	b.WriteString("rag-ttc-semantic-id\x00")
+	writeLengthPrefixed(&b, []byte(domain))
+	writeLengthPrefixed(&b, []byte(version))
+	writeLengthPrefixed(&b, value.canonicalBytes())
+	return Fingerprint{domain, version, sha256.Sum256(b.Bytes())}, nil
+}
+func MustFingerprint(d Domain, v Version, x Value) Fingerprint {
+	f, e := FingerprintValue(d, v, x)
+	if e != nil {
+		panic(e)
+	}
+	return f
+}
+func (f Fingerprint) Hex() string { return hex.EncodeToString(f.Sum[:]) }
+func (f Fingerprint) String() string {
+	return fmt.Sprintf("%s:%s:%s:sha256:%s", fingerprintTextPrefix, f.Domain, f.Version, f.Hex())
+}
+func (f Fingerprint) IsZero() bool {
+	return f.Domain == "" && f.Version == "" && f.Sum == [sha256.Size]byte{}
+}
+func (f Fingerprint) Equal(o Fingerprint) bool { return f == o }
+func Parse(v string) (Fingerprint, error) {
+	p := strings.Split(v, ":")
+	if len(p) != 5 || p[0] != fingerprintTextPrefix || p[3] != "sha256" {
+		return Fingerprint{}, errors.New("invalid semantic fingerprint format")
+	}
+	d := Domain(p[1])
+	ver := Version(p[2])
+	if e := validateDomain(d); e != nil {
+		return Fingerprint{}, e
+	}
+	if e := validateVersion(ver); e != nil {
+		return Fingerprint{}, e
+	}
+	raw, e := hex.DecodeString(p[4])
+	if e != nil || len(raw) != sha256.Size {
+		return Fingerprint{}, errors.New("invalid semantic fingerprint SHA-256 payload")
+	}
+	var sum [sha256.Size]byte
+	copy(sum[:], raw)
+	return Fingerprint{d, ver, sum}, nil
+}
+func (f Fingerprint) MarshalText() ([]byte, error) {
+	if e := validateDomain(f.Domain); e != nil {
+		return nil, e
+	}
+	if e := validateVersion(f.Version); e != nil {
+		return nil, e
+	}
+	return []byte(f.String()), nil
+}
+func (f *Fingerprint) UnmarshalText(b []byte) error {
+	if f == nil {
+		return errors.New("cannot unmarshal semantic fingerprint into nil receiver")
+	}
+	x, e := Parse(string(b))
+	if e != nil {
+		return e
+	}
+	*f = x
+	return nil
+}
+func (f Fingerprint) MarshalJSON() ([]byte, error) {
+	b, e := f.MarshalText()
+	if e != nil {
+		return nil, e
+	}
+	return json.Marshal(string(b))
+}
+func (f *Fingerprint) UnmarshalJSON(b []byte) error {
+	var s string
+	if e := json.Unmarshal(b, &s); e != nil {
+		return e
+	}
+	return f.UnmarshalText([]byte(s))
+}
+func validateDomain(d Domain) error {
+	if !domainPattern.MatchString(string(d)) || strings.Contains(string(d), ":") {
+		return fmt.Errorf("invalid semantic fingerprint domain %q", d)
+	}
+	return nil
+}
+func validateVersion(v Version) error {
+	if !versionPattern.MatchString(string(v)) || strings.Contains(string(v), ":") {
+		return fmt.Errorf("invalid semantic fingerprint version %q", v)
+	}
+	return nil
+}
diff -ruN '--exclude=.git' a/pkg/semanticid/value.go b/pkg/semanticid/value.go
--- a/pkg/semanticid/value.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/semanticid/value.go	2026-08-05 19:33:34.540122303 +0000
@@ -0,0 +1,208 @@
+package semanticid
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"path"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+type Kind byte
+
+const (
+	KindNull Kind = iota
+	KindBool
+	KindString
+	KindBytes
+	KindInt
+	KindUint
+	KindFloat64
+	KindList
+	KindSet
+	KindObject
+)
+
+type Field struct {
+	Name  string
+	Value Value
+}
+type Value struct {
+	kind      Kind
+	boolVal   bool
+	stringVal string
+	bytesVal  []byte
+	intVal    int64
+	uintVal   uint64
+	floatVal  float64
+	values    []Value
+	fields    []Field
+}
+
+func Null() Value       { return Value{kind: KindNull} }
+func Bool(v bool) Value { return Value{kind: KindBool, boolVal: v} }
+func String(v string) (Value, error) {
+	if !utf8.ValidString(v) {
+		return Value{}, errors.New("semantic string is not valid UTF-8")
+	}
+	return Value{kind: KindString, stringVal: v}, nil
+}
+func MustString(v string) Value {
+	x, e := String(v)
+	if e != nil {
+		panic(e)
+	}
+	return x
+}
+func Bytes(v []byte) Value { return Value{kind: KindBytes, bytesVal: append([]byte(nil), v...)} }
+func Int(v int64) Value    { return Value{kind: KindInt, intVal: v} }
+func Uint(v uint64) Value  { return Value{kind: KindUint, uintVal: v} }
+func Float64(v float64) (Value, error) {
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return Value{}, fmt.Errorf("semantic float must be finite: %v", v)
+	}
+	if v == 0 {
+		v = 0
+	}
+	return Value{kind: KindFloat64, floatVal: v}, nil
+}
+func MustFloat64(v float64) Value {
+	x, e := Float64(v)
+	if e != nil {
+		panic(e)
+	}
+	return x
+}
+func List(v ...Value) Value { return Value{kind: KindList, values: append([]Value(nil), v...)} }
+func Set(v ...Value) Value {
+	type ev struct {
+		v Value
+		b []byte
+	}
+	xs := make([]ev, len(v))
+	for i, x := range v {
+		xs[i] = ev{x, x.canonicalBytes()}
+	}
+	sort.Slice(xs, func(i, j int) bool { return bytes.Compare(xs[i].b, xs[j].b) < 0 })
+	out := make([]Value, 0, len(xs))
+	var prev []byte
+	for i, x := range xs {
+		if i > 0 && bytes.Equal(prev, x.b) {
+			continue
+		}
+		out = append(out, x.v)
+		prev = x.b
+	}
+	return Value{kind: KindSet, values: out}
+}
+func Object(fields ...Field) (Value, error) {
+	out := append([]Field(nil), fields...)
+	for _, f := range out {
+		if f.Name == "" {
+			return Value{}, errors.New("semantic object field name is empty")
+		}
+		if !utf8.ValidString(f.Name) {
+			return Value{}, fmt.Errorf("semantic object field %q is not valid UTF-8", f.Name)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	for i := 1; i < len(out); i++ {
+		if out[i-1].Name == out[i].Name {
+			return Value{}, fmt.Errorf("duplicate semantic object field %q", out[i].Name)
+		}
+	}
+	return Value{kind: KindObject, fields: out}, nil
+}
+func MustObject(fields ...Field) Value {
+	x, e := Object(fields...)
+	if e != nil {
+		panic(e)
+	}
+	return x
+}
+func Optional(name string, v *Value) Value {
+	if v == nil {
+		return MustObject(Field{"name", MustString(name)}, Field{"present", Bool(false)})
+	}
+	return MustObject(Field{"name", MustString(name)}, Field{"present", Bool(true)}, Field{"value", *v})
+}
+func PortablePath(v string) (Value, error) {
+	t := strings.TrimSpace(v)
+	if t == "" {
+		return Value{}, errors.New("semantic path is empty")
+	}
+	// Define separators independently of the host OS so the same logical path
+	// fingerprints identically on Unix and Windows. Reject absolute Unix,
+	// UNC, and drive-qualified paths before cleaning.
+	t = strings.ReplaceAll(t, `\`, "/")
+	if strings.HasPrefix(t, "/") || hasDrivePrefix(t) {
+		return Value{}, fmt.Errorf("semantic path must be relative: %q", v)
+	}
+	c := path.Clean(t)
+	if c == "." || c == ".." || strings.HasPrefix(c, "../") {
+		return Value{}, fmt.Errorf("semantic path escapes its root: %q", v)
+	}
+	return String(c)
+}
+func hasDrivePrefix(v string) bool {
+	if len(v) < 2 || v[1] != ':' {
+		return false
+	}
+	c := v[0]
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+func (v Value) Kind() Kind             { return v.kind }
+func (v Value) CanonicalBytes() []byte { return append([]byte(nil), v.canonicalBytes()...) }
+func (v Value) canonicalBytes() []byte { var b bytes.Buffer; v.writeCanonical(&b); return b.Bytes() }
+func (v Value) writeCanonical(b *bytes.Buffer) {
+	b.WriteByte(byte(v.kind))
+	switch v.kind {
+	case KindNull:
+		return
+	case KindBool:
+		if v.boolVal {
+			b.WriteByte(1)
+		} else {
+			b.WriteByte(0)
+		}
+	case KindString:
+		writeLengthPrefixed(b, []byte(v.stringVal))
+	case KindBytes:
+		writeLengthPrefixed(b, v.bytesVal)
+	case KindInt:
+		var x [binary.MaxVarintLen64]byte
+		n := binary.PutVarint(x[:], v.intVal)
+		b.Write(x[:n])
+	case KindUint:
+		var x [binary.MaxVarintLen64]byte
+		n := binary.PutUvarint(x[:], v.uintVal)
+		b.Write(x[:n])
+	case KindFloat64:
+		var x [8]byte
+		binary.BigEndian.PutUint64(x[:], math.Float64bits(v.floatVal))
+		b.Write(x[:])
+	case KindList, KindSet:
+		writeUvarint(b, uint64(len(v.values)))
+		for _, x := range v.values {
+			writeLengthPrefixed(b, x.canonicalBytes())
+		}
+	case KindObject:
+		writeUvarint(b, uint64(len(v.fields)))
+		for _, f := range v.fields {
+			writeLengthPrefixed(b, []byte(f.Name))
+			writeLengthPrefixed(b, f.Value.canonicalBytes())
+		}
+	default:
+		panic(fmt.Sprintf("unknown semantic value kind %d", v.kind))
+	}
+}
+func writeLengthPrefixed(b *bytes.Buffer, v []byte) { writeUvarint(b, uint64(len(v))); b.Write(v) }
+func writeUvarint(b *bytes.Buffer, v uint64) {
+	var x [binary.MaxVarintLen64]byte
+	n := binary.PutUvarint(x[:], v)
+	b.Write(x[:n])
+}
diff -ruN '--exclude=.git' a/pkg/semanticid/value_test.go b/pkg/semanticid/value_test.go
--- a/pkg/semanticid/value_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/semanticid/value_test.go	2026-08-05 19:33:34.668167399 +0000
@@ -0,0 +1,126 @@
+package semanticid
+
+import (
+	"bytes"
+	"encoding/json"
+	"math"
+	"math/rand"
+	"path/filepath"
+	"testing"
+)
+
+func TestObjectOrderDoesNotAffectFingerprint(t *testing.T) {
+	a := MustObject(Field{"query", MustString("oak decline")}, Field{"top_k", Int(12)})
+	b := MustObject(Field{"top_k", Int(12)}, Field{"query", MustString("oak decline")})
+	if MustFingerprint("rag.generation", "v1", a) != MustFingerprint("rag.generation", "v1", b) {
+		t.Fatal("object order changed identity")
+	}
+}
+func TestListOrderChangesAndSetOrderDoesNot(t *testing.T) {
+	a, b := MustString("a"), MustString("b")
+	if MustFingerprint("rag.test", "v1", List(a, b)) == MustFingerprint("rag.test", "v1", List(b, a)) {
+		t.Fatal("list order ignored")
+	}
+	if MustFingerprint("rag.test", "v1", Set(a, b, a)) != MustFingerprint("rag.test", "v1", Set(b, a)) {
+		t.Fatal("set order changed")
+	}
+}
+func TestGeneratedObjectAndSetPermutationInvariance(t *testing.T) {
+	r := rand.New(rand.NewSource(20260805))
+	fields := []Field{{"alpha", Int(1)}, {"beta", MustString("two")}, {"gamma", Bool(true)}, {"delta", List(Int(3), Int(4))}}
+	base := MustFingerprint("rag.generated", "v1", MustObject(fields...))
+	setBase := MustFingerprint("rag.generated.set", "v1", Set(Int(1), Int(2), Int(3)))
+	for k := 0; k < 500; k++ {
+		p := r.Perm(len(fields))
+		x := make([]Field, len(fields))
+		for i, j := range p {
+			x[i] = fields[j]
+		}
+		if MustFingerprint("rag.generated", "v1", MustObject(x...)) != base {
+			t.Fatalf("trial %d", k)
+		}
+		v := []Value{Int(1), Int(2), Int(3), Int(1)}
+		r.Shuffle(len(v), func(i, j int) { v[i], v[j] = v[j], v[i] })
+		if MustFingerprint("rag.generated.set", "v1", Set(v...)) != setBase {
+			t.Fatalf("set trial %d", k)
+		}
+	}
+}
+func TestDomainAndVersionSeparation(t *testing.T) {
+	v := MustString("same bytes")
+	b := MustFingerprint("rag.fact", "v1", v)
+	if b.Sum == MustFingerprint("rag.observation", "v1", v).Sum || b.Sum == MustFingerprint("rag.fact", "v2", v).Sum {
+		t.Fatal("separation failed")
+	}
+}
+func TestFingerprintTextAndJSONRoundTrip(t *testing.T) {
+	o := MustFingerprint("rag.fact", "derive-json-v1", MustObject(Field{"kind", MustString("chunk")}, Field{"text", MustString("café")}))
+	p, e := Parse(o.String())
+	if e != nil || p != o {
+		t.Fatal(e)
+	}
+	b, e := json.Marshal(o)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var d Fingerprint
+	if e = json.Unmarshal(b, &d); e != nil || d != o {
+		t.Fatal(e)
+	}
+}
+func TestFloatPolicy(t *testing.T) {
+	if !bytes.Equal(MustFloat64(0).CanonicalBytes(), MustFloat64(math.Copysign(0, -1)).CanonicalBytes()) {
+		t.Fatal("-0")
+	}
+	for _, v := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		if _, e := Float64(v); e == nil {
+			t.Fatal("nonfinite")
+		}
+	}
+}
+func TestPortablePath(t *testing.T) {
+	a, e := PortablePath(filepath.Join("configs", "connected.yaml"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := PortablePath("configs/connected.yaml")
+	if e != nil || !bytes.Equal(a.CanonicalBytes(), b.CanonicalBytes()) {
+		t.Fatal(e)
+	}
+	if _, e = PortablePath("../secret"); e == nil {
+		t.Fatal("escape")
+	}
+}
+func TestObjectRejectsDuplicateFields(t *testing.T) {
+	if _, e := Object(Field{"x", Int(1)}, Field{"x", Int(2)}); e == nil {
+		t.Fatal("duplicate")
+	}
+}
+func TestGoldenFingerprint(t *testing.T) {
+	v := MustObject(Field{"evidence", List(MustObject(Field{"chunk_id", MustString("chunk-17")}, Field{"content_digest", MustString("abc123")}))}, Field{"model", MustString("provider/model-v3")}, Field{"temperature", MustFloat64(.2)})
+	got := MustFingerprint("rag.generation.request", "v2", v).String()
+	const want = "sid1:rag.generation.request:v2:sha256:2b36eac7ae80af5218ebaf19aa5c32b10a1bd5c45657fd0292d26458b2398426"
+	if got != want {
+		t.Fatalf("got %s", got)
+	}
+}
+
+func TestPortablePathIsHostIndependent(t *testing.T) {
+	t.Parallel()
+	forward, err := PortablePath(`folder/sub/../item.json`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	backward, err := PortablePath(`folder\sub\..\item.json`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(forward.CanonicalBytes(), backward.CanonicalBytes()) {
+		t.Fatalf("separator spelling changed portable path identity")
+	}
+	for _, bad := range []string{`/etc/passwd`, `C:\\temp\\x`, `\\\\server\\share\\x`, `../escape`} {
+		if _, err := PortablePath(bad); err == nil {
+			t.Fatalf("expected rejection for %q", bad)
+		}
+	}
+}
