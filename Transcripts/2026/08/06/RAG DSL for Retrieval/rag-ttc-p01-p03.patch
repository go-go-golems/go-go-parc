@@ -0,0 +1,19 @@
+package ragcodec
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/the-tree-center/rag-ttc/pkg/rag"
+)
+
+func TestEvidenceSeparatesSourceIdentityFromQueryObservations(t *testing.T) {
+	chunk := rag.Chunk{ID: "legacy-c1", DocumentID: "d1", Text: "source", Ordinal: 2, Range: rag.Range{ByteStart: 10, ByteEnd: 16}, Chunker: "fixed-v1"}
+	first, proof1, observation1, err := Evidence(rag.Evidence{Chunk: chunk, Rank: 1, RetrievalScore: .2}, "q1", "corpus-v1", "dense")
+	require.NoError(t, err)
+	second, proof2, observation2, err := Evidence(rag.Evidence{Chunk: chunk, Rank: 99, RetrievalScore: .9}, "q2", "corpus-v1", "dense")
+	require.NoError(t, err)
+	require.Equal(t, first.ID, second.ID)
+	require.NotEqual(t, observation1.ID, observation2.ID)
+	require.NotEqual(t, proof1.ID, proof2.ID, "request lineage remains distinct")
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/select.go b/pkg/rag/derive/select.go
--- a/pkg/rag/derive/select.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/select.go	2026-08-05 19:12:43.212109656 +0000
@@ -0,0 +1,105 @@
+package derive
+
+import (
+	"fmt"
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+	"math"
+	"sort"
+	"strings"
+)
+
+type Candidate struct {
+	Fact        FactID        `json:"fact"`
+	Observation ObservationID `json:"observation,omitempty"`
+	StableKey   string        `json:"stable_key"`
+	Utility     float64       `json:"utility"`
+	Units       int           `json:"units"`
+}
+type SelectionPolicy struct {
+	Version     string `json:"version"`
+	MaxItems    int    `json:"max_items"`
+	MaxUnits    int    `json:"max_units,omitempty"`
+	LabelPrefix string `json:"label_prefix,omitempty"`
+}
+type Selected struct {
+	Candidate Candidate `json:"candidate"`
+	Rank      int       `json:"rank"`
+	Label     string    `json:"label"`
+}
+
+func Select(state State, candidates []Candidate, p SelectionPolicy) ([]Selected, error) {
+	if strings.TrimSpace(p.Version) == "" {
+		return nil, fmt.Errorf("selection policy version is required")
+	}
+	if p.MaxItems < 0 || p.MaxUnits < 0 {
+		return nil, fmt.Errorf("selection budgets cannot be negative")
+	}
+	if p.MaxItems == 0 {
+		return []Selected{}, nil
+	}
+	prefix := p.LabelPrefix
+	if prefix == "" {
+		prefix = "E"
+	}
+	dedup := map[string]Candidate{}
+	for i, c := range candidates {
+		if c.Fact == "" || strings.TrimSpace(c.StableKey) == "" {
+			return nil, fmt.Errorf("candidate %d has no fact or stable key", i)
+		}
+		if _, ok := state.Fact(c.Fact); !ok {
+			return nil, fmt.Errorf("candidate %d references missing or conflicted fact", i)
+		}
+		if c.Observation != "" {
+			o, ok := state.Observation(c.Observation)
+			if !ok || o.Subject != c.Fact {
+				return nil, fmt.Errorf("candidate %d has invalid observation", i)
+			}
+		}
+		if math.IsNaN(c.Utility) || math.IsInf(c.Utility, 0) || c.Units < 0 {
+			return nil, fmt.Errorf("candidate %d has invalid utility or units", i)
+		}
+		dedup[candidateKey(c)] = c
+	}
+	ordered := make([]Candidate, 0, len(dedup))
+	for _, c := range dedup {
+		ordered = append(ordered, c)
+	}
+	sort.Slice(ordered, func(i, j int) bool {
+		a, b := ordered[i], ordered[j]
+		if a.Utility != b.Utility {
+			return a.Utility > b.Utility
+		}
+		if a.StableKey != b.StableKey {
+			return a.StableKey < b.StableKey
+		}
+		if a.Fact != b.Fact {
+			return a.Fact < b.Fact
+		}
+		if a.Observation != b.Observation {
+			return a.Observation < b.Observation
+		}
+		return a.Units < b.Units
+	})
+	out := make([]Selected, 0)
+	used := 0
+	seen := map[FactID]bool{}
+	for _, c := range ordered {
+		if len(out) >= p.MaxItems {
+			break
+		}
+		if seen[c.Fact] {
+			continue
+		}
+		if p.MaxUnits > 0 && used+c.Units > p.MaxUnits {
+			continue
+		}
+		seen[c.Fact] = true
+		used += c.Units
+		rank := len(out) + 1
+		out = append(out, Selected{c, rank, fmt.Sprintf("%s%d", prefix, rank)})
+	}
+	return out, nil
+}
+func candidateKey(c Candidate) string {
+	return semanticid.MustFingerprint("rag.selection.candidate", "v1", semanticid.MustObject(semanticid.Field{Name: "fact", Value: semanticid.MustString(string(c.Fact))}, semanticid.Field{Name: "observation", Value: semanticid.MustString(string(c.Observation))}, semanticid.Field{Name: "stable_key", Value: semanticid.MustString(c.StableKey)}, semanticid.Field{Name: "utility", Value: semanticid.MustFloat64(c.Utility)}, semanticid.Field{Name: "units", Value: semanticid.Int(int64(c.Units))})).String()
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/select_test.go b/pkg/rag/derive/select_test.go
--- a/pkg/rag/derive/select_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/select_test.go	2026-08-05 19:15:33.088117494 +0000
@@ -0,0 +1,139 @@
+package derive
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"testing"
+)
+
+func TestSelectIsPermutationAndRetryInvariant(t *testing.T) {
+	x := makeDiamond(t)
+	third, err := NewFact("source-chunk", "rag.chunk/v1", map[string]any{"document": "c", "text": "A third source."})
+	if err != nil {
+		t.Fatal(err)
+	}
+	seed, err := NewSeedDerivation(third.ID, "corpus", "v1", "ingest", "v1", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state, err := x.State.WithFact(third)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state, err = state.WithDerivation(seed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	candidates := []Candidate{
+		{Fact: x.SourceA.ID, Observation: x.ScoreA.ID, StableKey: "a", Utility: .91, Units: 20},
+		{Fact: x.SourceB.ID, Observation: x.ScoreB.ID, StableKey: "b", Utility: .87, Units: 20},
+		{Fact: third.ID, StableKey: "c", Utility: .89, Units: 20},
+	}
+	policy := SelectionPolicy{Version: "v1", MaxItems: 2, LabelPrefix: "S"}
+	want, err := Select(state, candidates, policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, p := range allPermutations(candidates) {
+		got, err := Select(state, p, policy)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("permutation %d changed view: %#v != %#v", i, got, want)
+		}
+		withRetries := append(append([]Candidate(nil), p...), p...)
+		got, err = Select(state, withRetries, policy)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("retry permutation %d changed view", i)
+		}
+	}
+}
+
+func TestSelectionBarrierRemovesArrivalOrderNondeterminism(t *testing.T) {
+	x := makeDiamond(t)
+	third, _ := NewFact("source-chunk", "v1", map[string]any{"text": "third"})
+	state, _ := x.State.WithFact(third)
+	cs := []Candidate{
+		{Fact: x.SourceA.ID, StableKey: "a", Utility: .6, Units: 1},
+		{Fact: x.SourceB.ID, StableKey: "b", Utility: .8, Units: 1},
+		{Fact: third.ID, StableKey: "c", Utility: .7, Units: 1},
+	}
+	policy := SelectionPolicy{Version: "v1", MaxItems: 2}
+	stable := map[string]bool{}
+	legacy := map[string]bool{}
+	for _, order := range allPermutations(cs) {
+		view, err := Select(state, order, policy)
+		if err != nil {
+			t.Fatal(err)
+		}
+		stable[fmt.Sprint(view)] = true
+		legacy[fmt.Sprintf("%s,%s", order[0].Fact, order[1].Fact)] = true
+	}
+	if len(stable) != 1 {
+		t.Fatalf("barrier produced %d views", len(stable))
+	}
+	if len(legacy) != 6 {
+		t.Fatalf("legacy arrival-time labels produced %d outcomes, want 6", len(legacy))
+	}
+}
+
+func TestSelectDoesNotMutateKnowledgeState(t *testing.T) {
+	x := makeDiamond(t)
+	before, _ := x.State.Fingerprint()
+	_, err := Select(x.State, []Candidate{{Fact: x.SourceA.ID, StableKey: "a", Utility: 1, Units: 5}}, SelectionPolicy{Version: "v1", MaxItems: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, _ := x.State.Fingerprint()
+	if before != after {
+		t.Fatal("query view mutated canonical state")
+	}
+}
+
+func TestSelectEmitsAtMostOneCandidatePerFact(t *testing.T) {
+	f, _ := NewFact("chunk", "v1", map[string]any{"text": "same"})
+	s, _ := NewState().WithFact(f)
+	o1, _ := NewObservation("score", "v1", f.ID, "q", map[string]any{"method": "dense", "score": .8})
+	o2, _ := NewObservation("score", "v1", f.ID, "q", map[string]any{"method": "lexical", "score": .9})
+	s, _ = s.WithObservation(o1)
+	s, _ = s.WithObservation(o2)
+	got, err := Select(s, []Candidate{
+		{Fact: f.ID, Observation: o1.ID, StableKey: "dense", Utility: .8},
+		{Fact: f.ID, Observation: o2.ID, StableKey: "lexical", Utility: .9},
+	}, SelectionPolicy{Version: "v1", MaxItems: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Candidate.Observation != o2.ID {
+		t.Fatalf("unexpected selection: %#v", got)
+	}
+}
+
+func TestSelectTieBreakIsTotalAndStable(t *testing.T) {
+	facts := make([]Fact, 4)
+	s := NewState()
+	for i := range facts {
+		facts[i], _ = NewFact("chunk", "v1", map[string]any{"i": i})
+		s, _ = s.WithFact(facts[i])
+	}
+	cs := make([]Candidate, 4)
+	for i, f := range facts {
+		cs[i] = Candidate{Fact: f.ID, StableKey: "same", Utility: 1, Units: 1}
+	}
+	got, err := Select(s, cs, SelectionPolicy{Version: "v1", MaxItems: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids := make([]string, len(got))
+	for i, x := range got {
+		ids[i] = string(x.Candidate.Fact)
+	}
+	if !sort.StringsAreSorted(ids) {
+		t.Fatalf("fact-ID tie break not sorted: %v", ids)
+	}
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/state.go b/pkg/rag/derive/state.go
--- a/pkg/rag/derive/state.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/state.go	2026-08-05 19:33:34.540333187 +0000
@@ -0,0 +1,376 @@
+package derive
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+	"sort"
+	"sync"
+)
+
+const snapshotSchema = "rag-derive-state/v1"
+
+type State struct {
+	facts        map[FactID]map[string]Fact
+	derivations  map[DerivationID]map[string]Derivation
+	observations map[ObservationID]map[string]Observation
+}
+type Snapshot struct {
+	Schema       string        `json:"schema"`
+	Facts        []Fact        `json:"facts,omitempty"`
+	Derivations  []Derivation  `json:"derivations,omitempty"`
+	Observations []Observation `json:"observations,omitempty"`
+}
+type Conflict struct {
+	Namespace      string   `json:"namespace"`
+	ID             string   `json:"id"`
+	VariantDigests []string `json:"variant_digests"`
+}
+type Counts struct {
+	FactIDs             int `json:"fact_ids"`
+	FactVariants        int `json:"fact_variants"`
+	DerivationIDs       int `json:"derivation_ids"`
+	DerivationVariants  int `json:"derivation_variants"`
+	ObservationIDs      int `json:"observation_ids"`
+	ObservationVariants int `json:"observation_variants"`
+}
+
+func NewState() State {
+	return State{map[FactID]map[string]Fact{}, map[DerivationID]map[string]Derivation{}, map[ObservationID]map[string]Observation{}}
+}
+func FromSnapshot(x Snapshot) (State, error) {
+	if x.Schema != "" && x.Schema != snapshotSchema {
+		return State{}, fmt.Errorf("unsupported derive snapshot schema %q", x.Schema)
+	}
+	s := NewState()
+	for _, v := range x.Facts {
+		if e := s.addFactMutable(v); e != nil {
+			return State{}, e
+		}
+	}
+	for _, v := range x.Derivations {
+		if e := s.addDerivationMutable(v); e != nil {
+			return State{}, e
+		}
+	}
+	for _, v := range x.Observations {
+		if e := s.addObservationMutable(v); e != nil {
+			return State{}, e
+		}
+	}
+	return s, nil
+}
+func (s State) WithFact(v Fact) (State, error) { r := s.Clone(); return r, r.addFactMutable(v) }
+func (s State) WithDerivation(v Derivation) (State, error) {
+	r := s.Clone()
+	return r, r.addDerivationMutable(v)
+}
+func (s State) WithObservation(v Observation) (State, error) {
+	r := s.Clone()
+	return r, r.addObservationMutable(v)
+}
+func (s State) WithProof(f Fact, d Derivation) (State, error) {
+	r, e := s.WithFact(f)
+	if e != nil {
+		return State{}, e
+	}
+	return r.WithDerivation(d)
+}
+func (s State) Clone() State { r := NewState(); r.mergeMutable(s); return r }
+func Join(a, b State) State  { r := a.Clone(); r.mergeMutable(b); return r }
+func (s *State) mergeMutable(r State) {
+	s.ensure()
+	for id, vs := range r.facts {
+		if s.facts[id] == nil {
+			s.facts[id] = map[string]Fact{}
+		}
+		for k, v := range vs {
+			s.facts[id][k] = cloneFact(v)
+		}
+	}
+	for id, vs := range r.derivations {
+		if s.derivations[id] == nil {
+			s.derivations[id] = map[string]Derivation{}
+		}
+		for k, v := range vs {
+			s.derivations[id][k] = cloneDerivation(v)
+		}
+	}
+	for id, vs := range r.observations {
+		if s.observations[id] == nil {
+			s.observations[id] = map[string]Observation{}
+		}
+		for k, v := range vs {
+			s.observations[id][k] = cloneObservation(v)
+		}
+	}
+}
+func (s State) Equal(o State) bool {
+	a, e := s.CanonicalJSON()
+	if e != nil {
+		return false
+	}
+	b, e := o.CanonicalJSON()
+	return e == nil && bytes.Equal(a, b)
+}
+func (s State) Snapshot() Snapshot {
+	r := Snapshot{Schema: snapshotSchema}
+	for _, id := range sortedFactIDs(s.facts) {
+		for _, k := range sortedKeys(s.facts[id]) {
+			r.Facts = append(r.Facts, cloneFact(s.facts[id][k]))
+		}
+	}
+	for _, id := range sortedDerivationIDs(s.derivations) {
+		for _, k := range sortedKeys(s.derivations[id]) {
+			r.Derivations = append(r.Derivations, cloneDerivation(s.derivations[id][k]))
+		}
+	}
+	for _, id := range sortedObservationIDs(s.observations) {
+		for _, k := range sortedKeys(s.observations[id]) {
+			r.Observations = append(r.Observations, cloneObservation(s.observations[id][k]))
+		}
+	}
+	return r
+}
+func (s State) CanonicalJSON() ([]byte, error) { return CanonicalMarshal(s.Snapshot()) }
+func (s State) Fingerprint() (semanticid.Fingerprint, error) {
+	b, e := s.CanonicalJSON()
+	if e != nil {
+		return semanticid.Fingerprint{}, e
+	}
+	return semanticid.FingerprintValue("rag.derive.state", "v1", semanticid.Bytes(b))
+}
+func (s State) Fact(id FactID) (Fact, bool) {
+	v := s.facts[id]
+	if len(v) != 1 {
+		return Fact{}, false
+	}
+	for _, x := range v {
+		return cloneFact(x), true
+	}
+	return Fact{}, false
+}
+func (s State) Derivation(id DerivationID) (Derivation, bool) {
+	v := s.derivations[id]
+	if len(v) != 1 {
+		return Derivation{}, false
+	}
+	for _, x := range v {
+		return cloneDerivation(x), true
+	}
+	return Derivation{}, false
+}
+func (s State) Observation(id ObservationID) (Observation, bool) {
+	v := s.observations[id]
+	if len(v) != 1 {
+		return Observation{}, false
+	}
+	for _, x := range v {
+		return cloneObservation(x), true
+	}
+	return Observation{}, false
+}
+func (s State) FactVariants(id FactID) []Fact {
+	var r []Fact
+	for _, k := range sortedKeys(s.facts[id]) {
+		r = append(r, cloneFact(s.facts[id][k]))
+	}
+	return r
+}
+func (s State) Facts() []Fact {
+	var r []Fact
+	for _, id := range sortedFactIDs(s.facts) {
+		if x, ok := s.Fact(id); ok {
+			r = append(r, x)
+		}
+	}
+	return r
+}
+func (s State) Derivations() []Derivation {
+	var r []Derivation
+	for _, id := range sortedDerivationIDs(s.derivations) {
+		if x, ok := s.Derivation(id); ok {
+			r = append(r, x)
+		}
+	}
+	return r
+}
+func (s State) Observations() []Observation {
+	var r []Observation
+	for _, id := range sortedObservationIDs(s.observations) {
+		if x, ok := s.Observation(id); ok {
+			r = append(r, x)
+		}
+	}
+	return r
+}
+func (s State) Conflicts() []Conflict {
+	var r []Conflict
+	for _, id := range sortedFactIDs(s.facts) {
+		if len(s.facts[id]) > 1 {
+			r = append(r, Conflict{"fact", string(id), sortedKeys(s.facts[id])})
+		}
+	}
+	for _, id := range sortedDerivationIDs(s.derivations) {
+		if len(s.derivations[id]) > 1 {
+			r = append(r, Conflict{"derivation", string(id), sortedKeys(s.derivations[id])})
+		}
+	}
+	for _, id := range sortedObservationIDs(s.observations) {
+		if len(s.observations[id]) > 1 {
+			r = append(r, Conflict{"observation", string(id), sortedKeys(s.observations[id])})
+		}
+	}
+	return r
+}
+func (s State) Counts() Counts {
+	r := Counts{FactIDs: len(s.facts), DerivationIDs: len(s.derivations), ObservationIDs: len(s.observations)}
+	for _, v := range s.facts {
+		r.FactVariants += len(v)
+	}
+	for _, v := range s.derivations {
+		r.DerivationVariants += len(v)
+	}
+	for _, v := range s.observations {
+		r.ObservationVariants += len(v)
+	}
+	return r
+}
+func (s *State) ensure() {
+	if s.facts == nil {
+		s.facts = map[FactID]map[string]Fact{}
+	}
+	if s.derivations == nil {
+		s.derivations = map[DerivationID]map[string]Derivation{}
+	}
+	if s.observations == nil {
+		s.observations = map[ObservationID]map[string]Observation{}
+	}
+}
+func (s *State) addFactMutable(v Fact) error {
+	s.ensure()
+	if v.ID == "" {
+		return fmt.Errorf("fact has no ID")
+	}
+	k, e := factRecordKey(v)
+	if e != nil {
+		return e
+	}
+	if s.facts[v.ID] == nil {
+		s.facts[v.ID] = map[string]Fact{}
+	}
+	s.facts[v.ID][k] = cloneFact(v)
+	return nil
+}
+func (s *State) addDerivationMutable(v Derivation) error {
+	s.ensure()
+	v.Inputs = SortedInputs(v.Inputs)
+	if v.ID == "" {
+		return fmt.Errorf("derivation has no ID")
+	}
+	k, e := derivationRecordKey(v)
+	if e != nil {
+		return e
+	}
+	if s.derivations[v.ID] == nil {
+		s.derivations[v.ID] = map[string]Derivation{}
+	}
+	s.derivations[v.ID][k] = cloneDerivation(v)
+	return nil
+}
+func (s *State) addObservationMutable(v Observation) error {
+	s.ensure()
+	if v.ID == "" {
+		return fmt.Errorf("observation has no ID")
+	}
+	k, e := observationRecordKey(v)
+	if e != nil {
+		return e
+	}
+	if s.observations[v.ID] == nil {
+		s.observations[v.ID] = map[string]Observation{}
+	}
+	s.observations[v.ID][k] = cloneObservation(v)
+	return nil
+}
+func cloneFact(v Fact) Fact { v.Payload = append(json.RawMessage(nil), v.Payload...); return v }
+func cloneDerivation(v Derivation) Derivation {
+	v.Inputs = append([]Input(nil), v.Inputs...)
+	v.Attributes = append(json.RawMessage(nil), v.Attributes...)
+	return v
+}
+func cloneObservation(v Observation) Observation {
+	v.Payload = append(json.RawMessage(nil), v.Payload...)
+	return v
+}
+func sortedFactIDs[T any](m map[FactID]T) []FactID {
+	r := make([]FactID, 0, len(m))
+	for x := range m {
+		r = append(r, x)
+	}
+	sort.Slice(r, func(i, j int) bool { return r[i] < r[j] })
+	return r
+}
+func sortedDerivationIDs[T any](m map[DerivationID]T) []DerivationID {
+	r := make([]DerivationID, 0, len(m))
+	for x := range m {
+		r = append(r, x)
+	}
+	sort.Slice(r, func(i, j int) bool { return r[i] < r[j] })
+	return r
+}
+func sortedObservationIDs[T any](m map[ObservationID]T) []ObservationID {
+	r := make([]ObservationID, 0, len(m))
+	for x := range m {
+		r = append(r, x)
+	}
+	sort.Slice(r, func(i, j int) bool { return r[i] < r[j] })
+	return r
+}
+func sortedKeys[T any](m map[string]T) []string {
+	r := make([]string, 0, len(m))
+	for x := range m {
+		r = append(r, x)
+	}
+	sort.Strings(r)
+	return r
+}
+
+type Ledger struct {
+	mu    sync.RWMutex
+	state State
+}
+
+func NewLedger(initial State) *Ledger { return &Ledger{state: initial.Clone()} }
+func (l *Ledger) Merge(delta State) []Conflict {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.state.mergeMutable(delta)
+	return l.state.conflictsFor(delta)
+}
+func (l *Ledger) Snapshot() State { l.mu.RLock(); defer l.mu.RUnlock(); return l.state.Clone() }
+func (l *Ledger) Conflicts() []Conflict {
+	l.mu.RLock()
+	defer l.mu.RUnlock()
+	return append([]Conflict(nil), l.state.Conflicts()...)
+}
+func (s State) conflictsFor(t State) []Conflict {
+	var r []Conflict
+	for _, id := range sortedFactIDs(t.facts) {
+		if len(s.facts[id]) > 1 {
+			r = append(r, Conflict{"fact", string(id), sortedKeys(s.facts[id])})
+		}
+	}
+	for _, id := range sortedDerivationIDs(t.derivations) {
+		if len(s.derivations[id]) > 1 {
+			r = append(r, Conflict{"derivation", string(id), sortedKeys(s.derivations[id])})
+		}
+	}
+	for _, id := range sortedObservationIDs(t.observations) {
+		if len(s.observations[id]) > 1 {
+			r = append(r, Conflict{"observation", string(id), sortedKeys(s.observations[id])})
+		}
+	}
+	return r
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/test_helpers_test.go b/pkg/rag/derive/test_helpers_test.go
--- a/pkg/rag/derive/test_helpers_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/test_helpers_test.go	2026-08-05 19:15:33.088117494 +0000
@@ -0,0 +1,130 @@
+package derive
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+)
+
+type diamondFixture struct {
+	SourceA, SourceB Fact
+	Claim            Fact
+	SeedA, SeedB     Derivation
+	Extract, Resolve Derivation
+	ScoreA, ScoreB   Observation
+	State            State
+}
+
+func makeDiamond(t testing.TB) diamondFixture {
+	t.Helper()
+	mustFact := func(kind, schema string, payload any) Fact {
+		f, err := NewFact(kind, schema, payload)
+		if err != nil {
+			t.Fatalf("new fact: %v", err)
+		}
+		return f
+	}
+	mustDerivation := func(out FactID, rule, version string, in []Input, request, config string, attrs any) Derivation {
+		d, err := NewDerivation(out, rule, version, in, request, config, attrs)
+		if err != nil {
+			t.Fatalf("new derivation: %v", err)
+		}
+		return d
+	}
+	mustObservation := func(kind, schema string, subject FactID, request string, payload any) Observation {
+		o, err := NewObservation(kind, schema, subject, request, payload)
+		if err != nil {
+			t.Fatalf("new observation: %v", err)
+		}
+		return o
+	}
+
+	a := mustFact("source-chunk", "rag.chunk/v1", map[string]any{
+		"document": "pathology-a", "text": "Oak wilt is caused by Bretziella fagacearum.",
+	})
+	b := mustFact("source-chunk", "rag.chunk/v1", map[string]any{
+		"document": "pathology-b", "text": "A vascular fungus causes oak wilt.",
+	})
+	claim := mustFact("claim", "rag.claim/v1", map[string]any{
+		"subject": "oak wilt", "predicate": "caused-by", "object": "Bretziella fagacearum",
+	})
+	seedA, err := NewSeedDerivation(a.ID, "corpus", "v1", "ingest-1", "corpus-2026-08", map[string]any{"locator": "a#1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedB, err := NewSeedDerivation(b.ID, "corpus", "v1", "ingest-1", "corpus-2026-08", map[string]any{"locator": "b#4"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	extract := mustDerivation(claim.ID, "extract-claim", "v2", []Input{{Role: "source", Fact: a.ID}}, "q-17", "extractor-v2", map[string]any{"span": "0:48"})
+	resolve := mustDerivation(claim.ID, "resolve-entity", "v3", []Input{{Role: "source", Fact: b.ID}}, "q-17", "resolver-v3", map[string]any{"entity": "Bretziella fagacearum"})
+	scoreA := mustObservation("retrieval-score", "rag.score/v1", a.ID, "q-17", map[string]any{"rank": 1, "score": 0.91, "method": "dense"})
+	scoreB := mustObservation("retrieval-score", "rag.score/v1", b.ID, "q-17", map[string]any{"rank": 2, "score": 0.87, "method": "bm25"})
+
+	s := NewState()
+	var e error
+	for _, f := range []Fact{a, b, claim} {
+		s, e = s.WithFact(f)
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	for _, d := range []Derivation{seedA, seedB, extract, resolve} {
+		s, e = s.WithDerivation(d)
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	for _, o := range []Observation{scoreA, scoreB} {
+		s, e = s.WithObservation(o)
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	return diamondFixture{a, b, claim, seedA, seedB, extract, resolve, scoreA, scoreB, s}
+}
+
+func singletonFactState(t testing.TB, f Fact) State {
+	t.Helper()
+	s, err := NewState().WithFact(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func allPermutations[T any](xs []T) [][]T {
+	if len(xs) == 0 {
+		return [][]T{{}}
+	}
+	var out [][]T
+	var walk func(int)
+	a := append([]T(nil), xs...)
+	walk = func(i int) {
+		if i == len(a) {
+			out = append(out, append([]T(nil), a...))
+			return
+		}
+		for j := i; j < len(a); j++ {
+			a[i], a[j] = a[j], a[i]
+			walk(i + 1)
+			a[i], a[j] = a[j], a[i]
+		}
+	}
+	walk(0)
+	return out
+}
+
+func describeState(s State) string {
+	b, err := s.CanonicalJSON()
+	if err != nil {
+		return fmt.Sprintf("<error: %v>", err)
+	}
+	var pretty any
+	if json.Unmarshal(b, &pretty) == nil {
+		if p, e := json.MarshalIndent(pretty, "", "  "); e == nil {
+			return string(p)
+		}
+	}
+	return string(b)
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/types.go b/pkg/rag/derive/types.go
--- a/pkg/rag/derive/types.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/types.go	2026-08-05 19:33:34.540269843 +0000
@@ -0,0 +1,183 @@
+package derive
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+)
+
+const (
+	factDomain         semanticid.Domain  = "rag.fact"
+	factVersion        semanticid.Version = "v1"
+	derivationDomain   semanticid.Domain  = "rag.derivation"
+	derivationVersion  semanticid.Version = "v1"
+	observationDomain  semanticid.Domain  = "rag.observation"
+	observationVersion semanticid.Version = "v1"
+)
+
+type FactID string
+type DerivationID string
+type ObservationID string
+
+type Fact struct {
+	ID      FactID          `json:"id"`
+	Kind    string          `json:"kind"`
+	Schema  string          `json:"schema"`
+	Payload json.RawMessage `json:"payload"`
+}
+type Input struct {
+	Role string `json:"role"`
+	Fact FactID `json:"fact"`
+}
+type Derivation struct {
+	ID          DerivationID    `json:"id"`
+	Output      FactID          `json:"output"`
+	Rule        string          `json:"rule"`
+	RuleVersion string          `json:"rule_version"`
+	Inputs      []Input         `json:"inputs,omitempty"`
+	RequestID   string          `json:"request_id,omitempty"`
+	ConfigID    string          `json:"config_id,omitempty"`
+	Attributes  json.RawMessage `json:"attributes,omitempty"`
+}
+type Observation struct {
+	ID        ObservationID   `json:"id"`
+	Kind      string          `json:"kind"`
+	Schema    string          `json:"schema"`
+	Subject   FactID          `json:"subject"`
+	RequestID string          `json:"request_id,omitempty"`
+	Payload   json.RawMessage `json:"payload"`
+}
+
+func NewFact(kind, schema string, payload any) (Fact, error) {
+	b, e := CanonicalMarshal(payload)
+	if e != nil {
+		return Fact{}, e
+	}
+	return NewFactFromJSON(kind, schema, b)
+}
+func NewFactFromJSON(kind, schema string, payload []byte) (Fact, error) {
+	kind = strings.TrimSpace(kind)
+	schema = strings.TrimSpace(schema)
+	if kind == "" || schema == "" {
+		return Fact{}, errors.New("fact kind and schema are required")
+	}
+	b, e := NormalizeJSON(payload)
+	if e != nil {
+		return Fact{}, fmt.Errorf("normalize fact payload: %w", e)
+	}
+	id, e := factID(kind, schema, b)
+	if e != nil {
+		return Fact{}, e
+	}
+	return Fact{id, kind, schema, b}, nil
+}
+func NewDerivation(output FactID, rule, version string, inputs []Input, requestID, configID string, attrs any) (Derivation, error) {
+	rule = strings.TrimSpace(rule)
+	version = strings.TrimSpace(version)
+	if output == "" || rule == "" || version == "" {
+		return Derivation{}, errors.New("derivation output, rule, and rule version are required")
+	}
+	for i, x := range inputs {
+		if strings.TrimSpace(x.Role) == "" || x.Fact == "" {
+			return Derivation{}, fmt.Errorf("derivation input %d has no role or fact", i)
+		}
+	}
+	var b []byte
+	var e error
+	if attrs != nil {
+		b, e = CanonicalMarshal(attrs)
+		if e != nil {
+			return Derivation{}, e
+		}
+	}
+	d := Derivation{Output: output, Rule: rule, RuleVersion: version, Inputs: SortedInputs(inputs), RequestID: requestID, ConfigID: configID, Attributes: b}
+	d.ID, e = derivationID(d)
+	return d, e
+}
+func NewSeedDerivation(output FactID, sourceKind, sourceVersion, requestID, configID string, attrs any) (Derivation, error) {
+	return NewDerivation(output, "seed/"+strings.TrimSpace(sourceKind), sourceVersion, nil, requestID, configID, attrs)
+}
+func NewObservation(kind, schema string, subject FactID, requestID string, payload any) (Observation, error) {
+	kind = strings.TrimSpace(kind)
+	schema = strings.TrimSpace(schema)
+	if kind == "" || schema == "" || subject == "" {
+		return Observation{}, errors.New("observation kind, schema, and subject are required")
+	}
+	b, e := CanonicalMarshal(payload)
+	if e != nil {
+		return Observation{}, e
+	}
+	o := Observation{Kind: kind, Schema: schema, Subject: subject, RequestID: requestID, Payload: b}
+	o.ID, e = observationID(o)
+	return o, e
+}
+func factID(kind, schema string, payload []byte) (FactID, error) {
+	f, e := semanticid.FingerprintValue(factDomain, factVersion, semanticid.MustObject(semanticid.Field{Name: "canonical_json", Value: semanticid.MustString(canonicalJSONVersion)}, semanticid.Field{Name: "kind", Value: semanticid.MustString(kind)}, semanticid.Field{Name: "schema", Value: semanticid.MustString(schema)}, semanticid.Field{Name: "payload", Value: semanticid.Bytes(payload)}))
+	return FactID(f.String()), e
+}
+func derivationID(d Derivation) (DerivationID, error) {
+	in := make([]semanticid.Value, len(d.Inputs))
+	for i, x := range d.Inputs {
+		in[i] = semanticid.MustObject(semanticid.Field{Name: "role", Value: semanticid.MustString(x.Role)}, semanticid.Field{Name: "fact", Value: semanticid.MustString(string(x.Fact))})
+	}
+	f, e := semanticid.FingerprintValue(derivationDomain, derivationVersion, semanticid.MustObject(semanticid.Field{Name: "output", Value: semanticid.MustString(string(d.Output))}, semanticid.Field{Name: "rule", Value: semanticid.MustString(d.Rule)}, semanticid.Field{Name: "rule_version", Value: semanticid.MustString(d.RuleVersion)}, semanticid.Field{Name: "inputs", Value: semanticid.List(in...)}, semanticid.Field{Name: "request_id", Value: semanticid.MustString(d.RequestID)}, semanticid.Field{Name: "config_id", Value: semanticid.MustString(d.ConfigID)}, semanticid.Field{Name: "attributes", Value: semanticid.Bytes(d.Attributes)}))
+	return DerivationID(f.String()), e
+}
+func observationID(o Observation) (ObservationID, error) {
+	f, e := semanticid.FingerprintValue(observationDomain, observationVersion, semanticid.MustObject(semanticid.Field{Name: "kind", Value: semanticid.MustString(o.Kind)}, semanticid.Field{Name: "schema", Value: semanticid.MustString(o.Schema)}, semanticid.Field{Name: "subject", Value: semanticid.MustString(string(o.Subject))}, semanticid.Field{Name: "request_id", Value: semanticid.MustString(o.RequestID)}, semanticid.Field{Name: "payload", Value: semanticid.Bytes(o.Payload)}, semanticid.Field{Name: "canonical_json", Value: semanticid.MustString(canonicalJSONVersion)}))
+	return ObservationID(f.String()), e
+}
+func recomputeFactID(f Fact) (FactID, error) {
+	b, e := NormalizeJSON(f.Payload)
+	if e != nil {
+		return "", e
+	}
+	return factID(f.Kind, f.Schema, b)
+}
+func recomputeDerivationID(d Derivation) (DerivationID, error) {
+	d.Inputs = SortedInputs(d.Inputs)
+	if len(d.Attributes) > 0 {
+		b, e := NormalizeJSON(d.Attributes)
+		if e != nil {
+			return "", e
+		}
+		d.Attributes = b
+	}
+	d.ID = ""
+	return derivationID(d)
+}
+func recomputeObservationID(o Observation) (ObservationID, error) {
+	b, e := NormalizeJSON(o.Payload)
+	if e != nil {
+		return "", e
+	}
+	o.Payload = b
+	o.ID = ""
+	return observationID(o)
+}
+func recordKey(domain string, v any) (string, error) {
+	b, e := CanonicalMarshal(v)
+	if e != nil {
+		return "", e
+	}
+	return semanticid.MustFingerprint(semanticid.Domain(domain), "v1", semanticid.Bytes(b)).String(), nil
+}
+func factRecordKey(v Fact) (string, error)             { return recordKey("rag.fact.record", v) }
+func derivationRecordKey(v Derivation) (string, error) { return recordKey("rag.derivation.record", v) }
+func observationRecordKey(v Observation) (string, error) {
+	return recordKey("rag.observation.record", v)
+}
+func SortedInputs(in []Input) []Input {
+	x := append([]Input(nil), in...)
+	sort.Slice(x, func(i, j int) bool {
+		if x[i].Role != x[j].Role {
+			return x[i].Role < x[j].Role
+		}
+		return x[i].Fact < x[j].Fact
+	})
+	return x
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/verify.go b/pkg/rag/derive/verify.go
--- a/pkg/rag/derive/verify.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/verify.go	2026-08-05 19:12:43.212109656 +0000
@@ -0,0 +1,116 @@
+package derive
+
+import (
+	"fmt"
+	"sort"
+)
+
+type ValidationIssue struct {
+	Code      string `json:"code"`
+	Namespace string `json:"namespace,omitempty"`
+	ID        string `json:"id,omitempty"`
+	Message   string `json:"message"`
+}
+type VerificationReport struct {
+	Valid  bool              `json:"valid"`
+	Issues []ValidationIssue `json:"issues,omitempty"`
+	Ranks  map[FactID]int    `json:"ranks,omitempty"`
+	Counts Counts            `json:"counts"`
+}
+
+func Verify(s State) VerificationReport {
+	r := VerificationReport{Ranks: map[FactID]int{}, Counts: s.Counts()}
+	for _, c := range s.Conflicts() {
+		r.Issues = append(r.Issues, ValidationIssue{"identity-conflict", c.Namespace, c.ID, fmt.Sprintf("%d record variants", len(c.VariantDigests))})
+	}
+	facts := map[FactID]Fact{}
+	for _, f := range s.Facts() {
+		facts[f.ID] = f
+		id, e := recomputeFactID(f)
+		if e != nil || id != f.ID {
+			r.Issues = append(r.Issues, ValidationIssue{"fact-id-mismatch", "fact", string(f.ID), "fact ID does not match canonical content"})
+		}
+	}
+	derivations := map[DerivationID]Derivation{}
+	proofs := map[FactID][]Derivation{}
+	for _, d := range s.Derivations() {
+		derivations[d.ID] = d
+		id, e := recomputeDerivationID(d)
+		if e != nil || id != d.ID {
+			r.Issues = append(r.Issues, ValidationIssue{"derivation-id-mismatch", "derivation", string(d.ID), "derivation ID does not match content"})
+		}
+		if _, ok := facts[d.Output]; !ok {
+			r.Issues = append(r.Issues, ValidationIssue{"derivation-output-missing", "derivation", string(d.ID), "output fact missing or conflicted"})
+		} else {
+			proofs[d.Output] = append(proofs[d.Output], d)
+		}
+		for _, in := range d.Inputs {
+			if _, ok := facts[in.Fact]; !ok {
+				r.Issues = append(r.Issues, ValidationIssue{"derivation-input-missing", "derivation", string(d.ID), "input fact missing or conflicted"})
+			}
+		}
+	}
+	for _, o := range s.Observations() {
+		id, e := recomputeObservationID(o)
+		if e != nil || id != o.ID {
+			r.Issues = append(r.Issues, ValidationIssue{"observation-id-mismatch", "observation", string(o.ID), "observation ID does not match content"})
+		}
+		if _, ok := facts[o.Subject]; !ok {
+			r.Issues = append(r.Issues, ValidationIssue{"observation-subject-missing", "observation", string(o.ID), "subject fact missing or conflicted"})
+		}
+	}
+	// Least well-founded rank. A fact is proved when at least one derivation has all inputs proved.
+	changed := true
+	for changed {
+		changed = false
+		for out, ds := range proofs {
+			best, has := r.Ranks[out]
+			for _, d := range ds {
+				ok := true
+				rank := 0
+				for _, in := range d.Inputs {
+					x, yes := r.Ranks[in.Fact]
+					if !yes {
+						ok = false
+						break
+					}
+					if x+1 > rank {
+						rank = x + 1
+					}
+				}
+				if ok && (!has || rank < best) {
+					best, has = rank, true
+				}
+			}
+			if has {
+				old, yes := r.Ranks[out]
+				if !yes || best < old {
+					r.Ranks[out] = best
+					changed = true
+				}
+			}
+		}
+	}
+	for _, id := range sortedFactIDs(facts) {
+		if len(proofs[id]) == 0 {
+			r.Issues = append(r.Issues, ValidationIssue{"fact-unproved", "fact", string(id), "fact has no derivation"})
+		} else if _, ok := r.Ranks[id]; !ok {
+			r.Issues = append(r.Issues, ValidationIssue{"fact-not-well-founded", "fact", string(id), "no finite acyclic proof is available"})
+		}
+	}
+	sort.Slice(r.Issues, func(i, j int) bool {
+		a, b := r.Issues[i], r.Issues[j]
+		if a.Code != b.Code {
+			return a.Code < b.Code
+		}
+		if a.Namespace != b.Namespace {
+			return a.Namespace < b.Namespace
+		}
+		if a.ID != b.ID {
+			return a.ID < b.ID
+		}
+		return a.Message < b.Message
+	})
+	r.Valid = len(r.Issues) == 0
+	return r
+}
