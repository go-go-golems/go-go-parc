+// Package foundations is the public composition surface produced by projects
+// P01-P03. It aliases the standalone semantic packages rather than wrapping
+// them, so users can adopt the kernel without another translation layer.
+package foundations
+
+import (
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive"
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+)
+
+type Fingerprint = semanticid.Fingerprint
+type Catalog = semanticid.Catalog
+type FieldSpec = semanticid.FieldSpec
+type Fact = derive.Fact
+type Derivation = derive.Derivation
+type Observation = derive.Observation
+type State = derive.State
+type Ledger = derive.Ledger
+type Candidate = derive.Candidate
+type SelectionPolicy = derive.SelectionPolicy
+type Selected = derive.Selected
+type ProofBundle = derive.ProofBundle
+
+var Join = derive.Join
+var Verify = derive.Verify
+var Select = derive.Select
+var BuildProofBundle = derive.BuildProofBundle
+var VerifyProofBundle = derive.VerifyProofBundle
