+#!/usr/bin/env bash
+set -euo pipefail
+repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp/src/github.com/the-tree-center"
+ln -s "$repo" "$tmp/src/github.com/the-tree-center/rag-ttc"
+export GO111MODULE=off
+export GOPATH="$tmp"
+cd "$repo"
+go test -race ./pkg/semanticid ./pkg/rag/derive
+go run ./cmd/semantic-foundations \
+  --stress-facts 1000 \
+  --output "$tmp/evaluation.json" \
+  --artifact-dir "$tmp/artifacts"
+echo "Evaluation: $tmp/evaluation.json"
