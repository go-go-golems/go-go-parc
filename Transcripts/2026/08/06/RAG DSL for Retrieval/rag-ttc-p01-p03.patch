diff -ruN '--exclude=.git' a/pkg/rag/derive/canonical_json.go b/pkg/rag/derive/canonical_json.go
--- a/pkg/rag/derive/canonical_json.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/canonical_json.go	2026-08-05 19:12:43.212109656 +0000
@@ -0,0 +1,205 @@
+package derive
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const canonicalJSONVersion = "derive-json-v1"
+
+type jsonMember struct {
+	name  string
+	value any
+}
+type jsonObject []jsonMember
+
+// NormalizeJSON produces a deterministic JSON representation. Object names
+// are sorted, duplicate names are rejected, insignificant whitespace is
+// removed, and equal finite decimal numbers receive one spelling.
+func NormalizeJSON(input []byte) ([]byte, error) {
+	d := json.NewDecoder(bytes.NewReader(input))
+	d.UseNumber()
+	v, e := decodeJSON(d)
+	if e != nil {
+		return nil, e
+	}
+	if _, e = d.Token(); e != io.EOF {
+		if e == nil {
+			return nil, fmt.Errorf("trailing JSON value")
+		}
+		return nil, e
+	}
+	var b bytes.Buffer
+	if e = writeJSON(&b, v); e != nil {
+		return nil, e
+	}
+	return b.Bytes(), nil
+}
+func CanonicalMarshal(v any) ([]byte, error) {
+	b, e := json.Marshal(v)
+	if e != nil {
+		return nil, e
+	}
+	return NormalizeJSON(b)
+}
+func decodeJSON(d *json.Decoder) (any, error) {
+	t, e := d.Token()
+	if e != nil {
+		return nil, e
+	}
+	switch x := t.(type) {
+	case nil, bool, string, json.Number:
+		return x, nil
+	case json.Delim:
+		switch x {
+		case '[':
+			var out []any
+			for d.More() {
+				v, e := decodeJSON(d)
+				if e != nil {
+					return nil, e
+				}
+				out = append(out, v)
+			}
+			end, e := d.Token()
+			if e != nil || end != json.Delim(']') {
+				return nil, fmt.Errorf("invalid array terminator")
+			}
+			return out, nil
+		case '{':
+			seen := map[string]bool{}
+			var out jsonObject
+			for d.More() {
+				k, e := d.Token()
+				if e != nil {
+					return nil, e
+				}
+				name, ok := k.(string)
+				if !ok {
+					return nil, fmt.Errorf("object key is not string")
+				}
+				if seen[name] {
+					return nil, fmt.Errorf("duplicate JSON object name %q", name)
+				}
+				seen[name] = true
+				v, e := decodeJSON(d)
+				if e != nil {
+					return nil, e
+				}
+				out = append(out, jsonMember{name, v})
+			}
+			end, e := d.Token()
+			if e != nil || end != json.Delim('}') {
+				return nil, fmt.Errorf("invalid object terminator")
+			}
+			sort.Slice(out, func(i, j int) bool { return out[i].name < out[j].name })
+			return out, nil
+		default:
+			return nil, fmt.Errorf("unexpected delimiter %q", x)
+		}
+	default:
+		return nil, fmt.Errorf("unexpected JSON token %T", t)
+	}
+}
+func writeJSON(b *bytes.Buffer, v any) error {
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case string:
+		q, _ := json.Marshal(x)
+		b.Write(q)
+	case json.Number:
+		n, e := canonicalNumber(x.String())
+		if e != nil {
+			return e
+		}
+		b.WriteString(n)
+	case []any:
+		b.WriteByte('[')
+		for i, y := range x {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			if e := writeJSON(b, y); e != nil {
+				return e
+			}
+		}
+		b.WriteByte(']')
+	case jsonObject:
+		b.WriteByte('{')
+		for i, m := range x {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			q, _ := json.Marshal(m.name)
+			b.Write(q)
+			b.WriteByte(':')
+			if e := writeJSON(b, m.value); e != nil {
+				return e
+			}
+		}
+		b.WriteByte('}')
+	default:
+		return fmt.Errorf("unsupported normalized JSON type %T", v)
+	}
+	return nil
+}
+func canonicalNumber(s string) (string, error) {
+	if s == "" {
+		return "", fmt.Errorf("empty JSON number")
+	}
+	sign := ""
+	if s[0] == '-' {
+		sign = "-"
+		s = s[1:]
+	}
+	exp := 0
+	if i := strings.IndexAny(s, "eE"); i >= 0 {
+		e, err := strconv.Atoi(s[i+1:])
+		if err != nil || e > 100000 || e < -100000 {
+			return "", fmt.Errorf("invalid or excessive JSON exponent")
+		}
+		exp = e
+		s = s[:i]
+	}
+	frac := 0
+	if i := strings.IndexByte(s, '.'); i >= 0 {
+		frac = len(s) - i - 1
+		s = s[:i] + s[i+1:]
+	}
+	s = strings.TrimLeft(s, "0")
+	if s == "" {
+		return "0", nil
+	}
+	scale := frac - exp
+	// Remove trailing decimal zeros while they are fractional.
+	for scale > 0 && strings.HasSuffix(s, "0") {
+		s = s[:len(s)-1]
+		scale--
+	}
+	var out string
+	switch {
+	case scale <= 0:
+		out = s + strings.Repeat("0", -scale)
+	case scale >= len(s):
+		out = "0." + strings.Repeat("0", scale-len(s)) + s
+	default:
+		i := len(s) - scale
+		out = s[:i] + "." + s[i:]
+	}
+	if out == "0" {
+		return "0", nil
+	}
+	return sign + out, nil
+}
diff -ruN '--exclude=.git' a/pkg/rag/derive/canonical_json_test.go b/pkg/rag/derive/canonical_json_test.go
--- a/pkg/rag/derive/canonical_json_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/rag/derive/canonical_json_test.go	2026-08-05 19:15:33.083210956 +0000
@@ -0,0 +1,46 @@
+package derive
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestNormalizeJSONCanonicalizesObjectOrderAndNumberSpelling(t *testing.T) {
+	t.Parallel()
+	inputs := [][]byte{
+		[]byte(`{"b":1.0,"a":[1e0,{"z":-0,"y":2.5000}]}`),
+		[]byte(` { "a" : [ 1 , { "y" : 2.5, "z" : 0 } ], "b" : 1 } `),
+		[]byte(`{"a":[1.000e+0,{"y":25e-1,"z":0.0}],"b":10e-1}`),
+	}
+	var want []byte
+	for i, in := range inputs {
+		got, err := NormalizeJSON(in)
+		if err != nil {
+			t.Fatalf("input %d: %v", i, err)
+		}
+		if i == 0 {
+			want = got
+			continue
+		}
+		if !bytes.Equal(got, want) {
+			t.Fatalf("canonical mismatch\nwant %s\n got %s", want, got)
+		}
+	}
+	if string(want) != `{"a":[1,{"y":2.5,"z":0}],"b":1}` {
+		t.Fatalf("unexpected canonical JSON: %s", want)
+	}
+}
+
+func TestNormalizeJSONRejectsDuplicateNamesAndTrailingValues(t *testing.T) {
+	t.Parallel()
+	for _, in := range []string{
+		`{"a":1,"a":2}`,
+		`{"outer":{"x":1,"x":2}}`,
+		`{"a":1} {"b":2}`,
+		`[1] true`,
+	} {
+		if got, err := NormalizeJSON([]byte(in)); err == nil {
+			t.Fatalf("expected rejection for %q, got %s", in, got)
+		}
+	}
+}
