diff -ruN '--exclude=.git' a/cmd/semantic-foundations/main.go b/cmd/semantic-foundations/main.go
--- a/cmd/semantic-foundations/main.go	1970-01-01 00:00:00.000000000 +0000
+++ b/cmd/semantic-foundations/main.go	2026-08-05 19:17:30.136122895 +0000
@@ -0,0 +1,468 @@
+// Command semantic-foundations executes the P01-P03 conformance experiment.
+// It is deliberately standard-library-only so the semantic kernel can be
+// validated independently of providers, databases, or network services.
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/the-tree-center/rag-ttc/pkg/rag/derive"
+	"github.com/the-tree-center/rag-ttc/pkg/semanticid"
+)
+
+type requestFixture struct {
+	Query      string
+	TopK       uint64
+	Workers    int64
+	APIKey     string
+	Display    string
+	Collection []string
+}
+
+type output struct {
+	Schema      string      `json:"schema"`
+	GeneratedAt string      `json:"generated_at"`
+	Environment environment `json:"environment"`
+	P01         p01Result   `json:"p01_identity"`
+	P02         p02Result   `json:"p02_provenance"`
+	P03         p03Result   `json:"p03_merge"`
+}
+type environment struct {
+	GoVersion string `json:"go_version"`
+	GOOS      string `json:"goos"`
+	GOARCH    string `json:"goarch"`
+}
+type p01Result struct {
+	Contract        semanticid.ContractReport `json:"mutation_contract"`
+	ContractPassed  bool                      `json:"contract_passed"`
+	Golden          string                    `json:"golden_fingerprint"`
+	SetPermutation  bool                      `json:"set_permutation_invariant"`
+	ObjectOrder     bool                      `json:"object_order_invariant"`
+	DomainSeparate  bool                      `json:"domain_separated"`
+	VersionSeparate bool                      `json:"version_separated"`
+}
+type p02Result struct {
+	StateFingerprint string                    `json:"state_fingerprint"`
+	Counts           derive.Counts             `json:"counts"`
+	Verification     derive.VerificationReport `json:"verification"`
+	ClaimID          derive.FactID             `json:"claim_id"`
+	ClaimRank        int                       `json:"claim_rank"`
+	ClaimProofs      int                       `json:"claim_proofs"`
+	BundleVerified   bool                      `json:"bundle_verified"`
+	TamperDetected   bool                      `json:"tamper_detected"`
+	ObservationSplit bool                      `json:"observation_separate_from_fact"`
+}
+type p03Result struct {
+	MergeDeltas              int     `json:"merge_deltas"`
+	MergePermutations        int     `json:"merge_permutations"`
+	UniqueMergeOutputs       int     `json:"unique_merge_outputs"`
+	SelectionPermutations    int     `json:"selection_permutations"`
+	UniqueSelectionViews     int     `json:"unique_selection_views"`
+	LegacyArrivalViews       int     `json:"legacy_arrival_views"`
+	ConflictVariants         int     `json:"conflict_variants"`
+	ConflictOrderIndependent bool    `json:"conflict_order_independent"`
+	ConcurrentRuns           int     `json:"concurrent_runs"`
+	ConcurrentDivergences    int     `json:"concurrent_divergences"`
+	StressFacts              int     `json:"stress_facts"`
+	PersistentJoinMillis     float64 `json:"persistent_join_millis"`
+	MutableLedgerMillis      float64 `json:"mutable_ledger_millis"`
+	StressOutputsEqual       bool    `json:"stress_outputs_equal"`
+	Speedup                  float64 `json:"mutable_ledger_speedup"`
+}
+type fixture struct {
+	a, b, claim      derive.Fact
+	seedA, seedB     derive.Derivation
+	extract, resolve derive.Derivation
+	scoreA, scoreB   derive.Observation
+	state            derive.State
+}
+
+func main() {
+	var outputPath, artifactDir string
+	var stressFacts int
+	flag.StringVar(&outputPath, "output", "", "write the complete evaluation JSON to this path")
+	flag.StringVar(&artifactDir, "artifact-dir", "", "write proof, state, conflict, and view fixtures here")
+	flag.IntVar(&stressFacts, "stress-facts", 2000, "number of facts used by the merge implementation experiment")
+	flag.Parse()
+	if stressFacts < 1 {
+		fatalf("stress-facts must be positive")
+	}
+
+	p01, err := evaluateP01()
+	if err != nil {
+		fatalf("P01: %v", err)
+	}
+	x, err := makeFixture()
+	if err != nil {
+		fatalf("fixture: %v", err)
+	}
+	p02, bundle, err := evaluateP02(x)
+	if err != nil {
+		fatalf("P02: %v", err)
+	}
+	p03, selected, conflict, err := evaluateP03(x, stressFacts)
+	if err != nil {
+		fatalf("P03: %v", err)
+	}
+	report := output{
+		Schema: "rag-ttc-p01-p03-evaluation/v1", GeneratedAt: time.Now().UTC().Format(time.RFC3339Nano),
+		Environment: environment{runtime.Version(), runtime.GOOS, runtime.GOARCH}, P01: p01, P02: p02, P03: p03,
+	}
+	if outputPath != "" {
+		mustWriteJSON(outputPath, report)
+	}
+	if artifactDir != "" {
+		if err := os.MkdirAll(artifactDir, 0o755); err != nil {
+			fatalf("create artifact dir: %v", err)
+		}
+		mustWriteJSON(filepath.Join(artifactDir, "evaluation.json"), report)
+		mustWriteJSON(filepath.Join(artifactDir, "diamond-state-v1.json"), x.state.Snapshot())
+		mustWriteJSON(filepath.Join(artifactDir, "claim-proof-bundle-v1.json"), bundle)
+		mustWriteJSON(filepath.Join(artifactDir, "selection-view-v1.json"), selected)
+		mustWriteJSON(filepath.Join(artifactDir, "conflict-state-v1.json"), conflict.Snapshot())
+	}
+	b, _ := json.MarshalIndent(report, "", "  ")
+	fmt.Println(string(b))
+}
+
+func evaluateP01() (p01Result, error) {
+	base := requestFixture{"How does oak wilt spread?", 12, 4, "secret-1", "Oak Wilt", []string{"corpus-a", "corpus-b"}}
+	fingerprint := func(x requestFixture) (semanticid.Fingerprint, error) {
+		set := make([]semanticid.Value, len(x.Collection))
+		for i, v := range x.Collection {
+			set[i] = semanticid.MustString(v)
+		}
+		return semanticid.FingerprintValue("rag.generation.request", "v2", semanticid.MustObject(
+			semanticid.Field{Name: "query", Value: semanticid.MustString(x.Query)},
+			semanticid.Field{Name: "top_k", Value: semanticid.Uint(x.TopK)},
+			semanticid.Field{Name: "collections", Value: semanticid.Set(set...)},
+		))
+	}
+	mutations := []semanticid.Mutation[requestFixture]{
+		{Name: "query", Role: semanticid.RoleSemantic, MustChange: true, Apply: func(x requestFixture) requestFixture { x.Query += " now"; return x }},
+		{Name: "top_k", Role: semanticid.RoleSemantic, MustChange: true, Apply: func(x requestFixture) requestFixture { x.TopK++; return x }},
+		{Name: "collection set", Role: semanticid.RoleSemantic, MustChange: true, Apply: func(x requestFixture) requestFixture { x.Collection = append(x.Collection, "corpus-c"); return x }},
+		{Name: "worker count", Role: semanticid.RoleOperational, MustChange: false, Apply: func(x requestFixture) requestFixture { x.Workers++; return x }},
+		{Name: "API key", Role: semanticid.RoleSecret, MustChange: false, Apply: func(x requestFixture) requestFixture { x.APIKey = "secret-2"; return x }},
+		{Name: "display title", Role: semanticid.RolePresentation, MustChange: false, Apply: func(x requestFixture) requestFixture { x.Display = "Different title"; return x }},
+	}
+	contract, err := semanticid.VerifyContract("generation-request-v2", base, fingerprint, mutations)
+	if err != nil {
+		return p01Result{}, err
+	}
+	golden, err := fingerprint(base)
+	if err != nil {
+		return p01Result{}, err
+	}
+	reordered := base
+	reordered.Collection = []string{"corpus-b", "corpus-a", "corpus-a"}
+	setFP, _ := fingerprint(reordered)
+	objA := semanticid.MustFingerprint("example.object", "v1", semanticid.MustObject(
+		semanticid.Field{Name: "a", Value: semanticid.Int(1)}, semanticid.Field{Name: "b", Value: semanticid.MustString("x")},
+	))
+	objB := semanticid.MustFingerprint("example.object", "v1", semanticid.MustObject(
+		semanticid.Field{Name: "b", Value: semanticid.MustString("x")}, semanticid.Field{Name: "a", Value: semanticid.Int(1)},
+	))
+	domain := semanticid.MustFingerprint("example.other", "v1", semanticid.MustString("payload"))
+	domain2 := semanticid.MustFingerprint("example.domain", "v1", semanticid.MustString("payload"))
+	version := semanticid.MustFingerprint("example.domain", "v2", semanticid.MustString("payload"))
+	return p01Result{contract, contract.Passed(), golden.String(), setFP == golden, objA == objB, domain != domain2, domain2 != version}, nil
+}
+
+func makeFixture() (fixture, error) {
+	fact := func(kind, schema string, payload any) (derive.Fact, error) {
+		return derive.NewFact(kind, schema, payload)
+	}
+	a, err := fact("source-chunk", "rag.chunk/v1", map[string]any{"document": "pathology-a", "text": "Oak wilt is caused by Bretziella fagacearum."})
+	if err != nil {
+		return fixture{}, err
+	}
+	b, err := fact("source-chunk", "rag.chunk/v1", map[string]any{"document": "pathology-b", "text": "A vascular fungus causes oak wilt."})
+	if err != nil {
+		return fixture{}, err
+	}
+	claim, err := fact("claim", "rag.claim/v1", map[string]any{"subject": "oak wilt", "predicate": "caused-by", "object": "Bretziella fagacearum"})
+	if err != nil {
+		return fixture{}, err
+	}
+	seedA, err := derive.NewSeedDerivation(a.ID, "corpus", "v1", "ingest", "corpus-2026-08", map[string]any{"locator": "a#1"})
+	if err != nil {
+		return fixture{}, err
+	}
+	seedB, err := derive.NewSeedDerivation(b.ID, "corpus", "v1", "ingest", "corpus-2026-08", map[string]any{"locator": "b#4"})
+	if err != nil {
+		return fixture{}, err
+	}
+	extract, err := derive.NewDerivation(claim.ID, "extract-claim", "v2", []derive.Input{{Role: "source", Fact: a.ID}}, "q-17", "extractor-v2", map[string]any{"span": "0:48"})
+	if err != nil {
+		return fixture{}, err
+	}
+	resolve, err := derive.NewDerivation(claim.ID, "resolve-entity", "v3", []derive.Input{{Role: "source", Fact: b.ID}}, "q-17", "resolver-v3", map[string]any{"entity": "Bretziella fagacearum"})
+	if err != nil {
+		return fixture{}, err
+	}
+	scoreA, err := derive.NewObservation("retrieval-score", "rag.score/v1", a.ID, "q-17", map[string]any{"method": "dense", "score": .91, "rank": 1})
+	if err != nil {
+		return fixture{}, err
+	}
+	scoreB, err := derive.NewObservation("retrieval-score", "rag.score/v1", b.ID, "q-17", map[string]any{"method": "bm25", "score": .87, "rank": 2})
+	if err != nil {
+		return fixture{}, err
+	}
+	s := derive.NewState()
+	for _, f := range []derive.Fact{a, b, claim} {
+		s, err = s.WithFact(f)
+		if err != nil {
+			return fixture{}, err
+		}
+	}
+	for _, d := range []derive.Derivation{seedA, seedB, extract, resolve} {
+		s, err = s.WithDerivation(d)
+		if err != nil {
+			return fixture{}, err
+		}
+	}
+	for _, o := range []derive.Observation{scoreA, scoreB} {
+		s, err = s.WithObservation(o)
+		if err != nil {
+			return fixture{}, err
+		}
+	}
+	return fixture{a, b, claim, seedA, seedB, extract, resolve, scoreA, scoreB, s}, nil
+}
+
+func evaluateP02(x fixture) (p02Result, derive.ProofBundle, error) {
+	r := derive.Verify(x.state)
+	fp, err := x.state.Fingerprint()
+	if err != nil {
+		return p02Result{}, derive.ProofBundle{}, err
+	}
+	bundle, err := derive.BuildProofBundle(x.state, []derive.FactID{x.claim.ID}, "corpus-2026-08", "pipeline-v1")
+	if err != nil {
+		return p02Result{}, derive.ProofBundle{}, err
+	}
+	claimProofs := 0
+	for _, d := range bundle.State.Derivations {
+		if d.Output == x.claim.ID {
+			claimProofs++
+		}
+	}
+	snap := x.state.Snapshot()
+	for i := range snap.Facts {
+		if snap.Facts[i].ID == x.a.ID {
+			snap.Facts[i].Payload = json.RawMessage(`{"text":"tampered"}`)
+		}
+	}
+	tampered, err := derive.FromSnapshot(snap)
+	if err != nil {
+		return p02Result{}, derive.ProofBundle{}, err
+	}
+	return p02Result{
+		StateFingerprint: fp.String(), Counts: x.state.Counts(), Verification: r, ClaimID: x.claim.ID,
+		ClaimRank: r.Ranks[x.claim.ID], ClaimProofs: claimProofs, BundleVerified: derive.VerifyProofBundle(bundle).Valid,
+		TamperDetected:   !derive.Verify(tampered).Valid,
+		ObservationSplit: x.scoreA.Subject == x.a.ID && string(x.scoreA.ID) != string(x.a.ID),
+	}, bundle, nil
+}
+
+func evaluateP03(x fixture, stressFacts int) (p03Result, []derive.Selected, derive.State, error) {
+	var err error
+	facts := derive.NewState()
+	for _, f := range []derive.Fact{x.a, x.b, x.claim} {
+		facts, err = facts.WithFact(f)
+		if err != nil {
+			return p03Result{}, nil, derive.State{}, err
+		}
+	}
+	seeds := derive.NewState()
+	for _, d := range []derive.Derivation{x.seedA, x.seedB} {
+		seeds, err = seeds.WithDerivation(d)
+		if err != nil {
+			return p03Result{}, nil, derive.State{}, err
+		}
+	}
+	extract, _ := derive.NewState().WithDerivation(x.extract)
+	resolve, _ := derive.NewState().WithDerivation(x.resolve)
+	scoreA, _ := derive.NewState().WithObservation(x.scoreA)
+	scoreB, _ := derive.NewState().WithObservation(x.scoreB)
+	deltas := []derive.State{facts, seeds, extract, resolve, scoreA, scoreB}
+	mergeOutputs := map[string]bool{}
+	permutationCount := 0
+	permuteStates(deltas, func(order []derive.State) {
+		got := derive.NewState()
+		for _, d := range order {
+			got = derive.Join(got, d)
+		}
+		b, _ := got.CanonicalJSON()
+		mergeOutputs[string(b)] = true
+		permutationCount++
+	})
+
+	third, err := derive.NewFact("source-chunk", "rag.chunk/v1", map[string]any{"document": "pathology-c", "text": "A third source."})
+	if err != nil {
+		return p03Result{}, nil, derive.State{}, err
+	}
+	state, _ := x.state.WithFact(third)
+	candidates := []derive.Candidate{
+		{Fact: x.a.ID, Observation: x.scoreA.ID, StableKey: "a", Utility: .91, Units: 20},
+		{Fact: x.b.ID, Observation: x.scoreB.ID, StableKey: "b", Utility: .87, Units: 20},
+		{Fact: third.ID, StableKey: "c", Utility: .89, Units: 20},
+	}
+	policy := derive.SelectionPolicy{Version: "v1", MaxItems: 2, LabelPrefix: "E"}
+	selectionViews := map[string]bool{}
+	legacyViews := map[string]bool{}
+	selectionPerms := 0
+	var selected []derive.Selected
+	permuteCandidates(candidates, func(order []derive.Candidate) {
+		view, e := derive.Select(state, order, policy)
+		if e != nil {
+			err = e
+			return
+		}
+		if selected == nil {
+			selected = view
+		}
+		b, _ := json.Marshal(view)
+		selectionViews[string(b)] = true
+		legacyViews[fmt.Sprintf("%s,%s", order[0].Fact, order[1].Fact)] = true
+		selectionPerms++
+	})
+	if err != nil {
+		return p03Result{}, nil, derive.State{}, err
+	}
+
+	good, err := derive.NewFact("claim", "v1", map[string]any{"value": "A"})
+	if err != nil {
+		return p03Result{}, nil, derive.State{}, err
+	}
+	bad := good
+	bad.Payload = json.RawMessage(`{"value":"B"}`)
+	ga, _ := derive.NewState().WithFact(good)
+	gb, _ := derive.NewState().WithFact(bad)
+	conflictAB, conflictBA := derive.Join(ga, gb), derive.Join(gb, ga)
+
+	concurrentRuns, divergences := 100, 0
+	want := derive.NewState()
+	for _, d := range deltas {
+		want = derive.Join(want, d)
+	}
+	for run := 0; run < concurrentRuns; run++ {
+		ledger := derive.NewLedger(derive.NewState())
+		var wg sync.WaitGroup
+		for repeat := 0; repeat < 4; repeat++ {
+			for _, d := range deltas {
+				d := d
+				wg.Add(1)
+				go func() { defer wg.Done(); ledger.Merge(d) }()
+			}
+		}
+		wg.Wait()
+		if !ledger.Snapshot().Equal(want) {
+			divergences++
+		}
+	}
+
+	stressDeltas := make([]derive.State, stressFacts)
+	for i := 0; i < stressFacts; i++ {
+		f, e := derive.NewFact("stress-fact", "v1", map[string]any{"index": i, "bucket": i % 97})
+		if e != nil {
+			return p03Result{}, nil, derive.State{}, e
+		}
+		stressDeltas[i], e = derive.NewState().WithFact(f)
+		if e != nil {
+			return p03Result{}, nil, derive.State{}, e
+		}
+	}
+	start := time.Now()
+	persistent := derive.NewState()
+	for _, d := range stressDeltas {
+		persistent = derive.Join(persistent, d)
+	}
+	persistentMS := millis(time.Since(start))
+	start = time.Now()
+	ledger := derive.NewLedger(derive.NewState())
+	for _, d := range stressDeltas {
+		ledger.Merge(d)
+	}
+	mutable := ledger.Snapshot()
+	mutableMS := millis(time.Since(start))
+	speedup := 0.0
+	if mutableMS > 0 {
+		speedup = persistentMS / mutableMS
+	}
+	return p03Result{
+		MergeDeltas: len(deltas), MergePermutations: permutationCount, UniqueMergeOutputs: len(mergeOutputs),
+		SelectionPermutations: selectionPerms, UniqueSelectionViews: len(selectionViews), LegacyArrivalViews: len(legacyViews),
+		ConflictVariants: len(conflictAB.FactVariants(good.ID)), ConflictOrderIndependent: conflictAB.Equal(conflictBA),
+		ConcurrentRuns: concurrentRuns, ConcurrentDivergences: divergences, StressFacts: stressFacts,
+		PersistentJoinMillis: persistentMS, MutableLedgerMillis: mutableMS, StressOutputsEqual: persistent.Equal(mutable), Speedup: speedup,
+	}, selected, conflictAB, nil
+}
+
+func millis(d time.Duration) float64 { return float64(d.Nanoseconds()) / 1e6 }
+
+func permuteStates(xs []derive.State, visit func([]derive.State)) {
+	a := append([]derive.State(nil), xs...)
+	var walk func(int)
+	walk = func(i int) {
+		if i == len(a) {
+			visit(append([]derive.State(nil), a...))
+			return
+		}
+		for j := i; j < len(a); j++ {
+			a[i], a[j] = a[j], a[i]
+			walk(i + 1)
+			a[i], a[j] = a[j], a[i]
+		}
+	}
+	walk(0)
+}
+func permuteCandidates(xs []derive.Candidate, visit func([]derive.Candidate)) {
+	a := append([]derive.Candidate(nil), xs...)
+	var walk func(int)
+	walk = func(i int) {
+		if i == len(a) {
+			visit(append([]derive.Candidate(nil), a...))
+			return
+		}
+		for j := i; j < len(a); j++ {
+			a[i], a[j] = a[j], a[i]
+			walk(i + 1)
+			a[i], a[j] = a[j], a[i]
+		}
+	}
+	walk(0)
+}
+func mustWriteJSON(path string, v any) {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		fatalf("create %s: %v", path, err)
+	}
+	b, err := json.MarshalIndent(v, "", "  ")
+	if err != nil {
+		fatalf("encode %s: %v", path, err)
+	}
+	b = append(b, '\n')
+	if err := os.WriteFile(path, b, 0o644); err != nil {
+		fatalf("write %s: %v", path, err)
+	}
+}
+func fatalf(format string, args ...any) { fmt.Fprintf(os.Stderr, format+"\n", args...); os.Exit(1) }
+
+// Keep deterministic ordering in generated summaries when this command is
+// extended with map-valued experiment dimensions.
+func sortedKeys[V any](m map[string]V) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
