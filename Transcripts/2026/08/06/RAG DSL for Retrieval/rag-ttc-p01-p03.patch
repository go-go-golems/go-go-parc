--- a/pkg/semanticid/contract.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/semanticid/contract.go	2026-08-05 19:10:47.953483811 +0000
@@ -0,0 +1,126 @@
+package semanticid
+
+import (
+	"fmt"
+	"sort"
+)
+
+type FieldRole string
+
+const (
+	RoleSemantic     FieldRole = "semantic"
+	RoleLineage      FieldRole = "lineage"
+	RoleObservation  FieldRole = "observation"
+	RolePresentation FieldRole = "presentation"
+	RoleOperational  FieldRole = "operational"
+	RoleSecret       FieldRole = "secret"
+)
+
+type FieldSpec struct {
+	Path        string    `json:"path"`
+	Role        FieldRole `json:"role"`
+	InIdentity  bool      `json:"in_identity"`
+	Explanation string    `json:"explanation,omitempty"`
+}
+type Catalog struct {
+	Name    string      `json:"name"`
+	Domain  Domain      `json:"domain"`
+	Version Version     `json:"version"`
+	Fields  []FieldSpec `json:"fields"`
+}
+
+func (c Catalog) Validate() error {
+	if c.Name == "" {
+		return fmt.Errorf("identity catalog has no name")
+	}
+	if e := validateDomain(c.Domain); e != nil {
+		return e
+	}
+	if e := validateVersion(c.Version); e != nil {
+		return e
+	}
+	seen := map[string]bool{}
+	for _, f := range c.Fields {
+		if f.Path == "" {
+			return fmt.Errorf("identity catalog %q contains an empty field path", c.Name)
+		}
+		if seen[f.Path] {
+			return fmt.Errorf("identity catalog %q repeats field %q", c.Name, f.Path)
+		}
+		seen[f.Path] = true
+		switch f.Role {
+		case RoleSemantic, RoleLineage:
+			if !f.InIdentity {
+				return fmt.Errorf("identity catalog %q excludes %s field %q", c.Name, f.Role, f.Path)
+			}
+		case RoleOperational, RolePresentation, RoleSecret:
+			if f.InIdentity {
+				return fmt.Errorf("identity catalog %q includes forbidden %s field %q", c.Name, f.Role, f.Path)
+			}
+		case RoleObservation:
+		default:
+			return fmt.Errorf("identity catalog %q has unknown role %q", c.Name, f.Role)
+		}
+	}
+	return nil
+}
+func (c Catalog) SortedFields() []FieldSpec {
+	x := append([]FieldSpec(nil), c.Fields...)
+	sort.Slice(x, func(i, j int) bool { return x[i].Path < x[j].Path })
+	return x
+}
+
+type Mutation[T any] struct {
+	Name       string
+	Role       FieldRole
+	MustChange bool
+	Apply      func(T) T
+}
+type MutationResult struct {
+	Name       string    `json:"name"`
+	Role       FieldRole `json:"role"`
+	MustChange bool      `json:"must_change"`
+	Changed    bool      `json:"changed"`
+	Pass       bool      `json:"pass"`
+	Before     string    `json:"before"`
+	After      string    `json:"after"`
+}
+type ContractReport struct {
+	Name    string           `json:"name"`
+	Results []MutationResult `json:"results"`
+}
+
+func (r ContractReport) Passed() bool {
+	for _, x := range r.Results {
+		if !x.Pass {
+			return false
+		}
+	}
+	return true
+}
+func VerifyContract[T any](name string, baseline T, fp func(T) (Fingerprint, error), mutations []Mutation[T]) (ContractReport, error) {
+	before, e := fp(baseline)
+	if e != nil {
+		return ContractReport{}, fmt.Errorf("fingerprint baseline: %w", e)
+	}
+	again, e := fp(baseline)
+	if e != nil {
+		return ContractReport{}, fmt.Errorf("repeat fingerprint baseline: %w", e)
+	}
+	if before != again {
+		return ContractReport{}, fmt.Errorf("identity contract %q is nondeterministic", name)
+	}
+	r := ContractReport{Name: name}
+	for _, m := range mutations {
+		if m.Apply == nil {
+			return ContractReport{}, fmt.Errorf("identity contract %q mutation %q has no Apply function", name, m.Name)
+		}
+		after, e := fp(m.Apply(baseline))
+		if e != nil {
+			return ContractReport{}, fmt.Errorf("fingerprint mutation %q: %w", m.Name, e)
+		}
+		changed := before != after
+		r.Results = append(r.Results, MutationResult{m.Name, m.Role, m.MustChange, changed, changed == m.MustChange, before.String(), after.String()})
+	}
+	return r, nil
+}
