+  const indexed = new Map<
+    PresentationType<Values>,
+    IndexedConversion<Values, Environment>[]
+  >();
+  const legacy: Array<{
+    convert: LegacyPresentationConversion<Values, Environment>;
+    order: number;
+  }> = [];
+
+  conversions.forEach((conversion, order) => {
+    if (typeof conversion === "function") {
+      legacy.push({
+        convert: conversion,
+        order,
+      });
+      return;
+    }
+    const definition = conversion as PresentationConversionDefinition<Values, Environment>;
+    const cost = definition.cost ?? 1;
+    if (!Number.isFinite(cost) || cost <= 0) {
+      throw new Error(`presentation conversion ${definition.id} must have a positive finite cost`);
+    }
+    for (const from of listedTypes(definition.from)) {
+      const edges = indexed.get(from) ?? [];
+      edges.push({ definition, order });
+      edges.sort(
+        (left, right) =>
+          (left.definition.cost ?? 1) - (right.definition.cost ?? 1) ||
+          (right.definition.priority ?? 0) - (left.definition.priority ?? 0) ||
+          left.order - right.order,
+      );
+      indexed.set(from, edges);
