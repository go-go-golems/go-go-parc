+import type {
+  AcceptRequest,
+  PresentationReference,
+  PresentationSelector,
+  PresentationSelectorPrepareContext,
+  PresentationType,
+  PresentationValues,
+} from "./types";
+
+export interface PreparedPresentationSelector<Values extends PresentationValues> {
+  readonly types: readonly PresentationType<Values>[];
+  readonly cache: "none" | "identity";
+  matches(reference: PresentationReference<Values>): boolean;
+}
+
+function listTypes<Values extends PresentationValues>(
+  types: PresentationType<Values> | readonly PresentationType<Values>[],
+): readonly PresentationType<Values>[] {
+  return (Array.isArray(types) ? types : [types]) as readonly PresentationType<Values>[];
+}
+
+export function preparePresentationSelector<
+  Values extends PresentationValues,
+  Environment,
+>(
+  selector: PresentationSelector<Values, Environment>,
+  context: PresentationSelectorPrepareContext<Values, Environment>,
+): PreparedPresentationSelector<Values> {
+  const types = [...new Set(listTypes(selector.types))];
+  const exactTypes = new Set(types);
+  const includeSubtypes = selector.includeSubtypes !== false;
+  const prepared = selector.prepare?.(context);
+
+  return {
+    types,
+    cache: selector.cache ?? "none",
+    matches(reference) {
+      const typeMatches = includeSubtypes
+        ? types.some((type) => context.isSubtype(reference.type, type))
+        : exactTypes.has(reference.type);
+      if (!typeMatches) return false;
+      if (selector.where && !selector.where(reference, context.environment)) return false;
+      return prepared?.(reference) ?? true;
+    },
+  };
+}
+
+/** Return a request's target types without exposing its inline/selector representation. */
+export function acceptRequestTypes<
+  Values extends PresentationValues,
+  Environment,
+>(request: AcceptRequest<Values, Environment>): readonly PresentationType<Values>[] {
+  return listTypes(request.selector !== undefined ? request.selector.types : request.types);
+}
+
+/** Normalize the legacy inline request into the reusable selector protocol. */
+export function selectorForAcceptRequest<
+  Values extends PresentationValues,
+  Environment,
+>(request: AcceptRequest<Values, Environment>): PresentationSelector<Values, Environment> {
+  if (request.selector !== undefined) return request.selector;
+  return {
+    types: request.types,
+    includeSubtypes: request.includeSubtypes,
+    cache: request.cache,
+    where: request.filter ? (reference) => request.filter?.(reference) ?? true : undefined,
+    prepare: request.prepare,
+  };
+}
+
+export interface TypedPresentationSelectorOptions<
+  Values extends PresentationValues,
+  Environment,
+  Type extends PresentationType<Values>,
+> {
+  readonly id?: string;
+  readonly cache?: "none" | "identity";
+  readonly where?: (
+    value: Values[Type],
+    reference: PresentationReference<Values, Type>,
+    environment: Environment,
+  ) => boolean;
+  readonly prepare?: (
+    context: PresentationSelectorPrepareContext<Values, Environment>,
+  ) => (
+    value: Values[Type],
+    reference: PresentationReference<Values, Type>,
+  ) => boolean;
+}
+
+/**
+ * Build exact-type selectors with value inference for an application's
+ * presentation vocabulary.
+ */
+export function createPresentationSelectorFactory<
+  Values extends PresentationValues,
+  Environment,
+>() {
+  const exact = <Type extends PresentationType<Values>>(
+    types: Type | readonly Type[],
+    options: TypedPresentationSelectorOptions<Values, Environment, Type> = {},
+  ): PresentationSelector<Values, Environment> => {
+    const listed = listTypes<Values>(types as PresentationType<Values> | readonly PresentationType<Values>[]);
+    return {
+      id: options.id,
+      types: listed,
+      includeSubtypes: false,
+      cache: options.cache,
+      where: options.where
+        ? (reference, environment) =>
+            options.where?.(
+              reference.value as Values[Type],
+              reference as PresentationReference<Values, Type>,
+              environment,
+            ) ?? true
+        : undefined,
+      prepare: options.prepare
+        ? (context) => {
+            const predicate = options.prepare?.(context);
+            return (reference) =>
+              predicate?.(
+                reference.value as Values[Type],
+                reference as PresentationReference<Values, Type>,
+              ) ?? true;
+          }
+        : undefined,
+    };
+  };
+
+  return {
+    type<Type extends PresentationType<Values>>(
+      type: Type,
+      options?: TypedPresentationSelectorOptions<Values, Environment, Type>,
+    ): PresentationSelector<Values, Environment> {
+      return exact(type, options);
+    },
+    any<Type extends PresentationType<Values>>(
+      types: readonly Type[],
+      options?: TypedPresentationSelectorOptions<Values, Environment, Type>,
+    ): PresentationSelector<Values, Environment> {
+      return exact(types, options);
+    },
+  } as const;
+}
+
+/** Compose selectors without flattening away their individual predicates. */
+export function anyOfPresentationSelectors<
+  Values extends PresentationValues,
+  Environment,
+>(
+  ...selectors: readonly PresentationSelector<Values, Environment>[]
+): PresentationSelector<Values, Environment> {
+  const types = selectors.flatMap((selector) => listTypes(selector.types));
+  return {
+    types: [...new Set(types)],
+    includeSubtypes: true,
+    cache: selectors.every((selector) => selector.cache === "identity") ? "identity" : "none",
+    prepare: (context) => {
+      const prepared = selectors.map((selector) => preparePresentationSelector(selector, context));
+      return (reference) => prepared.some((selector) => selector.matches(reference));
+    },
+  };
+}
