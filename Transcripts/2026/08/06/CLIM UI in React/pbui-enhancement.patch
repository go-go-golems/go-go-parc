+function listedTypes<Values extends PresentationValues>(
+  types: PresentationType<Values> | readonly PresentationType<Values>[],
+): readonly PresentationType<Values>[] {
+  return (Array.isArray(types) ? types : [types]) as readonly PresentationType<Values>[];
+}
+
+/**
+ * Compile the conversion graph once for a PBUI instance, then prepare a small
+ * operation-scoped matcher for each input context.
+ */
