+export type PresentationSupertypeMap<Values extends PresentationValues> = Partial<{
+  [Type in PresentationType<Values>]: readonly PresentationType<Values>[];
+}>;
+
+export type PresentationSelectorCache = "none" | "identity";
+
+export interface PresentationSelectorPrepareContext<
+  Values extends PresentationValues,
+  Environment,
+> {
+  readonly environment: Environment;
+  identityFor(reference: PresentationReference<Values>): PresentationIdentity;
+  sameObject(
+    left: PresentationReference<Values>,
+    right: PresentationReference<Values>,
+  ): boolean;
+  isSubtype(
+    actual: PresentationType<Values>,
+    expected: PresentationType<Values>,
+  ): boolean;
+}
+
+export type PresentationSelectorPredicate<Values extends PresentationValues> = (
+  reference: PresentationReference<Values>,
+) => boolean;
+
+/**
+ * A reusable runtime input-context selector.
+ *
+ * `prepare` is called once when an accept operation begins. It is the place to
+ * turn arrays into Sets, compile regular expressions, or close over a coherent
+ * snapshot. The returned predicate may still be an arbitrary lambda.
+ */
+export interface PresentationSelector<
+  Values extends PresentationValues,
+  Environment,
+> {
+  readonly id?: string;
+  readonly types: PresentationType<Values> | readonly PresentationType<Values>[];
+  /** Defaults to true, matching CLIM's subtype-oriented input contexts. */
+  readonly includeSubtypes?: boolean;
+  /** Operation-scoped memoization; never a process-global cache. */
+  readonly cache?: PresentationSelectorCache;
+  readonly where?: (
+    reference: PresentationReference<Values>,
+    environment: Environment,
+  ) => boolean;
+  readonly prepare?: (
+    context: PresentationSelectorPrepareContext<Values, Environment>,
+  ) => PresentationSelectorPredicate<Values>;
+}
+
+interface AcceptRequestBase {
+  readonly prompt: string;
+}
+
+export interface SelectorAcceptRequest<
+  Values extends PresentationValues,
+  Environment,
+> extends AcceptRequestBase {
+  readonly selector: PresentationSelector<Values, Environment>;
+  readonly types?: never;
+  readonly filter?: never;
+  readonly prepare?: never;
+  readonly cache?: never;
+  readonly includeSubtypes?: never;
+}
+
+/** Backward-compatible inline form; new reusable interactions may use `selector`. */
+export interface InlineAcceptRequest<
+  Values extends PresentationValues,
+  Environment,
+> extends AcceptRequestBase {
+  readonly types: PresentationType<Values> | readonly PresentationType<Values>[];
+  readonly selector?: never;
+  readonly filter?: (reference: PresentationReference<Values>) => boolean;
+  readonly prepare?: (
+    context: PresentationSelectorPrepareContext<Values, Environment>,
+  ) => PresentationSelectorPredicate<Values>;
+  readonly cache?: PresentationSelectorCache;
+  readonly includeSubtypes?: boolean;
+}
+
+export type AcceptRequest<
+  Values extends PresentationValues,
+  Environment = unknown,
+> =
+  | SelectorAcceptRequest<Values, Environment>
