const seedTranscripts = [
  { id: "tr-nikhil", title: "Panel interview · Nikhil Rao", start: dayAt(-4, 14, 0), durationS: 5400, source: "Google Meet",
    participants: ["c-me", "c-sarah", "c-marcus", "c-nikhil"],
    summary: "System design (eval framework), coding exercise, and a founder-fit conversation. Strong signal across all three panels. Sarah has one reservation (see moment m-14). Marcus is a strong yes.",
    moments: [
      { id: "m-1", t: 30, spk: "c-me", text: "Thanks for making the time, Nikhil. Sarah and Marcus will each take about 40 minutes, then we'll spend the last stretch on questions from your side. Sound good?" },
      { id: "m-2", t: 46, spk: "c-nikhil", text: "That works. I'd love to ask a few things about the eval framework specifically — I did some homework on your blog posts." },
      { id: "m-3", t: 320, spk: "c-sarah", text: "So the setup: you're evaluating a model that returns structured outputs, but the schema is loose. The naive thing is to grade on exact match, which underscores everything that's actually correct. How would you structure the eval?" },
      { id: "m-4", t: 362, spk: "c-nikhil", text: "Right — I'd separate two concerns. First, a structural check: does it parse into the schema at all? That's a hard gate. Then, per-field, use different graders. Enum fields get exact match, free text gets a judge model or a rubric, numeric fields get tolerance windows." },
      { id: "m-5", t: 611, spk: "c-sarah", text: "How do you keep the judge model honest? What if it's biased toward its own outputs?" },
      { id: "m-6", t: 640, spk: "c-nikhil", text: "You cross-check with a different family of models. And you keep a golden set that humans have graded, so you can measure judge-model drift. If the judge diverges from humans on the golden set, you've got a problem before you've got a problem." },
      { id: "m-7", t: 1820, spk: "c-marcus", text: "Different question — Sarah's told you what the tech looks like. What kind of team do you want to work in?" },
      { id: "m-8", t: 1855, spk: "c-nikhil", text: "Small, high-trust, low-process. I've done both extremes. I want to be able to change my mind out loud and have that be welcome. And I want to write code that ships, not code that sits in review for a week." },
      { id: "m-9", t: 3010, spk: "c-nikhil", text: "One question from me — what would make this hire a failure, in your view? What are you worried about?" },
      { id: "m-10", t: 3054, spk: "c-me", text: "Honestly? The main risk is that we're 90% of the way through a hard quarter and I need someone who can carry a workstream without me being in every meeting. If a month in you're waiting for me to prioritise you, we've both failed." },
      { id: "m-11", t: 4200, spk: "c-nikhil", text: "About the offer — I don't need a full package tomorrow, but a couple of things matter: I want a real onboarding runway, and I want to meet the founding designer before I sign." },
      { id: "m-12", t: 4260, spk: "c-me", text: "Both fair. Lisa's off next week but back the week of the 11th." },
      { id: "m-13", t: 5100, spk: "c-sarah", text: "Alright, closing thoughts from us — Marcus?" },
      { id: "m-14", t: 5110, spk: "c-marcus", text: "Strong yes for me. He asks the questions I want senior people to ask." },
      { id: "m-15", t: 5140, spk: "c-sarah", text: "I'm a yes with one caveat — I want to see how he handles being wrong in front of the team. The interview surface didn't give me that. Not a blocker, but something to watch in his first month." },
    ],
    actionItems: [
      { id: "ai-1", momentId: "m-11", text: "Send Nikhil an onboarding plan sketch", assigned: "c-me", taskId: "tk-9" },
      { id: "ai-2", momentId: "m-12", text: "Introduce Nikhil to Lisa week of Aug 11", assigned: "c-me", taskId: null },
