/* -------- calendar events --------
   Times: start/end in ms. Attendees: contact ids.
*/
const dayAt = (dayOffset, hh, mm) => {
  const d = new Date(startOfDay(nowMs()) + dayOffset * day);
  d.setHours(hh, mm || 0, 0, 0);
  return d.getTime();
};

