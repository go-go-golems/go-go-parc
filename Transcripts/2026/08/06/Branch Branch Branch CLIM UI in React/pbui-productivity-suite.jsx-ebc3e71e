import React, { useState, useRef, useEffect, useCallback, useContext, useMemo } from "react";

/* ============================================================
   PBUI · PERSONAL PRODUCTIVITY SUITE
   Email · Calendar · Contacts · Tasks · Doodle · Transcripts

   Every object on screen is a typed, LIVE presentation:
     <message> <thread> <label> <contact> <event> <slot>
     <task> <project> <transcript> <moment> <actionitem>
     <link> <booking> <att>
   plus the shell's own <tile> and <workspace>.

   Left-click a presentation activates it (opens, jumps, etc).
   Right-click it lists every verb that applies to it.
   Some verbs need a second object — the shell enters ACCEPT MODE
   and the correctly-typed presentations start pulsing across
   every tile and every workspace until you pick one.

   The point:
     - "Reply to a thread" from Compose accepts a <thread> from
       Inbox. "Schedule with them" from a Contact accepts a
       <slot> from the Calendar. "File this action item" from a
       Transcript accepts a <project> from Projects.
     - Everything, everywhere, is a first-class object.
   ============================================================ */

/* ---------------- palette ---------------- */
const C = {
  paper: "#ffffff", pane: "#ffffff", paneAlt: "#f1f1ee",
  ink: "#23262b", faint: "#7b8087", line: "#d9d9d4",
  sage: "#7cae9b", blue: "#7aa6c9", rose: "#d59a86",
  mustard: "#e0b95c", lavender: "#a99fc9", mint: "#8fc7b0",
  red: "#c2503a", green: "#3f9d6b", sel: "#fdeec6",
  add: "#e7f4ec", del: "#fbe9e4", warm: "#faf7ee",
};

/* ---------------- primitive helpers ---------------- */
const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
const kfmt = (n) => (n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1) + "k" : String(Math.round(n)));
const pad2 = (n) => (n < 10 ? "0" + n : String(n));

/* dates: everything is minutes-since-epoch or ms. Use a fixed "today" so the demo is stable */
const TODAY = new Date(2026, 7, 3, 9, 20); // Monday, August 3 2026, 09:20
const nowMs = () => TODAY.getTime();
const day = 86400000, hour = 3600000, minute = 60000;
const DAY_NAMES = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const MONTH_NAMES = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const startOfDay = (t) => { const d = new Date(t); d.setHours(0, 0, 0, 0); return d.getTime(); };
const endOfDay = (t) => startOfDay(t) + day - 1;
const startOfWeek = (t) => { const d = new Date(startOfDay(t)); d.setDate(d.getDate() - d.getDay()); return d.getTime(); };
const sameDay = (a, b) => startOfDay(a) === startOfDay(b);
const fmtTime = (t) => { const d = new Date(t); const h = d.getHours(); const m = d.getMinutes();
  const h12 = h % 12 === 0 ? 12 : h % 12; return h12 + ":" + pad2(m) + (h >= 12 ? "p" : "a"); };
const fmtDate = (t) => { const d = new Date(t); return MONTH_NAMES[d.getMonth()] + " " + d.getDate(); };
const fmtDay = (t) => { const d = new Date(t); return DAY_NAMES[d.getDay()] + " " + MONTH_NAMES[d.getMonth()] + " " + d.getDate(); };
const fmtRel = (t) => {
  const diff = t - nowMs();
  const abs = Math.abs(diff);
  const s = diff < 0 ? " ago" : diff > 0 ? " from now" : "";
  if (abs < minute) return "just now";
  if (abs < hour) return Math.round(abs / minute) + "m" + s;
  if (abs < day) return Math.round(abs / hour) + "h" + s;
  if (abs < 7 * day) return Math.round(abs / day) + "d" + s;
  return fmtDate(t);
};
const durText = (ms) => (ms >= hour ? (ms / hour).toFixed(ms % hour === 0 ? 0 : 1) + "h" : Math.round(ms / minute) + "m");

/* ---------------- domain vocabularies ---------------- */
const LABEL_TONE = {
  Inbox: C.blue, Sent: C.faint, Drafts: C.mustard, Starred: C.mustard, Important: C.red,
  Archive: C.faint, Trash: C.faint,
  Investors: C.red, Team: C.mint, Customers: C.rose, Family: C.lavender,
  Newsletters: C.faint, Receipts: C.faint, Fundraising: C.red, Hiring: C.sage,
};
const PRIO_TONE = { high: C.red, med: C.mustard, low: C.sage, "-": C.line };
const STATUS_TONE = { todo: C.paneAlt, doing: C.mustard, done: C.sage, blocked: C.red, waiting: C.faint };
const EV_KIND_TONE = {
  meeting: C.blue, focus: C.sage, workout: C.mint, personal: C.lavender,
  travel: C.mustard, interview: C.red, block: C.line, social: C.rose,
};
const CONTACT_TAG_TONE = {
  team: C.mint, investor: C.red, customer: C.rose, family: C.lavender,
  candidate: C.sage, advisor: C.mustard, mentor: C.blue, vendor: C.faint, personal: C.paneAlt,
};

let seqc = 1, notec = 1;
const uid = (p) => (p || "n") + (seqc++);

/* ============================================================
   PBUI CORE — presentations + accept protocol
   Every visible object goes through P. P renders a hover doc,
   opens the right-click verb menu, and cooperates with the shell's
   ACCEPT mode: when the shell is waiting for a value of a matching
   type, P pulses and left-click resolves the promise.
   ============================================================ */
const UICtx = React.createContext(null);
const useUI = () => useContext(UICtx);
const typeMatches = (want, have) =>
  want === "any" || (Array.isArray(want) ? want.includes(have) : want === have);

function P({ ptype, value, doc, children, block, svg, onActivate, activateDoc, style }) {
  const ui = useUI();
  const acceptable = ui.accepting && typeMatches(ui.accepting.ptype, ptype);
  const Tag = svg ? "g" : block ? "div" : "span";
  const clickDoc = acceptable ? "L: ACCEPT   R: menu"
    : onActivate ? "L: " + (activateDoc || "activate") + "   R: menu"
      : "L/R: menu";
  return (
    <Tag
      className={(svg ? "pres-svg" : "pres") + (acceptable ? " acceptable" : "")}
      style={style}
      onContextMenu={(e) => { e.preventDefault(); e.stopPropagation(); ui.openMenu(ptype, value, e.clientX, e.clientY); }}
      onClick={(e) => {
        e.stopPropagation();
        if (acceptable) { e.preventDefault(); ui.accepting.resolve({ ptype, value }); ui.setAccepting(null); }
        else if (onActivate) onActivate();
        else ui.openMenu(ptype, value, e.clientX, e.clientY);
      }}
      onMouseEnter={() => ui.setMouseDoc((doc || "<" + ptype + "> " + ui.labelFor(ptype, value)) + "   —   " + clickDoc)}
      onMouseLeave={() => ui.setMouseDoc(null)}
    >{children}</Tag>
  );
}

/* Pres — the default visual for an object re-presented by an app that
   did not originate it (watchlist, search results, inspector links). */
function Pres({ ptype, value }) {
  const ui = useUI();
  const label = ui.labelFor(ptype, value);
  const tone = { thread: C.blue, message: C.blue, label: C.mustard, contact: C.lavender,
    event: C.sage, slot: C.sage, task: C.mustard, project: C.rose, transcript: C.mint,
    moment: C.mint, actionitem: C.red, link: C.rose, booking: C.rose, att: C.faint }[ptype] || C.paneAlt;
  return (
    <P ptype={ptype} value={value}>
      <span style={{ background: C.pane, border: "1px solid " + C.ink, borderLeft: "4px solid " + tone, padding: "0 5px", fontSize: 11, whiteSpace: "nowrap" }}>{label}</span>
    </P>
  );
}

